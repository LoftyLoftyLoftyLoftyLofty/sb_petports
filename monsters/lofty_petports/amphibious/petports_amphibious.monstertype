//  M.A.U.S. UTILITY UNIT -- AMPHIBIOUS
//
//  A COPY of drone/petports_drone.monstertype -- the GROUND chassis, not the
//  flyer -- because an amphibious unit walks. Read the drone's file for the
//  modelled-on-petbunny reasoning, the parts binding and the collision poly.
//
//  WHAT DIFFERS
//
//    type / categories      unique, or the chassis wear each other's bodies
//    animation              its own file, same content today
//    petports_avoidLiquid   false -- the entire locomotion difference
//    petports_avoidLiquids  lava, corelava, poison
//
//  Everything else is the drone's, unchanged, on purpose.

{
  "type" : "petports_amphibious",
  "shortdescription" : "Utility Unit",
  "description" : "A M.A.U.S. utility unit sealed against immersion. It walks on land, swims when it has to, and is fussy about what it swims in.",

  //  Binding key for this type's monsterpart pool. Unique per unit type.
  "categories" : [ "petports_amphibious" ],
  "parts" : [ "body" ],

  "animation" : "petports_amphibious.animation",

  "dropPools" : [ ],

  //  petbunny omits this and relies on the default. Stated explicitly because a
  //  utility unit is ship equipment: capture-podding one out of its station
  //  would strand the item and drag it into the capture-pod economy.
  "capturable" : false,

  "baseParameters" : {
    "persistent" : true,
    //  FRIENDLY SINCE 2026-08-30. It was "ghostly", which sits OUTSIDE damage
    //  resolution entirely -- useful while the fleet was being brought up and
    //  wrong now. dd.unit.destructible always recorded units as MEANT to be
    //  destructible and flagged the ghostly question as unverified; this is
    //  that question being answered by changing the answer.
    //
    //  IT IS ALSO WHAT MAKES ALLY DETECTION POSSIBLE. The medic task picks a
    //  patient by comparing damage teams, and a ghostly unit's team matches
    //  nothing -- so every candidate would have failed the ally test and the
    //  medic would never have found anyone to heal.
    //
    //  CONSEQUENCES ARE LIVE NOW, NOT HYPOTHETICAL: a unit can be killed
    //  mid-task, its claim is left for the TTL to collect, and the port
    //  respawns a replacement after RESPAWN_GRACE as though nothing happened.
    //  dd.unit.destructible calls that last one arguably wrong and undecided.
    "damageTeamType" : "friendly",

    //  THE MARKER THAT SAYS "THIS IS A PETPORTS UNIT".
    //
    //  Read by petports_isUnitType. It exists because once these run on the
    //  friendly damage team they are indistinguishable from a farm animal --
    //  monster / friendly / team 2 describes a Mooshi exactly as well as it
    //  describes this. The medic scan has to tell a wounded unit from a
    //  wounded cow, and no engine field draws that line.
    //
    //  ANY THIRD-PARTY CHASSIS MUST DECLARE THIS. Checking for a
    //  petports_ name prefix would have worked for the four types shipped
    //  here and quietly failed for everyone building on top of this, which
    //  is the intended path rather than an edge case.
    "petports_unit" : true,


    "scripts" : [
      "/monsters/pets/groundPet.lua",
      "/scripts/pathing.lua",
      "/scripts/stateMachine.lua",
      "/scripts/util.lua",
      "/scripts/vec2.lua",

      //  BEACHED FLOP -- LISTED BEFORE idleState AND wanderState ON PURPOSE.
      //
      //  A plain %a+State, so petports_petBehavior runs it only while no action
      //  state holds the unit. That is why petportsTaskAction.update yields on
      //  petports_outOfMedium AND petBehavior.run suppresses every action while
      //  beached -- measured 2026-09-01: yielding alone produced 91 yields in 8
      //  seconds and the flop was never reached once.
      //
      //  ORDER IS A HEDGE, NOT A GUARANTEE. If stateMachine.pickState takes the
      //  first state whose enter() returns non-nil, being ahead of idle and
      //  wander is what wins the pick. If it round-robins via moveStateToEnd
      //  instead, order buys nothing and the forced pick in petBehavior.run is
      //  what does the work. Both are in place because /scripts/stateMachine.lua
      //  and /monsters/pets/groundPet.lua have not been read.
      //
      //  LOADED BY EVERY CHASSIS, INCLUDING WALKERS. petportsFlopState.enter
      //  returns nil for anything petports_outOfMedium reports as unchecked, so
      //  a ground or amphibious unit can never enter it.
      "/monsters/lofty_petports/petportsFlopState.lua",
      "/monsters/pets/idleState.lua",
      "/monsters/pets/wanderState.lua",

      //  Vanilla petBehavior.lua is deliberately ABSENT -- replaced by our fork
      //  below, which defines the same global. See petports_petBehavior.lua.
      "/monsters/pets/actions/followAction.lua",
      "/monsters/pets/actions/inspectAction.lua",
      "/monsters/pets/actions/pounceAction.lua",

      //  OURS. Vanilla's sleepAction.lua is deliberately absent -- both would
      //  register as action states answering the same args key, and whichever
      //  the state machine reached first would win.
      //
      //  petports_placement.lua must be present or petportsSleepAction calls a
      //  nil global.
      "/scripts/lofty_petports/petports_work.lua",
      "/scripts/lofty_petports/petports_habitat.lua",
      "/scripts/lofty_petports/petports_flavors.lua",
      "/monsters/lofty_petports/petports_petBehavior.lua",
      "/monsters/lofty_petports/petports_contract.lua",
      "/monsters/lofty_petports/petports_placement.lua",
      "/monsters/lofty_petports/petports_think.lua",
      "/monsters/lofty_petports/petportsSleepAction.lua",
      "/monsters/lofty_petports/petportsTaskAction.lua",

      //  LOADED BY A GROUND CHASSIS TOO, AND THAT IS NEW.
      //
      //  This file was flyer-only, on the reasoning that a ground unit which
      //  never loads it cannot be affected by it. Two things changed that.
      //
      //  It defines petportsFreeMover, which petportsTaskAction.freshPather
      //  binds to moveSwim for EVERY chassis -- because the pathfinder picks
      //  edge type by MEDIUM, not by chassis, and a ground unit dropped in deep
      //  water gets planned a route of Swim edges. Without this file that
      //  binding is a nil global.
      //
      //  And its approachPoint shadow is where the avoidLiquid correction will
      //  live for an amphibious ground chassis.
      //
      //  SAFE, BECAUSE THE SHADOWS DELEGATE. approachPoint and setJumpState both
      //  capture vanilla's version and hand straight back to it whenever
      //  gravityEnabled is true, which for this chassis is always. The ground
      //  unit's behaviour is vanilla's, unchanged, plus one mover binding it
      //  previously lacked.
      //
      //  MUST STAY AFTER groundPet.lua -- the capture binds nil otherwise.
      "/monsters/lofty_petports/petports_flyapproach.lua"
    ],

    //  AMPHIBIOUS: A WALKER THAT STOPS REFUSING WATER.
    //
    //  This chassis keeps gravity, so it is the drone's locomotion in every
    //  respect except one -- it no longer treats liquid as a wall.
    //
    //  petports_avoidLiquid false is the whole difference. It reaches
    //  findGroundPosition's avoidLiquid argument through every resolver in the
    //  mod, so submerged ground becomes standable and submerged targets become
    //  workable. The pathfinder does the rest: it emits Swim edges by MEDIUM
    //  rather than by chassis, and it will plan Swim edges up to a surface
    //  followed by Jump arcs out -- measured in game, and the reason this class
    //  needs no transition code of its own.
    //
    //  NOT THE OTTER. A true otter would switch gravity at runtime to swim
    //  neutrally rather than walking along the bottom. That needs applyParameters
    //  and a mode chosen per destination, because PathFinder:start reads
    //  baseParameters and mustEndOnGround is captured at PathMover:new. This is
    //  the version that needs none of it.
    //
    //  petports_canFly AND petports_canSwim ARE DECLARED, AND THIS REVERSES AN
    //  EARLIER DECISION ON PURPOSE.
    //
    //  They used to be absent, on the reasoning that they are free-mover
    //  permissions and a walking chassis is governed by physics rather than
    //  permission. That was true for exactly as long as this chassis could never
    //  stop being a walker.
    //
    //  petports_freeMover() is `not mcontroller.baseParameters().gravityEnabled`
    //  -- it reads PHYSICS, not config -- so the moment swim mode turns gravity
    //  off, every resolver in the mod starts treating this unit as a free mover
    //  and starts asking petports_media() what it may occupy.
    //
    //  THE DEFAULTS ARE THE EXACT INVERSE OF WHAT THIS CHASSIS NEEDS. petports_media
    //  defaults canFly TRUE and canSwim FALSE. Undeclared, a floating amphibious
    //  unit would believe it may occupy air and may NOT occupy water: every
    //  underwater petports_flyPointNear resolve refused, petports_outOfMedium
    //  reporting `out` while submerged, and the port's mediumCheck re-homing it
    //  about ten seconds later. The toggle cannot work until these are stated.
    //
    //  INERT WHILE GRAVITY IS ON, which is what makes them safe to land ahead of
    //  the toggle itself. petports_mediumAllows short-circuits for walkers after
    //  the forbidden-liquid test, so nothing reads these until freeMover() is
    //  true. Same for petportsFlopState: its canSwim gate sits behind
    //  petports_outOfMedium's `checked`, which is false for a walker.
    //
    //  canFly FALSE IS NOT A FORMALITY. Left defaulting to true, a unit whose
    //  gravity is off would count AIR as a legal medium and could resolve a fly
    //  point out of the water and hold there with no gravity to bring it down.
    "petports_canFly" : false,
    "petports_canSwim" : true,

    //  THIS CHASSIS MAY CHANGE WHAT KIND OF MOVER IT IS AT RUNTIME.
    //
    //  Read by petports_gravitySwitchable. See the SWIM MODE header in
    //  petports_contract.lua for the three modes and what each one writes.
    //
    //  A DECLARATION RATHER THAN AN INFERENCE, so no future chassis inherits
    //  this by accident. The drone and the sinker are walkers that must never
    //  switch; the aquatic and flyer chassis are already free movers and must
    //  never be handed a gravity write at all.
    //
    //  IT ALSO SWITCHES OFF THE MEDIUM CHECK. petports_outOfMedium reports
    //  `checked = false` for a switchable chassis, which stops the port's 30s
    //  re-home, petportsFlopState, the task-action yield and petBehavior's
    //  beached suppression from firing on a unit that is in water on purpose.
    //  The forbidden-liquid deny-list below is UNAFFECTED -- it is tested above
    //  every short-circuit in petports_mediumAllows.
    "petports_gravitySwitchable" : true,

    //  SEARCH COSTS -- AND THESE ARE A PROBE, NOT A TUNING.
    //
    //  MEASURED FAILURE: an amphibious unit already submerged, needing a route
    //  home that exits the water, re-enters, and exits again, got NO PATH BACK
    //  and stalled. Vanilla's defaults are the prime suspect and these numbers
    //  are the test of that:
    //
    //    swimCost 5        every submerged tile costs five times a walked one
    //    liquidJumpCost 15 paid on every jump made FROM liquid, so a route with
    //                      four water boundaries spends 60 of a 400 F-score
    //                      budget before one tile of distance is counted
    //    maxDistance 200   a route that leaves and re-enters water twice is far
    //                      longer than the straight line it is bounded against
    //
    //  SET GENEROUSLY ON PURPOSE. If the path still does not appear with water
    //  costed like land and the budgets doubled, cost is genuinely ruled out and
    //  the limitation is structural in the engine's search -- which is worth
    //  knowing for certain rather than assuming. Tighten these afterwards; do
    //  not treat them as chosen values.
    //
    //  swimCost 1 is the defensible one regardless of the outcome: this chassis
    //  is built to swim, so a stroke should not cost five paces.
    "petports_swimCost" : 1,

    //  WHERE THIS CHASSIS TETHERS -- see petports_habitatTether.
    //
    //  "floor" IS ALSO THE DEFAULT, and it is stated explicitly anyway. A walker
    //  wanting the floor is a real decision rather than an omission, and the two
    //  are indistinguishable when the line is absent -- which matters the day
    //  somebody reads these four files side by side to work out which chassis
    //  had been considered.
    "petports_portTetheringLocationType" : "floor",
    "petports_liquidJumpCost" : 2,
    //  maxFScore is NOT overridden here any more. 800 was measured as too tight
    //  for a route with four water crossings, and the shared default is now
    //  1200 for every chassis -- so an override would be a second source of
    //  truth saying the same thing, and the kind that goes stale silently.
    //
    //  maxDistance stays overridden: it bounds ROUTE LENGTH, and a path that
    //  leaves the water, climbs, re-enters and leaves again is far longer than
    //  the straight line to its target. That is specific to this chassis in a
    //  way the F-score budget is not.
    "petports_maxDistance" : 400,

    "petports_avoidLiquid" : false,

    //  LIQUIDS IT WILL STILL NOT ENTER, and this list is why the forbidden test
    //  had to move above the walker short-circuit. With avoidLiquid false and
    //  no deny-list, an amphibious walker wades into lava for exactly the reason
    //  an aquatic unit would without one.
    //
    //  Matched by NAME through root.liquidConfig, against both the liquid's name
    //  and its itemDrop, because "lava" and "liquidlava" are different strings
    //  and which one the engine exposes is not something to assume. A bare
    //  number works too. Whatever each id resolved to is logged once.
    "petports_avoidLiquids" : [ "lava", "corelava", "poison" ],

    "petBehavior" : "petBehavior",

    //  MUST match the port object's objectName exactly. groundPet.lua kills the
    //  unit outright if it cannot find an anchor of this name.
    "anchorName" : "petports_petport",

    //  SLEEP KILL SWITCH. False while dispatch and routing are being tested --
    //  a unit that nods off mid-diagnosis produces a stationary unit that looks
    //  identical to a stalled one.
    "petports_allowSleep" : false,

    //  FUEL BURNED PER SECOND OF WORK, and only of WORK -- a parked fleet
    //  is free. 900 capacity at 1.0 is fifteen minutes of uptime on a full
    //  tank. Per chassis so a heavier unit can cost more without touching
    //  code; an efficiency module divides it.
    "petports_fuelDrain" : 1.0,

    "petResources" : {
      "sleepy" : 10,
      "hunger" : 60,
      "petports_fuel" : 900,
      "playful" : 10,
      "curiosity" : 60
    },
    "petResourceDeltas" : {
      "sleepy" : 1,
      //  FUEL IS ITS OWN RESOURCE, AND VANILLA HUNGER IS PINNED DEAD.
      //
      //  hunger COUNTS UP and 900 counting DOWN is what a fuel bar is, so this
      //  does not reuse it. Redefining hunger to mean fullness would leave
      //  status.resource("hunger") returning its own opposite forever, for every
      //  future reader, to save one resource declaration.
      //
      //  THE DELTA BELOW IS ZERO RATHER THAN THE LINE BEING DELETED. Absent means
      //  groundPet.lua's tickResources never touches it, which is the same result
      //  by accident instead of on purpose -- and a zero is where a reader looks
      //  when asking why hunger never moves.
      //
      //  eatAction.lua and begAction.lua are gone from the scripts list above, so
      //  hungerStarvingLevel and the eat / beg / starving actionParams below are
      //  now INERT. Left in place rather than stripped: they are vanilla's shape
      //  and the behaviour rewrite may want them back. Do not tune them expecting
      //  the fuel system to answer.
      "hunger" : 0,
      "playful" : 1,
      "curiosity" : 1
    },

    "actionParams" : {
      "hungerStarvingLevel" : 80,
      "beg" : { "minScore" : 50, "cooldown" : 5, "distance" : 3, "emoteCooldown" : 2 },

      //  Vanilla's follow is the source of the shadowing complaint: curiosity
      //  regenerates at 1/sec against a minScore of 35, while followAction only
      //  drains it at 5/sec and its boredTimer does not start until the pet has
      //  arrived. Net effect is a permanent 3-tile tail. Raised the bar, made it
      //  bore quickly, and pushed stopDistance out of the player's footprint.
      //  This is tuning, not a fix -- the behavior rewrite comes later.
      "follow" : {
        "minScore" : 70,
        "cooldown" : 30,
        "curiosityDelta" : -25,
        "boredTime" : 1.5,
        "startDistance" : 10,
        "stopDistance" : 5,
        "runDistance" : 20
      },

      "inspect" : { "minScore" : 20, "cooldown" : 8 },
      "eat" : { "minScore" : 0, "minHunger" : 40, "cooldown" : 0, "distance" : 2 },

      //  petbunny carries this block too and there is no playAction.lua in
      //  either scripts list, so it is inert in vanilla as well. Kept for the
      //  behavior rewrite.
      "play" : { "minScore" : 20, "cooldown" : 2 },

      "sleep" : { "minScore" : 50, "minSleepy" : 75, "cooldown" : 10 },
      "starving" : { "minScore" : 60, "cooldown" : 3 }
    },

    "pathing" : { "canOpenDoors" : false },

    //  Sized to the body, not to vanilla's oversized click target.
    "metaBoundBox" : [-0.5, -0.75, 0.5, 0.6],
    "scale" : 1.0,

    "querySurroundingsCooldown" : 1,

    "wander" : {
      "wanderTime" : [5, 10],
      "changeDirectionTime" : [5, 10],
      "changeDirectionWait" : [1, 3]
    },
    "idle" : { "idleTime" : [4, 8], "standTime" : 2 },
    "pounce" : { "maxRange" : 10, "minRange" : 5 },
	
	//	go to the port and stay there when idle. do not wander
	"strictPortTethering" : true,

    "movementSettings" : {
	
	  //  a width and height of 1.6 here is deliberate:
	  //  it must be larger than 1.5 for the pathfinder to reject 1-tile-high tunnels, 
	  //  and it must be small enough to thread the needle into 2-tile-high gaps when coming out of a jump arc
	  
      "collisionPoly" :  [ [-0.8, -0.6], [-0.6, -0.8], [0.6, -0.8], [0.8, -0.6],
                    [0.8, 0.6], [0.6, 0.8], [-0.6, 0.8], [-0.8, 0.6] ],
      "mass" : 1.0,
      "walkSpeed" : 8,
      "runSpeed" : 12,
      "flySpeed" : 15,
      "airForce" : 50.0,

	  //  THE AQUATIC CHASSIS'S CALIBRATED LIQUID SET, MIRRORED VERBATIM.
	  //
	  //  NOT RE-DERIVED. These four were measured across four in-game runs on
	  //  petports_aquatic and their reasoning is recorded there in full -- read
	  //  that block, not this one, before changing any of them. Copied rather
	  //  than referenced because a monstertype cannot include another one.
	  //
	  //  WHY A WALKER NEEDS THEM AT ALL. controlFly is the swim primitive as
	  //  well as the flight one, so a gravity chassis that goes underwater is
	  //  governed by exactly these parameters the moment it stops walking. The
	  //  amphibious chassis declared NONE of them and inherited
	  //  default_actor_movement.config's, which is why it swam nothing like an
	  //  aquatic unit despite being the class built to swim.
	  //
	  //  liquidImpedance 0 IS THE ONE THAT MATTERS MOST. Measured on aquatic:
	  //  left at the default, a unit configured for flySpeed 12 covered 6.17
	  //  tiles/s -- exactly half. Read logged POSITIONS, not
	  //  mcontroller.velocity(), when checking this; friction takes its cut each
	  //  engine tick and the script samples post-friction.
	  //
	  //  liquidBuoyancy 0 IS A REAL BEHAVIOUR CHANGE HERE, UNLIKE ON AQUATIC.
	  //  There it computes to nothing because there is no gravity to oppose. This
	  //  chassis HAS gravity while wading, so zero buoyancy means it sinks rather
	  //  than bobbing. That is wanted -- a wading unit should walk the bottom,
	  //  and swim mode turns gravity off anyway -- but it is the first suspect if
	  //  shallow-water behaviour changes unexpectedly.
	  //
	  //  airForce AND airFriction ARE DELIBERATELY NOT MIRRORED. On a gravity
	  //  chassis those govern jump arcs, and the arc mover is tuned against the
	  //  current pair. Mirroring 9999/24 would change every jump this unit makes
	  //  to fix its swimming.
	  //
	  //  flySpeed LEFT AT 15, NOT LOWERED TO THE AQUATIC'S 12. Drag-limited speed
	  //  is liquidForce/liquidFriction, ~416 here, so flySpeed governs outright
	  //  and 15 is a speed decision rather than part of the calibration. Left
	  //  alone so this edit changes physics and not pace; lower it to 12 if the
	  //  two chassis should visibly match.
	  //  liquidBuoyancy IS DELIBERATELY ABSENT, AND WAS BRIEFLY 0.0 BY MISTAKE.
	  //
	  //  It was mirrored across from petports_aquatic with the rest of the liquid
	  //  set, and the comment there says plainly why it is zero: there is NO
	  //  GRAVITY on that chassis, so buoyancy has nothing to oppose and should
	  //  compute to nothing. This chassis has gravity, and 0.0 meant a unit that
	  //  spawned into a submerged port sank straight to the seabed. Measured
	  //  2026-09-02.
	  //
	  //  INHERITED RATHER THAN SET TO A NUMBER, because the inherited value is
	  //  the one this chassis had for its whole working life before the mirror,
	  //  and picking a replacement would be a guess where restoring is a fact.
	  //  petports_setSwimMode still asserts 1.0 for `exiting`, which is a
	  //  deliberate override of whatever this is, not a contradiction of it.
	  "liquidForce" : 9999.0,
	  "liquidFriction" : 24.0,
	  "liquidImpedance" : 0.0,
	  
	  "gravityMultiplier" : 1.5
    },

    "bodyMaterialKind" : "robotic",

    //  petbunny's values. knockoutEffect "blink" is defined in the animation.
    "knockoutTime" : 0,
    "knockoutEffect" : "blink",
    "deathParticles" : "deathPoof",

    //  petbunny does 15 lash damage on touch, which is vanilla being careless
    //  with a pet. A utility unit should never hurt anyone.
    "touchDamage" : { "poly" : [], "damage" : 0, "teamType" : "ghostly", "damageSourceKind" : "default" },

    "statusSettings" : {
      //  THE MATERIALISE / DEMATERIALISE COLOUR, read by
      //  petports_unitfade.lua off the parent's status controller. A status
      //  property rather than a spawn parameter or a message: it is already on
      //  the controller before the effect is ever applied, so the effect script
      //  stays generic and each chassis can differ with no code.
      //
      //  TEST VALUE. ff00ff is deliberately unmissable so the first in-game
      //  check cannot confuse "the fade works" with "the colour is wrong".
      //  Six hex digits, no alpha -- the directive is fade=RRGGBB=amount and
      //  alpha is carried separately by ?multiply.
      "statusProperties" : { "targetMaterialKind" : "robotic", "petports_fadeColor" : "d091ef" },

      "appliesEnvironmentStatusEffects" : false,
      //  TRUE SO THAT WEATHER CAN ACTUALLY HURT A UNIT. It was false, which made
      //  every petport chassis accidentally immune to toxic rain -- not by any
      //  design, but because a blanket flag suppressed the whole category. That
      //  made the poison module a liquid-only feature and left the toxic-planet
      //  deploy route protected for a reason nobody chose and nothing recorded.
      //
      //  THIS ADMITS EVERY WEATHER EFFECT, NOT JUST POISON. There is no per-type
      //  gate -- the flag is all or nothing -- so electrical storms, blizzards
      //  and ember fall now reach these units too, and only poison has a module
      //  answering it. That surface is accepted deliberately rather than
      //  overlooked; the alternative was a baseline immunity stats block on all
      //  four chassis, which reads as arbitrary the moment this note is lost.
      "appliesWeatherStatusEffects" : true,
      "minimumLiquidStatusEffectPercentage" : 0.1,

      "primaryScriptSources" : [ "/stats/monster_primary.lua" ],
      "primaryScriptDelta" : 5,

      "stats" : {
        "knockbackStunTime" : { "baseValue" : 0.25 },
        "knockbackThreshold" : { "baseValue" : 9 },
        "maxHealth" : { "baseValue" : 72 },
        "protection" : { "baseValue" : 1.0 },
        "healthRegen" : { "baseValue" : 0.0 },
        "powerMultiplier" : { "baseValue" : 1.0 }
      },

      //  Mirrors petbunny's shape: defaultPercentage, not initialValue, and the
      //  stunned resource that knockout drains.
      "resources" : {
        "stunned"   : { "deltaValue" : -1.0, "initialValue" : 0.0 },
        "health"    : { "maxStat" : "maxHealth", "deltaStat" : "healthRegen", "defaultPercentage" : 100 },
        "sleepy"    : { "maxValue" : 100, "defaultPercentage" : 10 },
        "hunger"    : { "maxValue" : 100, "defaultPercentage" : 10 },
        "petports_fuel" : { "maxValue" : 900, "defaultPercentage" : 100 },
        "playful"   : { "maxValue" : 100, "defaultPercentage" : 10 },
        "curiosity" : { "maxValue" : 100, "defaultPercentage" : 10 }
      }
    },

    "mouthOffset" : [0, 0],
    "feetOffset" : [0, -8]
  }
}
