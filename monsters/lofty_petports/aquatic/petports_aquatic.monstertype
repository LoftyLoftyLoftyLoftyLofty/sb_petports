//  M.A.U.S. UTILITY UNIT -- AQUATIC
//
//  A COPY of flyer/petports_flyer.monstertype. Read that file for why the
//  ground recovery machinery needs no removing, why gravityEnabled reaches the
//  engine's pathfinder, and where the arrival radius comes from -- all of it
//  applies here unchanged, because AN AQUATIC UNIT IS A FLYER WITH A MEDIUM
//  CONSTRAINT AND NOTHING ELSE.
//
//  WHY IT IS NOT A FISH
//
//  Vanilla's swimming monsters keep gravity ON and float on liquidBuoyancy.
//  They also cannot pathfind: PathFinder:canPathfind is
//
//      mcontroller.onGround() or not mcontroller.baseParameters().gravityEnabled
//
//  and a gravity-enabled actor suspended in water is not onGround, so find()
//  never starts a search. Vanilla works around this by not pathfinding at all --
//  swimmingMonster.lua steers on whisker sensors and reverses when it bumps
//  something. Fine for ambient wildlife, useless for a unit that must reach a
//  named crate two rooms away.
//
//  So gravity stays OFF and the constraint is authored. See petports_canFly and
//  petports_canSwim below.
//
//  WHAT DIFFERS FROM THE FLYER
//
//    type / categories        unique, or the chassis wear each other's bodies
//    animation                its own file, same content today
//    petports_canFly/canSwim  false / true -- the entire locomotion difference
//    liquid force + friction  mirroring the air values
//    liquidBuoyancy           0, stated rather than defaulted
//
//  Everything else is the flyer's, unchanged, on purpose.

{
  "type" : "petports_aquatic",
  "shortdescription" : "Utility Unit",
  "description" : "A M.A.U.S. utility unit sealed for submersion. Small, tireless, and entirely at home underwater.",

  //  Binding key for this type's monsterpart pool. MUST DIFFER FROM THE DRONE'S
  //  -- the engine picks at random from every monsterpart matching the category,
  //  so a shared one means each type randomly wears the other's body.
  "categories" : [ "petports_aquatic" ],
  "parts" : [ "body" ],

  "animation" : "petports_aquatic.animation",

  "dropPools" : [ ],

  "capturable" : false,

  "baseParameters" : {
    "persistent" : true,
    "damageTeamType" : "ghostly",

    "scripts" : [
      "/monsters/pets/groundPet.lua",
      "/scripts/pathing.lua",
      "/scripts/stateMachine.lua",
      "/scripts/util.lua",
      "/scripts/vec2.lua",

      "/monsters/pets/idleState.lua",
      "/monsters/pets/wanderState.lua",

      "/monsters/pets/actions/followAction.lua",
      "/monsters/pets/actions/inspectAction.lua",
      "/monsters/pets/actions/eatAction.lua",
      "/monsters/pets/actions/begAction.lua",
      "/monsters/pets/actions/pounceAction.lua",

      "/scripts/lofty_petports/petports_work.lua",
      "/scripts/lofty_petports/petports_habitat.lua",
      "/monsters/lofty_petports/petports_petBehavior.lua",
      "/monsters/lofty_petports/petports_contract.lua",
      "/monsters/lofty_petports/petports_placement.lua",
      "/monsters/lofty_petports/petports_think.lua",
      "/monsters/lofty_petports/petportsSleepAction.lua",
      "/monsters/lofty_petports/petportsTaskAction.lua",

      //  FLYER ONLY, AND IT MUST COME AFTER groundPet.lua.
      //
      //  It shadows groundPet.lua's global approachPoint by capturing the
      //  original at chunk-load time and delegating back to it whenever gravity
      //  is on. Listed before groundPet.lua the capture binds nil and every
      //  call raises. Deliberately not nil-guarded -- see the file header.
      //
      //  The drone's monstertype does NOT list this file, so the working ground
      //  unit cannot be reached by anything in it.
      "/monsters/lofty_petports/petports_flyapproach.lua"
    ],

    "petBehavior" : "petBehavior",

    "anchorName" : "petports_petport",

    "petports_allowSleep" : false,

    "petResources" : {
      "sleepy" : 10,
      "hunger" : 60,
      "playful" : 10,
      "curiosity" : 60
    },
    "petResourceDeltas" : {
      "sleepy" : 1,
      "hunger" : 0.5,
      "playful" : 1,
      "curiosity" : 1
    },

    //  Identical to the drone's. Note that with strictPortTethering on, none of
    //  the appetite actions can ever be picked: petports_leashTask never returns
    //  nil for a tethered unit, it queues at LEASH_SCORE 120, and every appetite
    //  caps at 100. Kept in step with the drone so the two do not silently
    //  diverge before that changes.
    "actionParams" : {
      "hungerStarvingLevel" : 80,
      "beg" : { "minScore" : 50, "cooldown" : 5, "distance" : 3, "emoteCooldown" : 2 },

      "follow" : {
        "minScore" : 70,
        "cooldown" : 30,
        "curiosityDelta" : -25,
        "boredTime" : 1.5,
        "startDistance" : 10,
        "stopDistance" : 5,
        "runDistance" : 20
      },

      "inspect" : { "minScore" : 20, "cooldown" : 8 },
      "eat" : { "minScore" : 0, "minHunger" : 40, "cooldown" : 0, "distance" : 2 },
      "play" : { "minScore" : 20, "cooldown" : 2 },
      "sleep" : { "minScore" : 50, "minSleepy" : 75, "cooldown" : 10 },
      "starving" : { "minScore" : 60, "cooldown" : 3 }
    },

    "pathing" : { "canOpenDoors" : false },

    "metaBoundBox" : [-0.5, -0.75, 0.5, 0.6],
    "scale" : 1.0,

    "querySurroundingsCooldown" : 1,

    "wander" : {
      "wanderTime" : [5, 10],
      "changeDirectionTime" : [5, 10],
      "changeDirectionWait" : [1, 3]
    },
    "idle" : { "idleTime" : [4, 8], "standTime" : 2 },
    "pounce" : { "maxRange" : 10, "minRange" : 5 },

	//	go to the port and stay there when idle. do not wander
	"strictPortTethering" : true,

    //  LOCOMOTION MEDIA -- the whole difference between this chassis and the
    //  flyer, and the reason there is no separate "swimming" code anywhere.
    //
    //  petports_mediumAllows in petports_contract.lua reads these and gates
    //  every destination and every path sample against them. An aquatic unit is
    //  a flyer that may not occupy air; a flyer is one that may not occupy
    //  liquid; an amphibious chassis sets both true and needs nothing else.
    //
    //  BOTH FALSE IS PERMITTED and bricks the pet, deliberately -- see the
    //  header on petports_media().
    //  SEARCH COSTS. Water is this chassis's element, so a submerged tile must
    //  not cost five times a dry one -- vanilla's default encodes "swimming is a
    //  last resort", which is the opposite of true here.
    //
    //  liquidJumpCost is left at the default and is nearly inert: it prices a
    //  jump made FROM liquid, and a gravity-disabled actor does not jump.
    //
    //  NOTE THE ASYMMETRY, because it decides what cost can and cannot do for
    //  this chassis: there is no flyCost. Water can be made cheap, air cannot be
    //  made expensive, so an air route is still refused by plan validation
    //  rather than avoided by the search. Cost helps this unit find good wet
    //  routes; it cannot help it stop finding dry ones.
    "petports_swimCost" : 1,

    "petports_canFly" : false,
    "petports_canSwim" : true,

    //  LIQUIDS THIS CHASSIS WILL NOT ENTER.
    //
    //  A DENY-LIST, MATCHED BY NAME. Starbound has 255 liquid slots and almost
    //  all of the occupied ones are benign, so listing what is safe would mean
    //  breaking every liquid mod on contact and patching one entry per mod. The
    //  dangerous set is small, nameable and mostly vanilla, so it is the set
    //  worth writing down.
    //
    //  NAMES RATHER THAN IDS because the numbering is not something to hardcode
    //  from memory -- the only liquid id this mod has ever measured is 12 for
    //  swampwater, which matches no ordering anyone would guess.
    //  petports_liquidDenied resolves an id through root.liquidConfig and
    //  compares against the liquid's name AND its itemDrop, so either spelling
    //  works; a bare number is accepted too for anyone working from the wiki
    //  table. Whatever it resolved to is logged once per liquid encountered, so
    //  an entry that matches nothing shows up in one test cycle.
    //
    //  A DENIED LIQUID IS REFUSED AT 0.1 FILL, NOT 0.9 -- deep enough to swim in
    //  is a much higher bar than deep enough to kill, and
    //  minimumLiquidStatusEffectPercentage is 0.1. See PETPORTS_HARMFUL_FILL.
    //
    //  The flyer and the drone need no list: canSwim is false on both, so ALL
    //  liquid is already refused and a deny-list would be redundant.
    "petports_avoidLiquids" : [ "lava", "corelava", "poison" ],

    "movementSettings" : {

      //  THE ONE LINE THAT MAKES THIS A DIFFERENT LOCOMOTION CLASS.
      //
      //  It reaches further than it looks. PathFinder:start hands
      //  mcontroller.baseParameters() straight to world.platformerPathStart, so
      //  this is what makes the engine's search emit Fly edges instead of
      //  Walk/Jump/Arc/Drop/Land. PathFinder:canPathfind is
      //  `onGround() or not gravityEnabled`, so a flyer may also start a search
      //  at any time rather than only while standing. And PathMover:new defaults
      //  mustEndOnGround to this value -- which petports_pathOptions was
      //  overriding with a hardcoded true, and no longer is.
      "gravityEnabled" : false,

      //  OURS, NOT THE REFERENCE FLYER'S 2x2 BOX. The 1.6 x 1.6 octagon is
      //  tuned so the pathfinder rejects 1-tile-high tunnels while still
      //  threading 2-tile gaps, and that reasoning survives the switch to Fly
      //  edges unchanged -- a Fly edge needs clearance for the same body.
      //
      //  It also supplies the arrival radius. Every vertex here has magnitude
      //  sqrt(0.64 + 0.36) = exactly 1.0, so the poly is inscribed in a unit
      //  circle and FLY_ARRIVAL in petports_flyapproach.lua is measured rather
      //  than guessed. CHANGE THIS POLY AND THAT CONSTANT MUST MOVE WITH IT.
      "collisionPoly" :  [ [-0.8, -0.6], [-0.6, -0.8], [0.6, -0.8], [0.8, -0.6],
                    [0.8, 0.6], [0.6, 0.8], [-0.6, 0.8], [-0.8, 0.6] ],
      "mass" : 1.0,

      //  Inert for a flyer -- nothing on a Fly edge reads either, and
      //  PathMover:approachTargetPosition and moveX are both unreachable here.
      //  Kept because groundPet.lua's init caches runSpeed, and there is no gain
      //  in finding out the hard way what reads a nil.
      "walkSpeed" : 8,
      "runSpeed" : 12,

      //  Known-good flyer values, not the drone's. The drone's flySpeed 15 and
      //  airForce 50 were never tuned for flight, and its gravityMultiplier 1.5
      //  is deliberately absent here rather than set to 1.0 -- a gravity knob on
      //  a gravity-disabled actor implies something it does not do.
      //
      //  LIQUID MIRRORS AIR, DELIBERATELY AND EXACTLY.
      //
      //  controlFly is the swim primitive as well as the flight one -- vanilla's
      //  own fish issue exactly that call -- and liquid only swaps WHICH
      //  parameters govern it. So the air numbers this chassis inherits are
      //  mirrored rather than re-derived, on the expectation that the force and
      //  friction formula is the same in both media.
      //
      //  THAT EXPECTATION IS UNVERIFIED. If an aquatic unit drifts or overshoots
      //  where a flyer does not, this pair is the first suspect and the flyer's
      //  measured ladder (0.25 drifty, 1.0 biological, 2.0 robotic, 24 crisp)
      //  is the ladder to walk again in liquid.
      //
      //  For reference, vanilla's largefish ships liquidForce 150 and
      //  liquidFriction 2.0 -- which is a fish that glides, and would put the
      //  per-tick turn authority back where the overshoot bug lived.
      "liquidForce" : 9999.0,
      "liquidFriction" : 24.0,

      //  ZERO, SO flySpeed MEANS WHAT IT SAYS UNDERWATER.
      //
      //  MEASURED: with this left at the default, an aquatic unit configured for
      //  flySpeed 12 covered 6.17 tiles/s (median over 421 samples), taken from
      //  LOGGED POSITIONS rather than mcontroller.velocity(). Exactly half.
      //
      //  Read the positions, not the velocity, when checking this. Both chassis
      //  report a velocity well under flySpeed -- the flyer reads a rigid 7.2 --
      //  because friction takes its cut each engine tick and the script samples
      //  post-friction. That one is an artifact and the flyer genuinely travels
      //  ~12.3 tiles/s. The halving here was NOT an artifact and the positions
      //  are what separated the two.
      //
      //  liquidImpedance is the default_actor_movement parameter that exists to
      //  slow actors in water, and neither chassis overrode it. Zeroing it is
      //  the fix on the expectation that it is the 0.5; if the measurement does
      //  not move to ~12.3 after this, it is something else and the positions
      //  will say so again.
      "liquidImpedance" : 0.0,

      //  ZERO, NOT THE FISH'S 1.0. Buoyancy is a force opposing gravity and
      //  there is no gravity here, so it should compute to nothing -- but
      //  "should" is doing work in that sentence and an unexplained upward
      //  drift would read as a tuning problem while being a physics one. Stated
      //  explicitly so it is never the unknown.
      "liquidBuoyancy" : 0.0,

      //  Vanilla's fish also carry moveRatioLimit 0.6, which stops them
      //  swimming straight up. Deliberately absent: that is fish character, and
      //  a utility unit that cannot rise vertically cannot service a column of
      //  submerged crates.

      //  THE TUNING LADDER, MEASURED IN GAME ACROSS FOUR RUNS.
      //
      //    airForce 25   airFriction 0.25  the reference flyer's. Coasted well
      //                                    past its stopping point; overshoot
      //                                    produced visibly wrong behaviour.
      //    airForce 25   airFriction 1.0   correct, and SHIPPABLE FOR A
      //                                    BIOLOGICAL FLYER -- carried momentum
      //                                    reads as a living thing with mass.
      //    airForce 25   airFriction 2.0   a robot that stops where it meant to,
      //                                    but still drifting off diagonals.
      //    airForce 9999 airFriction 24    THIS. Straight lines, no overshoot.
      //
      //  THE LAST STEP IS A PAIR, NOT A FRICTION CHANGE. Friction 24 alone would
      //  make the unit sluggish, because drag-limited speed is airForce divided
      //  by airFriction -- at 25/2.0 that is 12.5, which was quietly the real
      //  speed cap rather than flySpeed. At 9999/24 it is ~416, so flySpeed
      //  governs and friction only kills residual drift. Move one, move both.
      //
      //  THE VALUE FOLLOWS FROM WHAT THE UNIT IS. Do not "correct" a future
      //  biological flyer up to 24 on the strength of this file; that would be
      //  the same mistake as taking 0.25 from a wandering monster and expecting
      //  it to suit a unit that flies to a specific tile and holds there.
      //
      //  A NOTE ON airForce 9999. Full reversal of a 12-speed vector inside one
      //  ~82ms script tick needs about 300, so this is ~30x more authority than
      //  steering requires. Harmless for steering, but airForce answers EVERY
      //  impulse -- knockback, liquid, collision response -- and units are
      //  destructible. If knockback ever reads as a teleport, this is why.
      //
      //  Reported speed will look like flySpeed x (1 - airFriction/60): at 60Hz
      //  physics, friction takes 40% of the velocity each engine tick and
      //  airForce restores it, and the script samples post-friction. That is why
      //  mcontroller.velocity() reads a rigid 7.2 while logged POSITIONS advance
      //  a full tile per ~81ms. Trust the positions.
      "flySpeed" : 12,
      "airFriction" : 24.0,
      "airForce" : 9999.0
    },

    "bodyMaterialKind" : "robotic",

    "knockoutTime" : 0,
    "knockoutEffect" : "blink",
    "deathParticles" : "deathPoof",

    "touchDamage" : { "poly" : [], "damage" : 0, "teamType" : "ghostly", "damageSourceKind" : "default" },

    "statusSettings" : {
      //  THE MATERIALISE / DEMATERIALISE COLOUR, read by
      //  petports_unitfade.lua off the parent's status controller. A status
      //  property rather than a spawn parameter or a message: it is already on
      //  the controller before the effect is ever applied, so the effect script
      //  stays generic and each chassis can differ with no code.
      //
      //  TEST VALUE. ff00ff is deliberately unmissable so the first in-game
      //  check cannot confuse "the fade works" with "the colour is wrong".
      //  Six hex digits, no alpha -- the directive is fade=RRGGBB=amount and
      //  alpha is carried separately by ?multiply.
      "statusProperties" : { "targetMaterialKind" : "robotic", "petports_fadeColor" : "91efa1" },

      "appliesEnvironmentStatusEffects" : false,
      //  TRUE SO THAT WEATHER CAN ACTUALLY HURT A UNIT. It was false, which made
      //  every petport chassis accidentally immune to toxic rain -- not by any
      //  design, but because a blanket flag suppressed the whole category. That
      //  made the poison module a liquid-only feature and left the toxic-planet
      //  deploy route protected for a reason nobody chose and nothing recorded.
      //
      //  THIS ADMITS EVERY WEATHER EFFECT, NOT JUST POISON. There is no per-type
      //  gate -- the flag is all or nothing -- so electrical storms, blizzards
      //  and ember fall now reach these units too, and only poison has a module
      //  answering it. That surface is accepted deliberately rather than
      //  overlooked; the alternative was a baseline immunity stats block on all
      //  four chassis, which reads as arbitrary the moment this note is lost.
      "appliesWeatherStatusEffects" : true,
      "minimumLiquidStatusEffectPercentage" : 0.1,

      "primaryScriptSources" : [ "/stats/monster_primary.lua" ],
      "primaryScriptDelta" : 5,

      "stats" : {
        "knockbackStunTime" : { "baseValue" : 0.25 },
        "knockbackThreshold" : { "baseValue" : 9 },
        "maxHealth" : { "baseValue" : 72 },
        "protection" : { "baseValue" : 1.0 },
        "healthRegen" : { "baseValue" : 0.0 },
        "powerMultiplier" : { "baseValue" : 1.0 }
      },

      "resources" : {
        "stunned"   : { "deltaValue" : -1.0, "initialValue" : 0.0 },
        "health"    : { "maxStat" : "maxHealth", "deltaStat" : "healthRegen", "defaultPercentage" : 100 },
        "sleepy"    : { "maxValue" : 100, "defaultPercentage" : 10 },
        "hunger"    : { "maxValue" : 100, "defaultPercentage" : 10 },
        "playful"   : { "maxValue" : 100, "defaultPercentage" : 10 },
        "curiosity" : { "maxValue" : 100, "defaultPercentage" : 10 }
      }
    },

    "mouthOffset" : [0, 0],
    "feetOffset" : [0, -8]
  }
}
