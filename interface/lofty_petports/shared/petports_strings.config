//  EVERY VISIBLE STRING IN EVERY PANE, IN ONE FILE.
//
//  WHY ONE FILE: the wording repeats between panes -- four "enabled"
//  checkboxes, three pet-feeder ones -- and spread across four pane configs
//  there was no way to read them together, so they drifted. This is also the
//  only shape a translator can work with.
//
//  KEYED BY MEANING, NOT BY WIDGET NAME. Two panes that say the same thing
//  should point at the same key rather than at two copies that agree today.
//  `common` is for exactly that; a string used once lives under its own pane.
//
//  HOW A STRING REACHES A WIDGET: the pane config names the key beside the
//  widget, as `petportsString` for a label or button caption and `petportsTip`
//  for hover text, and the sweep in petports_strings.lua resolves it at init.
//  Adding or rewording a string is this file plus one key, and no Lua.
//
//  IF THIS FILE FAILS TO LOAD, NOTHING IS SUBSTITUTED. The sweep leaves the
//  widget alone and the pane's own declared value shows -- which is "--" for
//  every migrated widget, deliberately, so a broken load is a pane full of
//  dashes rather than a pane that looks right and is not.
//
//  A TOOLTIP IS AN OBJECT, a label is a string. Both are addressed by the same
//  dotted key; what comes back decides how it is used.
{
	//  SHARED BY MORE THAN ONE PANE. A string lands here the moment a second
	//  pane needs the same words, so the two cannot drift apart later.
	"common" : {
		"beaconactive" : "Beacon active",
		"petfeeder" : "Pet feeder"
	},

	//  ---- the two beacons ----------------------------------------------------
	//
	//  BOTH ARE ScriptPanes, so their tooltips work through createTooltip and
	//  the engine builds them from `tooltipLayout` -- unlike the petport, which
	//  draws its own. Only the deposit beacon has any.
	//
	//  A RUNTIME STRING IS A FORMAT STRING HERE, not a sentence assembled in
	//  Lua out of fragments. "Allow" .. " " .. name produces English word order
	//  in every language; "%s %s" lets a translator move the pieces. The verbs
	//  are their own keys for the same reason -- they are words, not code.
	"beacon" : {
		"base" : "Accept everything",
		"rules" : "Rules - lower entries win",
		"groups" : "Add a rule",

		//  Shown before a rule is selected. Once one is, the label is rebuilt
		//  from `verb` and `narrow` below.
		"subgroups" : "Select a rule to narrow it",

		"verb" : {
			"allow" : "Allow",
			"deny" : "Deny"
		},

		//  %s verb, %s group name.
		"narrow" : "%s %s",

		//  Same two, for a group that has no subgroups to narrow -- Unsorted is
		//  the case, and an empty grid under a normal label reads as a bug.
		"narrownothing" : "%s %s -- nothing to narrow",

		"tip" : {
			"included" : "Included in this rule.",
			"excluded" : "Excluded from this rule."
		}
	},

	"restock" : {
		"heading" : "Requested items",
		"min" : "Fetch below",
		"max" : "Fill up to",

		"unsaved" : "Waiting for the beacon - change not saved yet.",
		"empty" : "Click the slot holding an item to add one.",
		"none" : "Nothing requested",

		//  %s request count.
		"count" : "%s requested",

		"hint" : "Click holding an item to add",
		"blockedtitle" : "Cannot configure here"
	},

	//  ---- the upcycler -------------------------------------------------------
	//
	//  MIGRATED 2026-08-30, LAST OF THE FOUR. The backlog counted 14 literals in
	//  the config; the pane also carried about 26 more at runtime, including the
	//  whole warning table. Both are here.
	//
	//  `Pet feeder` IS NOT HERE. It is the third pane to say it, so it lives in
	//  `common` -- which is what common is for.
	"upcycler" : {
		"running" : "Upcycler running",
		"rules" : "Upcycle above this many",
		"editor" : "Add a rule",
		"samplehint" : "Click holding an item",

		//  THE THRESHOLD LABEL SAYS TWO DIFFERENT THINGS depending on whether an
		//  existing rule is selected or a new one is being added.
		"threshold" : "Keep at most",
		"thresholdnew" : "New rule keeps",

		//  SLOT CAPTIONS. Three words, deliberately lower case, sitting under
		//  the three machine slots.
		"slot" : {
			"input" : "in",
			"output" : "out",
			"reagent" : "reagent"
		},

		"tab" : {
			"instructions" : "How it works",
			"flavors" : "Flavors"
		},

		"instructions" : "Drop an item on the slot to the left to add a rule. Anything above that rule's threshold is converted into Pet Treats.\n\nPut a reagent in the reagent slot to flavor what it makes. See the Flavors tab for what makes what.",

		//  THE FLAVORS TAB.
		//
		//  `rowplaceholder` is the value declared on the list template's own
		//  label, which every real row overwrites. It was `Replace Me` in the
		//  config and must not ship as that; a dash matches every other migrated
		//  widget and reads as missing rather than as a joke.
		"flavors" : {
			"rowplaceholder" : "--",
			"prompt" : "Select a flavor",

			//  %s flavor name, %s reagent count already rendered by `count`.
			"selected" : "%s -- %s",

			//  %s flavor name, %s reagent count. Two spaces, matching the art.
			"row" : "%s  (%s)"
		},

		//  THE STATUS LINE. %s is a rule count already rendered by `count`, so
		//  every specifier here is %s -- see the note in `petport.stats`.
		"status" : {
			"off" : "%s. Machine is off.",
			"idle" : "%s. Running, input empty.",

			//  %s rule count, %s the item being converted.
			"converting" : "%s. Converting %s.",

			"unreadable" : "Could not read machine state."
		},

		//  %s progress, %s target.
		"progress" : "%s / %s to next treat",

		//  COUNTED NOUNS, ONE KEY PER FORM.
		//
		//  This replaces a `plural(count, word)` helper that built "3 rules" by
		//  appending an "s" to the singular. That is English word formation in
		//  code -- the exact thing the note at the top of `beacon` forbids -- and
		//  it produces nonsense in any language with a different plural rule, or
		//  with more than two forms. %s is the count, pre-rendered.
		//
		//  A LANGUAGE WITH MORE THAN TWO FORMS still needs more than this, but
		//  the shape is now data rather than code, so adding a `few` costs a key
		//  and a branch in one helper instead of a rewrite in the pane.
		"count" : {
			"rule" : {
				"one" : "%s rule",
				"many" : "%s rules"
			},
			"reagent" : {
				"one" : "%s reagent",
				"many" : "%s reagents"
			}
		},

		//  THE WARNING LINE, shown on `warnText` beside the exclamation icon
		//  whenever something is stopping the machine.
		//
		//  KEYED BY THE CLASSIFIER'S CAUSE ENUM, one key per cause in
		//  petports_upcyclerstate.lua. THE CLASSIFIER CARRIES NO TEXT AND SHOULD
		//  NOT START: it returns a cause and the pane renders it, which is what
		//  lets the machine and the pane agree on a verdict without agreeing on
		//  wording. Adding a cause means adding a key here.
		//
		//  %s is an item's display name in every one of these; slotsdeadlocked
		//  takes two.
		"warn" : {
			"beacon" : "A beacon is in this machine. Machine slots are not storage, so the network ignores it. Take it back out.",

			//  %s the item generically stopping the machine, when the cause has
			//  no more specific line than this.
			"generic" : "%s is stopping the machine.",

			"outputblocked" : "%s is blocking the output. Nothing will be made until it is taken out.",

			//  NAMES BOTH ITEMS, because naming one is what made this look like
			//  ordinary waiting for so long. Neither can move until a slot is
			//  freed by hand.
			"slotsdeadlocked" : "%s and %s each need the other's slot. Take one out to break the tie.",

			"inputexempt" : "%s can never be upcycled.",
			"inputnorule" : "No rule names %s, so it will not be converted.",
			"inputstranded" : "%s is denied the burner and cannot go in the reagent slot either. Change its rule or take it out.",
			"inputwaiting" : "%s is waiting for the reagent slot to clear.",

			"reagentexempt" : "%s can never be upcycled.",
			"reagentnotareagent" : "%s is not a reagent, so it will not flavor anything. See the Flavors tab.",
			"reagentstranded" : "%s is denied both slots by its own rule. Change the rule or take it out.",
			"reagentwaiting" : "%s is waiting for the burner to clear."
		}
	},

	"petport" : {
		//  THE SETTINGS LIST. Rows are described in SETTING_ROWS in
		//  petportconfig.lua and their wording lives here -- adding a setting is
		//  an entry there plus a key here, with no config edit.
		//
		//  THE MEDIC CLASS NAMES ARE PLAYER-FACING, NOT THE INTERNAL KEYS.
		//  "podpet" and "animal" are dispatch identifiers; a player sees the
		//  things they recognise from the game they are playing.
		//
		//  "HEAL", NOT "TREAT", AND THAT IS NOT A STYLE CHOICE. A TREAT is
		//  already a thing in this mod -- the flavor system, the feed slot two
		//  tabs away -- so five rows beginning "Treat" read as being about food.
		"setting" : {
			"carried" : "Show speech bubbles",
			"nametag" : "Show name above unit",
			"medicblock" : "Medic module",
			"medicplayer" : "Heal players",
			"mediccrew" : "Heal crew members",
			"medicnpc" : "Heal other friendly NPCs",
			"medicpodpet" : "Heal captured pets",
			"medicanimal" : "Heal farm animals",
			"medicunit" : "Heal other units",

			"farmingblock" : "Farming module",
			"farmharvest" : "Harvest crops",
			"farmwater" : "Water crops",
			"farmreplant" : "Replant seeds",
			"farmanimals" : "Harvest animals",
			"farmtraps" : "Moth Traps, etc.",

			//  SHORT, BECAUSE THE ROW IS NOT. A colour row spends its right-hand
			//  sixty pixels on two arrows and a field, so a label written like
			//  its neighbours -- "Set the red channel" -- would run under them.
			"rgbblock" : "RGB lamp module",
			"rgbred" : "Red",
			"rgbgreen" : "Green",
			"rgbblue" : "Blue"
		},

		"tab" : {
			"details" : "Details",
			"settings" : "Settings",
			"stats" : "Stats"
		},

		"socket" : {
			"label" : "unit"
		},

		//  Shown in place of the unit's name when the port is empty.
		"nounit" : "No unit",

		"cargo" : {
			"label" : "Cargo",
			"take" : "Take cargo",
			"feedhint" : "Click the slot holding treats to feed"
		},

		//  TWO WORDS FOR ONE BAR, chosen from the unit's own bodyMaterialKind.
		//  See dd.fuel.label -- "Fuel" is wrong over a biological pet and
		//  "Hunger" is wrong over a drone, and the monstertype already knows
		//  which it is without anything new being authored.
		"fuel" : {
			"robotic" : "Fuel",
			"organic" : "Hunger"
		},

		"details" : {
			"prefers" : "Prefers",
			"modules" : "Modules",
			"moduleshint" : "Socket pet upgrade modules here to enhance your pet's abilities.",
			"rename" : "Rename"
		},

		"settings" : {
			"displaycargo" : "Display cargo"
		},

		//  THE STATS TAB. Sentences assembled from patterns, never concatenated
		//  in Lua -- see the note at the top of `beacon`. Values arrive
		//  pre-formatted as strings (grouped digits, "%.1f" hours), so every
		//  specifier here is %s.
		"stats" : {
			//  %s grouped item total.
			"moved" : "Items moved: %s",

			//  %s grouped per-hour rate. The line is withheld entirely until
			//  the active clock has run long enough for the division to mean
			//  anything -- see RATE_FLOOR_MINUTES in the pane.
			"rate" : "%s / hr active",

			//  %s one of the two duration forms below. "Active" means time ON
			//  A TASK -- the port only runs the clock while the unit holds
			//  work, matching how hunger drains only while working. Idle time
			//  is not counted.
			"active" : "Active: %s",
			"activeminutes" : "%s min",
			"activehours" : "%s h",

			//  The farm and odometer block, in the pane's line order.
			//  %s grouped counts; traveled is whole tiles. Harvested and
			//  livestock count task EXECUTIONS, not items dropped.
			"planted" : "Crops planted: %s",
			"watered" : "Tiles watered: %s",
			"harvested" : "Crops harvested: %s",
			"livestock" : "Livestock harvested: %s",
			"traps" : "Traps emptied: %s",
			"traveled" : "Traveled: %s tiles",
			"headpats" : "Headpats: %s",

			//  FISHING. `fished` counts task executions like harvested and
			//  livestock do -- one per fish caught, however many stacks the
			//  treasure pool rolled.
			//
			//  THE TIER LINE IS BUILT FROM WHATEVER TIERS ARRIVED, so it takes
			//  a pre-joined string rather than one specifier per rarity. Tier
			//  names come from the spawner's own rarities table, which a
			//  fishing zone may replace, so there is no fixed set to write
			//  labels for -- see the pane, which title-cases what it is given.
			"fished" : "Fish caught: %s",

			//  ONE ROW PER RARITY, INDENTED UNDER THE TOTAL. %s tier name,
			//  already title-cased by the pane, then %s grouped count.
			//
			//  A ROW PER TIER RATHER THAN ONE JOINED LINE, because the vertical
			//  form scales and the horizontal one does not: a fishing zone may
			//  declare tiers of its own, and six of them on one line would run
			//  off the pane.
			"fishedtier" : "  %s: %s",

			"fed" : "Treats eaten: %s",
			"fedflavor" : "  %s: %s",

			//  Doses delivered by the medic module, counting task executions --
			//  one per patient reached, whatever their health was.
			"dosed" : "Heals delivered: %s"
		},

		"port" : {
			"heading" : "Network",
			"enabled" : "Port enabled",
			"crosshairs" : "Claim Markers",
			"tasks" : "Features"
		},

		//  THE FOUR PARTICIPATION GROUPS. Label and tooltip are separate keys
		//  because they are separate widgets -- the label is mouseTransparent
		//  and the tooltip is hosted on the checkbox.
		"group" : {
			"hauling" : "Item Pickup",
			"sorting" : "Sorting",
			"farming" : "Farming",
			"machines" : "Machines"
		},

		"tip" : {
			//  ONE PER SETTINGS ROW, ON THE CHECKBOX -- the petport's convention
			//  for checkbox help. A row with no tip simply has none; the sweep
			//  leaves the widget alone.
			"carried" : {
				"title" : "Speech bubbles",
				"body" : "Show what this unit is doing in a bubble above its head while it works."
			},
			"nametag" : {
				"title" : "Name above unit",
				"body" : "Show this unit's name floating above it. Off by default, so a base full of units is not a wall of labels."
			},
			"medicplayer" : {
				"title" : "Heal players",
				"body" : "Spend medical goods on you and other players who are hurt."
			},
			"mediccrew" : {
				"title" : "Heal crew members",
				"body" : "Spend medical goods on your own crew. They follow you into danger and cannot rest, so this is usually worth it."
			},
			"medicnpc" : {
				"title" : "Heal other friendly NPCs",
				"body" : "Spend medical goods on villagers, tenants and guards. They can sleep in a bed to heal for free, so you may prefer to save the goods. Hostile NPCs are never healed."
			},
			"medicpodpet" : {
				"title" : "Heal captured pets",
				"body" : "Spend medical goods on pets deployed from a capture pod."
			},
			"medicanimal" : {
				"title" : "Heal farm animals",
				"body" : "Spend medical goods on livestock. They are often lightly hurt, so this can be a busy setting."
			},
			"medicunit" : {
				"title" : "Heal other units",
				"body" : "Spend medical goods on other units in the network, including other medics."
			},
			"farmharvest" : {
				"title" : "Harvest crops",
				"body" : "Pick crops that have finished growing and carry them back to storage."
			},
			"farmwater" : {
				"title" : "Water crops",
				"body" : "Fetch water from storage and water dry soil. Includes the trip to collect it."
			},
			"farmreplant" : {
				"title" : "Replant seeds",
				"body" : "Put a seed back in the ground after a harvest, fetching one from storage if needed."
			},
			"farmanimals" : {
				"title" : "Harvest animals",
				"body" : "Collect wool, milk and eggs from livestock that are ready to give them."
			},
			"farmtraps" : {
				"title" : "Moth Traps, etc.",
				"body" : "Empty ^green;moth traps^reset; and similar objects that fill up over time. These are not crops and are collected by hand, not harvested."
			},
			"rgbred" : {
				"title" : "Red",
				"body" : "How much red the unit's lamp gives off, from 0 to 255."
			},
			"rgbgreen" : {
				"title" : "Green",
				"body" : "How much green the unit's lamp gives off, from 0 to 255."
			},
			"rgbblue" : {
				"title" : "Blue",
				"body" : "How much blue the unit's lamp gives off, from 0 to 255."
			},
			"hauling" : {
				"title" : "Item Pickup",
				"body" : "This pet will ^green;pick up unattended items^reset; within network coverage."
			},
			"sorting" : {
				"title" : "Sorting",
				"body" : "This pet will ^green;move items^reset; between storage containers within network coverage."
			},
			"farming" : {
				"title" : "Farming",
				"body" : "This pet will ^green;automatically water and replant crops^reset; within network coverage."
			},
			"machines" : {
				"title" : "Machines",
				"body" : "This pet will automatically ^green;deliver requested items to machines^reset; (such as Upcyclers) within network coverage."
			},
			"crosshairs" : {
				"title" : "Claim Markers",
				"body" : "Display claim marker crosshairs on items within network coverage."
			}
		}
	}
}
