//  PETPORTS -- UPCYCLER PANE
//
//  A CONTAINER PANE WITH A SCRIPT, WHICH IS A THIRD THING.
//
//  This is neither a ScriptPane nor a plain chest interface. A container
//  object's `uiConfig` can carry `scripts`, `scriptDelta` and
//  `scriptWidgetCallbacks` alongside its `gui`, and vanilla's cropshipper
//  proves it: /interface/scripted/cropshipper/cropshippergui.config is a
//  40-slot container whose pane runs Lua, reads its grids with
//  widget.itemGridItems, and messages its object via pane.containerEntityId().
//
//  That collapses the whole ScriptPane-versus-container question. We get real
//  container slots AND arbitrary widgets in one window.
//
//  CONSEQUENCE WORTH STATING: NO TOKEN SYSTEM HERE.
//
//  beaconconfig needs one because a ScriptPane addressing a HELD activeitem
//  cannot tell which hotbar slot it is talking to, so a player swapping slots
//  mid-edit could retarget a write. This pane addresses an entity id. There is
//  exactly one upcycler on the other end and it cannot change.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT of the footer, and the usable band is
//  y 25..249 -- header 25 + body 224 + footer 25. A widget outside that is not
//  an error, it is simply drawn over the frame or not drawn at all.
//
//  FRAME AND ROW ART ARE BORROWED FROM THE BEACON PANE, deliberately. Both are
//  already spliced to size and already the right width; generating a second
//  set for a skeleton would be art work spent on something that may move.
//
//  INTERACTIVE WIDGETS INSIDE LIST ROWS -- registerMemberCallback ONLY.
//
//  A row widget naming a callback from scriptWidgetCallbacks CANNOT be built:
//  ListWidget constructs its rows with a different parser that has never heard
//  of them, and addListItem throws at CONSTRUCTION rather than at click, which
//  means the pane does not open at all. Row callbacks are registered at runtime
//  with widget.registerMemberCallback, BEFORE the first addListItem. So
//  `ruleRowRemove` appears here and in the script's registration call, and
//  deliberately NOT in scriptWidgetCallbacks below.
//
//  The callback receives (memberLeafName, widgetData). Arg 1 is the leaf name
//  only and is identical for every row, so only arg 2 can identify which row
//  fired -- which is why refreshRules calls widget.setData on every row.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/beaconconfig/panewide_header.png",
			"fileBody" : "/interface/lofty_petports/beaconconfig/panewide_body.png",
			"fileFooter" : "/interface/lofty_petports/beaconconfig/panewide_footer.png"
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"pressedOffset" : [ 0, 0 ],
			"position" : [ 315, 255 ],
			"zlevel" : 1
		},

		"title" : {
			"type" : "title",
			"title" : "Upcycler",
			"subtitle" : "Surplus to fuel",
			"position" : [ -3, 80 ]
		},

		//  ---- machine on/off ------------------------------------------------
		//
		//  UNCHECKED ON A FRESHLY PLACED MACHINE, ALWAYS. The object stores no
		//  `enabled` parameter until this box is ticked, and absence means off.
		//  `checked` below is the pre-script default only; init overwrites it
		//  from the real state before the player sees it.

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 10, 222 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 224 ],
			"value" : "Upcycler running",
			"mouseTransparent" : true
		},

		//  ---- the rule list -------------------------------------------------
		//
		//  ORDER IS NOT SYNTAX HERE, unlike the beacon filter. Each rule names
		//  one item and one threshold and they do not interact, so there is no
		//  last-match-wins to explain and nothing to reorder.

		"rulesLabel" : {
			"type" : "label",
			"position" : [ 10, 190 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Upcycle above this many",
			"mouseTransparent" : true
		},

		"rulesScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 30, 160, 188 ],
			"children" : {
				"rulesList" : {
					"type" : "list",

					//  SELECTION IS LIVE HERE, unlike the beacon pane's group
					//  picker. Picking a rule loads its threshold into the field
					//  below, so the list is a selection rather than a menu of
					//  actions.
					//
					//  A row button does NOT swallow the click -- measured on
					//  the beacon pane, where both fired on one press. The only
					//  button in these rows is the X, and a click that both
					//  selects and deletes is harmless because the delete
					//  rebuilds the list and drops the selection anyway.
					"callback" : "ruleSelected",
					"schema" : {
						"selectedBG" : "/interface/lofty_petports/shared/row_144_selected.png",
						"unselectedBG" : "/interface/lofty_petports/shared/row_144.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 144, 16 ],
						"listTemplate" : {
							"rowBG" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_144.png",
								"position" : [ 0, 0 ],
								"zlevel" : -2,
								"mouseTransparent" : true
							},

							//  NO wrapWidth. A wrapped label in a 16px row
							//  renders its overflow ABOVE the anchor, which
							//  reads as stray pixels bleeding into the row
							//  above. Labels are shortened at the source
							//  instead.
							"ruleText" : {
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"value" : "",
								"mouseTransparent" : true
							},

							"rowRemove" : {
								"type" : "button",
								"base" : "/interface/x.png",
								"hover" : "/interface/xhover.png",
								"pressed" : "/interface/xpress.png",
								"position" : [ 131, 3 ],
								"callback" : "ruleRowRemove"
							}
						}
					}
				}
			}
		},

		//  TWO GRIDS. THAT IS THE HARD LIMIT, AND IT IS NOW MEASURED FROM BOTH
		//  SIDES.
		//
		//  ContainerPane registers callbacks for `itemGrid` and `itemGrid2` and
		//  binds those two grids to the container's item bag. Nothing else:
		//
		//    `reagentGrid`, WITH callbacks supplied -> constructed fine, drew zero
		//    slots, said nothing in the log.
		//
		//    `itemGrid3`, with none -> (WidgetParserException) Failed to find
		//    itemgrid callback named: 'itemGrid3', out of ContainerPane's
		//    constructor, taking the client with it.
		//
		//  So the name governs BINDING as well as callback lookup, and the series
		//  stops at two. A third grid is unreachable by any spelling.
		//
		//  TWO GRIDS IS NOT TWO SLOTS, WHICH IS WHAT MAKES THIS WORKABLE. A grid
		//  spans `dimensions` worth of slots from `slotOffset`, so the real
		//  constraint is TWO INDEPENDENTLY POSITIONED GROUPS -- and three slots in
		//  two groups means exactly one pair has to sit adjacent.
		//
		//  IN AND OUT ARE THE PAIR, DELIBERATELY. They are a sequence and read as
		//  one; the reagent slot is a modifier on that sequence and has no business
		//  looking like its third step. Pairing out with reagent instead would put
		//  the two slots that have nothing to do with each other side by side.
		//
		//  If a layout ever needs three separate groups, the route is itemslot
		//  widgets as proxies over one container -- the mech assembly station's
		//  pattern. That is a real answer and a much larger one; see the notes on
		//  the petport panel.
		"itemGrid" : {
			"type" : "itemgrid",
			"position" : [ 180, 212 ],
			"dimensions" : [ 2, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		//  SET APART FROM THE IN/OUT PAIR. Reserved for a brewing-style reagent,
		//  unused in V1, and positioned so it never reads as the third step of the
		//  conversion beside it.
		"itemGrid2" : {
			"type" : "itemgrid",
			"slotOffset" : 2,
			"position" : [ 304, 212 ],
			"dimensions" : [ 1, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		"inputSlotLabel" : {
			"type" : "label",
			"position" : [ 182, 202 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "in",
			"mouseTransparent" : true
		},

		"outputSlotLabel" : {
			"type" : "label",
			"position" : [ 200, 202 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "out",
			"mouseTransparent" : true
		},

		"reagentSlotLabel" : {
			"type" : "label",
			"position" : [ 304, 202 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "n/a",
			"mouseTransparent" : true
		},

		//  PROGRESS TOWARD THE NEXT PET TREAT.
		//
		//  A sheet of 21 frames swapped by widget.setImage, not a `progress`
		//  widget type. See progressbar.frames: an unknown widget type fails at
		//  construction and takes the pane -- or the client -- with it, which this
		//  pane has now done three times for three different reasons. A bad image
		//  path renders a red placeholder and says so in the log, which is a
		//  failure that can be read and corrected.
		//
		//  Sits under the in/out pair it describes, and clear of the reagent slot.
		"progressBar" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/progressbar.png:p0",
			"position" : [ 176, 186 ]
		},

		"progressLabel" : {
			"type" : "label",
			"position" : [ 176, 176 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- the rule editor ----------------------------------------------
		//
		//  A SAMPLE SLOT, NOT AN INPUT. The player puts an item on the cursor
		//  and clicks; the pane reads the NAME and hands the item straight back.
		//  Nothing is ever consumed, and the slot is always empty.
		//
		//  That is the whole reason rules are per-name: naming an item by
		//  SHOWING it needs no typing, no autocomplete and no vocabulary, and it
		//  works for modded items the manifest has never heard of. Copied from
		//  restockconfig, which does the same thing for the same reason.
		//
		//  ONE FIELD, NOT TWO. A restock request has a min and a max because it
		//  is a range to maintain. An upcycler rule is one number: keep this
		//  many, convert the rest. Zero is meaningful and is the "I never want
		//  any of these" case.

		"editorLabel" : {
			"type" : "label",
			"position" : [ 172, 106 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Add a rule",
			"mouseTransparent" : true
		},

		//  AN ITEMSLOT DRAWS NO EMPTY FRAME OF ITS OWN, so without this the slot
		//  is an invisible hit area. Same backing the restock pane uses; it
		//  should move to shared/ when something else wants it.
		"slotBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/slot_backing.png",
			"position" : [ 174, 78 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		"itemSlot_sample" : {
			"type" : "itemslot",
			"zlevel" : 2,
			"position" : [ 174, 78 ],
			"callback" : "sampleSlotClicked",
			"rightClickCallback" : "sampleSlotCleared"
		},

		"sampleHint" : {
			"type" : "label",
			"position" : [ 196, 86 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Click holding an item",
			"mouseTransparent" : true
		},

		"thresholdLabel" : {
			"type" : "label",
			"position" : [ 196, 72 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Keep at most",
			"mouseTransparent" : true
		},

		"thresholdBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 268, 68 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		//  REGEX-CONSTRAINED TO DIGITS, so the field cannot hold something
		//  tonumber would reject. Seven of them, because a network can plausibly
		//  hold a million blocks and a ceiling that silently truncates would be
		//  worse than one nobody reaches.
		"tbThreshold" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 270, 72 ],
			"textAlign" : "center",
			"maxWidth" : 38,
			"regex" : "\\d{0,7}",
			"hint" : "",
			"callback" : "thresholdChanged"
		},

		//  ---- the warning ---------------------------------------------------
		//
		//  A GLYPH, NOT A SENTENCE. Refusals used to be prose in lblStatus,
		//  which reads as status rather than as something being wrong. The
		//  triangle is the one symbol every player already knows, and it sits
		//  next to the slots it is complaining about.
		//
		//  BOTH WIDGETS ARE HIDDEN UNLESS THERE IS SOMETHING TO SAY. A warning
		//  area that is always present but usually blank trains people to stop
		//  looking at it.
		//
		//  Provisional placement. The mockup puts this between the input slot
		//  and the progress bar, which the current two-grid layout has no room
		//  for -- that arrives with the itemslot proxies, when the slots stop
		//  being locked to a 19px pitch.
		"warnIcon" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/warning.png",
			"position" : [ 176, 148 ],
			"visible" : false,
			"mouseTransparent" : true
		},

		"warnText" : {
			"type" : "label",
			"position" : [ 196, 156 ],
			"fontSize" : 7,
			"color" : [ 240, 200, 40 ],
			"wrapWidth" : 135,
			"value" : "",
			"visible" : false,
			"mouseTransparent" : true
		},

		//  Live readout, re-derived every tick by refreshStatus. Reports the
		//  refusal case in words, because "nothing is happening" and "nothing is
		//  happening because you have not said I may" are the same picture from
		//  outside the machine.
		//
		//  POSITIONED LOW BECAUSE A WRAPPED LABEL GROWS UPWARD. Its overflow
		//  lines render ABOVE the anchor -- the same behaviour that made rule
		//  rows bleed into the row above them -- so an anchor near the slots
		//  would put four lines of refusal text through them.
		"lblStatus" : {
			"type" : "label",
			"position" : [ 172, 120 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"wrapWidth" : 155,
			"value" : "",
			"mouseTransparent" : true
		}
	},

	"scripts" : [ "/interface/lofty_petports/upcyclerconfig/upcyclerconfig.lua" ],
	"scriptDelta" : 5,

	//  PANE-LEVEL WIDGETS ONLY. Row callbacks are registered at runtime and must
	//  not appear here -- see the header.
	//
	//  NO GRID CALLBACKS HERE ANY MORE. `itemGrid` is one of the two names
	//  ContainerPane registers itself, along with `itemGrid.right`, so it needs
	//  nothing from the script. A grid the script has to supply callbacks for
	//  needs BOTH a callback and a rightClickCallback named explicitly -- the
	//  latter defaults to "<callback>.right", and a dotted name is unreachable
	//  as a Lua global. Moot now, and recorded so it is not rediscovered.
	"scriptWidgetCallbacks" : [
		"enabledToggled",
		"ruleSelected",
		"sampleSlotClicked",
		"sampleSlotCleared",
		"thresholdChanged"
	]
}
