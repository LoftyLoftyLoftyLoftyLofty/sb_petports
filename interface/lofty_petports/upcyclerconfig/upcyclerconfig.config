//  PETPORTS -- UPCYCLER PANE
//
//  A CONTAINER PANE WITH A SCRIPT, WHICH IS A THIRD THING.
//
//  This is neither a ScriptPane nor a plain chest interface. A container
//  object's `uiConfig` can carry `scripts`, `scriptDelta` and
//  `scriptWidgetCallbacks` alongside its `gui`, and vanilla's cropshipper
//  proves it: /interface/scripted/cropshipper/cropshippergui.config is a
//  40-slot container whose pane runs Lua, reads its grids with
//  widget.itemGridItems, and messages its object via pane.containerEntityId().
//
//  That collapses the whole ScriptPane-versus-container question. We get real
//  container slots AND arbitrary widgets in one window.
//
//  CONSEQUENCE WORTH STATING: NO TOKEN SYSTEM HERE.
//
//  beaconconfig needs one because a ScriptPane addressing a HELD activeitem
//  cannot tell which hotbar slot it is talking to, so a player swapping slots
//  mid-edit could retarget a write. This pane addresses an entity id. There is
//  exactly one upcycler on the other end and it cannot change.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT of the footer, and the usable band is
//  y 25..249 -- header 25 + body 224 + footer 25. A widget outside that is not
//  an error, it is simply drawn over the frame or not drawn at all.
//
//  FRAME AND ROW ART ARE BORROWED FROM THE BEACON PANE, deliberately. Both are
//  already spliced to size and already the right width; generating a second
//  set for a skeleton would be art work spent on something that may move.
//
//  INTERACTIVE WIDGETS INSIDE LIST ROWS -- registerMemberCallback ONLY.
//
//  A row widget naming a callback from scriptWidgetCallbacks CANNOT be built:
//  ListWidget constructs its rows with a different parser that has never heard
//  of them, and addListItem throws at CONSTRUCTION rather than at click, which
//  means the pane does not open at all. Row callbacks are registered at runtime
//  with widget.registerMemberCallback, BEFORE the first addListItem. So
//  `ruleRowRemove` appears here and in the script's registration call, and
//  deliberately NOT in scriptWidgetCallbacks below.
//
//  The callback receives (memberLeafName, widgetData). Arg 1 is the leaf name
//  only and is identical for every row, so only arg 2 can identify which row
//  fired -- which is why refreshRules calls widget.setData on every row.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/upcyclerconfig/panewider_header.png",
			"fileBody" : "/interface/lofty_petports/upcyclerconfig/panewider_body.png",
			"fileFooter" : "/interface/lofty_petports/upcyclerconfig/panewider_footer.png"
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"pressedOffset" : [ 0, 0 ],
			"position" : [ 505, 350 ],
			"zlevel" : 1
		},

		//  ---- window title ---------------------------------------------------
		//
		//  THESE STRINGS ONLY SURVIVE BECAUSE THE OBJECT HAS NO `category`.
		//
		//  ContainerPane overwrites a title widget's title and subtitle from the
		//  object's `shortdescription` and `category`, and it finds the widget by
		//  TYPE -- renaming this to "windowtitle" was tested in game and changed
		//  nothing. So did "titleFromEntity" : false, which is a CraftingPane key
		//  that ContainerPane does not read; it has been removed rather than left
		//  here looking load-bearing.
		//
		//  What DOES work is the object declaring no category at all, which is
		//  what vanilla's FTL fuel hatch does. Its pane says "FTL Drive Fuel
		//  Hatch" while the object says "FTL Fuel Hatch", and the PANE's version
		//  is what renders. See the comment in petports_upcycler.object.
		//
		//  CONSEQUENCE FOR ANYONE EDITING EITHER FILE: putting a category back on
		//  the object silently reverts this subtitle to a category label. The two
		//  files are coupled and neither of them can express that on its own.
		//
		//  THE ICON IS THIS WIDGET'S because the object sets hasWindowIcon false.
		//  Without that, ContainerPane draws its own from `inventoryIcon` and this
		//  block is decoration. Both currently point at the same file, so the
		//  only way to tell them apart is that flag.
		//
		//  Leading spaces indent the text out from under the icon, which is drawn
		//  inside this widget's own box. Vanilla does the same rather than
		//  offsetting the label.

		"windowtitle" : {
			"type" : "title",
			"title" : "  Upcycling",
			"subtitle" : "  ^#b9b5b2;Convert unused items into treats for your pets!",
			"position" : [ -3, 80 ],
			"icon" : {
				"type" : "image",
				"file" : "/objects/lofty_petports/upcycler/petports_upcyclericon.png",
				"position" : [ 0, -20 ],
				"zlevel" : -1
			}
		},

		//  ---- machine on/off ------------------------------------------------
		//
		//  UNCHECKED ON A FRESHLY PLACED MACHINE, ALWAYS. The object stores no
		//  `enabled` parameter until this box is ticked, and absence means off.
		//  `checked` below is the pre-script default only; init overwrites it
		//  from the real state before the player sees it.

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 10, 320 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 322 ],
			"value" : "Upcycler running",
			"mouseTransparent" : true
		},

		//  ---- the rule list -------------------------------------------------
		//
		//  ORDER IS NOT SYNTAX HERE, unlike the beacon filter. Each rule names
		//  one item and one threshold and they do not interact, so there is no
		//  last-match-wins to explain and nothing to reorder.

		//  ---- tabs, lower right ------------------------------------------------
		//
		//  THE LOWER RIGHT QUADRANT IS THE TAB ZONE, per the mockup. Rules stay
		//  on the left and the schematic stays top right; only this quadrant
		//  changes when a tab is clicked. The first build put the tabs over the
		//  left column because the old 337x274 pane had nowhere else to put
		//  them, and it fought the layout it was meant to serve.
		//
		//  TWO CHECKABLE BUTTONS, NOT A radioGroup, AND ONLY FOR NOW. vanilla's
		//  convention is a radioGroup with toggleMode false and tab-shaped
		//  images -- see fossilstation.config. A radioGroup button takes an
		//  IMAGE, so that needs tab art which does not exist yet. Captioned
		//  buttons need none and test the same thing.
		//
		//  Both call showTab(), which is exactly what a radioGroup callback
		//  would call, so the swap is the button config and nothing else.

		"tabInstructions" : {
			"type" : "button",
			"base" : "/interface/button.png",
			"hover" : "/interface/buttonhover.png",
			"baseImageChecked" : "/interface/buttonactive.png",
			"hoverImageChecked" : "/interface/buttonactivehover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 192, 226 ],
			"caption" : "How it works",
			"callback" : "tabInstructionsClicked"
		},

		"tabFlavors" : {
			"type" : "button",
			"base" : "/interface/button.png",
			"hover" : "/interface/buttonhover.png",
			"baseImageChecked" : "/interface/buttonactive.png",
			"hoverImageChecked" : "/interface/buttonactivehover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 286, 226 ],
			"caption" : "Flavors",
			"callback" : "tabFlavorsClicked"
		},

		//  ---- how it works tab --------------------------------------------------
		//
		//  THE DEFAULT TAB, so a player opening the machine cold lands on the
		//  explanation rather than on a wall of icons. Placeholder copy.

		//  POSITION IS THE BOTTOM OF THE TEXT BLOCK, NOT THE TOP.
		//
		//  A wrapped label grows UPWARD. At [194, 206] this paragraph occupied
		//  roughly y 206..253 and ran straight through the tab buttons at 226 --
		//  visible in game as the tabs sitting between line two and line three.
		//
		//  So the number below is where the LAST line sits, and the ceiling is
		//  the panel top at 218. Five lines at this size is about 55px, which is
		//  what 158 leaves room for.
		//
		//  ADDING A SENTENCE PUSHES THE TOP UP, NOT THE BOTTOM DOWN. This will
		//  collide with the tabs again the moment the copy grows past five lines,
		//  and nothing will warn about it -- the text simply draws over them.
		"instructionsText" : {
			"type" : "label",
			"position" : [ 194, 158 ],
			"hAnchor" : "left",
			"fontSize" : 8,
			"wrapWidth" : 322,
			"value" : "Drop an item on the slot to the left to add a rule. Anything above that rule's threshold is converted into Pet Treats.\n\nPut a reagent in the reagent slot to flavor what it makes. See the Flavors tab for what makes what."
		},

		//  ---- flavors tab -------------------------------------------------------
		//
		//  A PICKER BESIDE A GRID, which is the beacon pane's shape rather than a
		//  new one. That pane already solved this at worse odds -- 19 groups and
		//  177 subgroups -- so reusing it means reusing code that has been through
		//  the row-callback traps rather than meeting them again.

		"flavorsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 192, 36, 348, 218 ],
			"visible" : false,
			"children" : {
				"flavorsList" : {
					"type" : "list",

					//  NULLED BECAUSE THE ROWS ARE BUTTONS. A row button and a
					//  list callback BOTH fire on one click, so one of them has
					//  to be dead or every selection is handled twice. The rows
					//  win because a button is what gives them a hover state --
					//  a list has no hover callback at all.
					"callback" : "null",
					"schema" : {
						//  Vestigial in vanilla and doing nothing here. Row art
						//  lives in listTemplate and is repainted from Lua.
						"selectedBG" : "",
						"unselectedBG" : "",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 144, 16 ],
						"listTemplate" : {
							//  SELECTION LIVES HERE, repainted in place by
							//  paintFlavorRows. Rebuilding to show a selection
							//  would call clearListItems, which invokes the
							//  list's own callback -- the repaint would fire the
							//  thing that asked for it.
							"rowBG" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_144.png",
								"position" : [ 0, 0 ],
								"zlevel" : -2,
								"mouseTransparent" : true
							},

							//  HOVER LIVES HERE, because a button has a hover
							//  image and a list row does not. Transparent base so
							//  the rowBG underneath shows through.
							"rowButton" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/shared/row_144_clear.png",
								"hover" : "/interface/lofty_petports/shared/row_144_hover.png",
								"position" : [ 0, 0 ],
								"zlevel" : -1,
								"callback" : "flavorRowClicked"
							},

							//  THE FLAVOR'S OWN TREAT, which is its identity and
							//  already named by `item` in petports_flavors.config.
							//  The treat colours were spread across lightness as
							//  well as hue precisely so seven of them stay
							//  distinguishable in a row like this.
							//  ITS OWN CALLBACK, NOT mouseTransparent.
							//
							//  mouseTransparent was tried and is the worst of both:
							//  the itemslot's automatic hover tooltip goes away AND
							//  the click still does nothing. A slot appears to
							//  swallow input rather than pass it through.
							//
							//  So the icon gets a real member callback, registered
							//  at runtime like every other row widget, and keeps
							//  its tooltip. It selects the same row the button
							//  would -- the icon is the biggest, brightest thing
							//  in the row and doing nothing was never an option.
							//  AN IMAGE, NOT AN ITEMSLOT, AND THAT IS THE WHOLE FIX.
							//
							//  A slot is not a button. It has no hover art, no
							//  depressed state and no click sound, so clicking the
							//  icon selected the row while giving none of the
							//  feedback that clicking two pixels to the right did.
							//  Three earlier attempts each fixed one third of it:
							//
							//    callback "null"       tooltip, no click
							//    mouseTransparent      no tooltip, no click
							//    real member callback  click, but still silent
							//                          and with no press state
							//
							//  None of them could work. The feedback belongs to
							//  the BUTTON, and the slot was sitting on top of it.
							//
							//  An image can be mouseTransparent for real, so every
							//  pixel of the row is the button: hover art, depress,
							//  sound and selection, with no per-widget wiring.
							//
							//  The cost is the itemslot's automatic tooltip, which
							//  is no loss -- createTooltip now covers the whole row
							//  and can say more than an item name.
							//
							//  The image is set from Lua; a treat's icon path comes
							//  from root.itemConfig, so a modded flavor works too.
							"icon" : {
								"type" : "image",
								"position" : [ 1, 0 ],
								"file" : "",
								"mouseTransparent" : true
							},

							"rowLabel" : {
								"type" : "label",
								"position" : [ 22, 4 ],
								"hAnchor" : "left",
								"fontSize" : 8,
								"wrapWidth" : 118,
								"value" : "Replace Me",
								"mouseTransparent" : true
							}
						}
					}
				}
			}
		},

		"reagentsLabel" : {
			"type" : "label",
			"position" : [ 358, 208 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Select a flavor",
			"mouseTransparent" : true,
			"visible" : false
		},

		"reagentsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 356, 36, 519, 204 ],
			"visible" : false,
			"children" : {
				"reagentsList" : {
					"type" : "list",
					"callback" : "null",

					//  FIVE COLUMNS, THE SAME ARITHMETIC AS THE BEACON PANE. The
					//  rect is 163 wide and the scrollbar takes about 5, leaving
					//  158. Five 26px cells plus four 2px gaps is 138. Six would
					//  be 164 and the last column would draw under the bar.
					"columns" : 5,
					"fillDown" : true,
					"schema" : {
						"selectedBG" : "",
						"unselectedBG" : "",
						"spacing" : [ 2, 2 ],
						"memberSize" : [ 26, 26 ],
						"listTemplate" : {
							//  An itemslot inside a list row is legal and vanilla
							//  does it -- fossilstation's itemList carries one --
							//  but ONLY with "callback" : "null". A row widget
							//  naming a scriptWidgetCallbacks entry throws at
							//  CONSTRUCTION and takes the pane with it.
							"icon" : {
								"type" : "itemslot",
								"position" : [ 5, 9 ],
								"callback" : "null"
							},

							//  Placeholder for the blip strip. A bare number here
							//  is a BAD convention to ship: players read a count
							//  beside an item as an input cost, which is the exact
							//  inverse of what a weight means. Text only until the
							//  9-frame blip sheet exists.
							"weight" : {
								"type" : "label",
								"position" : [ 13, 0 ],
								"hAnchor" : "mid",
								"fontSize" : 7,
								"color" : [ 160, 160, 160 ],
								"value" : ""
							}
						}
					}
				}
			}
		},

		"rulesLabel" : {
			"type" : "label",
			"position" : [ 10, 302 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Upcycle above this many",
			"mouseTransparent" : true
		},

		"rulesScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 170, 180, 300 ],
			"children" : {
				"rulesList" : {
					"type" : "list",

					//  SELECTION IS LIVE HERE, unlike the beacon pane's group
					//  picker. Picking a rule loads its threshold into the field
					//  below, so the list is a selection rather than a menu of
					//  actions.
					//
					//  A row button does NOT swallow the click -- measured on
					//  the beacon pane, where both fired on one press. The only
					//  button in these rows is the X, and a click that both
					//  selects and deletes is harmless because the delete
					//  rebuilds the list and drops the selection anyway.
					"callback" : "ruleSelected",
					"schema" : {
						"selectedBG" : "/interface/lofty_petports/shared/row_144_selected.png",
						"unselectedBG" : "/interface/lofty_petports/shared/row_144.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 144, 16 ],
						"listTemplate" : {
							"rowBG" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_144.png",
								"position" : [ 0, 0 ],
								"zlevel" : -2,
								"mouseTransparent" : true
							},

							//  NO wrapWidth. A wrapped label in a 16px row
							//  renders its overflow ABOVE the anchor, which
							//  reads as stray pixels bleeding into the row
							//  above. Labels are shortened at the source
							//  instead.
							//  HOVER ART, AND NOTHING ELSE.
							//
							//  A list has no hover callback, so hover states have
							//  to come from a button. This one does not handle the
							//  click: "null" is a name the row parser knows, so it
							//  constructs and does nothing, and the LIST's own
							//  callback still fires -- a row button and a list
							//  callback both fire on one click, which is normally
							//  the trap and is exactly what is wanted here.
							//
							//  Deliberately different from the flavors list, which
							//  routes the click through its button because its
							//  ICON needs a callback too. Rules have no icon.
							//
							//  zlevel -1 keeps it under rowRemove, so the X still
							//  takes its own clicks.
							"rowHover" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/shared/row_144_clear.png",
								"hover" : "/interface/lofty_petports/shared/row_144_hover.png",
								"position" : [ 0, 0 ],
								"zlevel" : -1,
								"callback" : "null"
							},

							"ruleText" : {
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"value" : "",
								"mouseTransparent" : true
							},

							"rowRemove" : {
								"type" : "button",
								"base" : "/interface/x.png",
								"hover" : "/interface/xhover.png",
								"pressed" : "/interface/xpress.png",
								"position" : [ 131, 3 ],
								"callback" : "ruleRowRemove"
							}
						}
					}
				}
			}
		},

		//  TWO GRIDS. THAT IS THE HARD LIMIT, AND IT IS NOW MEASURED FROM BOTH
		//  SIDES.
		//
		//  ContainerPane registers callbacks for `itemGrid` and `itemGrid2` and
		//  binds those two grids to the container's item bag. Nothing else:
		//
		//    `reagentGrid`, WITH callbacks supplied -> constructed fine, drew zero
		//    slots, said nothing in the log.
		//
		//    `itemGrid3`, with none -> (WidgetParserException) Failed to find
		//    itemgrid callback named: 'itemGrid3', out of ContainerPane's
		//    constructor, taking the client with it.
		//
		//  So the name governs BINDING as well as callback lookup, and the series
		//  stops at two. A third grid is unreachable by any spelling.
		//
		//  TWO GRIDS IS NOT TWO SLOTS, WHICH IS WHAT MAKES THIS WORKABLE. A grid
		//  spans `dimensions` worth of slots from `slotOffset`, so the real
		//  constraint is TWO INDEPENDENTLY POSITIONED GROUPS -- and three slots in
		//  two groups means exactly one pair has to sit adjacent.
		//
		//  IN AND OUT ARE THE PAIR, DELIBERATELY. They are a sequence and read as
		//  one; the reagent slot is a modifier on that sequence and has no business
		//  looking like its third step. Pairing out with reagent instead would put
		//  the two slots that have nothing to do with each other side by side.
		//
		//  If a layout ever needs three separate groups, the route is itemslot
		//  widgets as proxies over one container -- the mech assembly station's
		//  pattern. That is a real answer and a much larger one; see the notes on
		//  the petport panel.
		"itemGrid" : {
			"type" : "itemgrid",
			"position" : [ 206, 300 ],
			//  INPUT AND OUTPUT, SIDE BY SIDE ON A 19px PITCH.
			//
			//  Proxy itemslots were tried so the two could be placed
			//  independently and were rolled back: splitting the grid changed
			//  how the container was bound and the machine misbehaved. If they
			//  are attempted again, the grid must STAY and the proxy sit over
			//  it -- removing the binding is what broke.
			//
			//  To move these two relative to each other without a proxy,
			//  `spacing` is the pitch between cells and `dimensions` can be
			//  [ 1, 2 ] to stack them vertically.
			"dimensions" : [ 2, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		//  SET APART FROM THE IN/OUT PAIR. Reserved for a brewing-style reagent,
		//  unused in V1, and positioned so it never reads as the third step of the
		//  conversion beside it.
		"itemGrid2" : {
			"type" : "itemgrid",
			"slotOffset" : 2,
			"position" : [ 440, 300 ],
			"dimensions" : [ 1, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		"inputSlotLabel" : {
			"type" : "label",
			"position" : [ 208, 290 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "in",
			"mouseTransparent" : true
		},

		"outputSlotLabel" : {
			"type" : "label",
			"position" : [ 226, 290 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "out",
			"mouseTransparent" : true
		},

		//  ---- reagent charge --------------------------------------------------
		//
		//  Eight cells, one per treat the charge will pay out, tinted with the
		//  flavor that is queued for it. Drawn LEFT TO RIGHT IN PAYOUT ORDER, so
		//  a charge of two spicy then six sweet reads the way it will come out.
		//
		//  ONE SPRITE, TINTED, NOT EIGHT SPRITES. blip.png is white inside a
		//  black outline: "?multiply=" leaves black alone and turns white into
		//  the tint exactly, which is the same trick the crosshairs use. A
		//  flavor's colour comes from `color` in petports_flavors.config, so a
		//  modded flavor gets a blip colour without this file knowing about it.
		//
		//  PLAIN IMAGES, NOT A LIST. Eight widgets that only ever change their
		//  tint cost one setImage each and cannot strobe -- addListItem repaints
		//  the whole container, which is what rules lists out for anything that
		//  updates while the player watches.
		//
		//  6px sprite on a 7px pitch: one pixel between cells so a run of the
		//  same flavor still reads as separate blips rather than a bar.
		//
		//  THE DARKENED TINT IS DECLARED HERE, NOT LEFT TO THE FIRST REPAINT.
		//  Without it every blip drew WHITE for the frame between the pane
		//  opening and the first state poll coming back -- a visible flash of
		//  eight white cells on every open. The Lua uses the same value; if one
		//  is ever changed the other has to move with it.

		"blip1" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 440, 318 ],
			"mouseTransparent" : true
		},

		"blip2" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 447, 318 ],
			"mouseTransparent" : true
		},

		"blip3" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 454, 318 ],
			"mouseTransparent" : true
		},

		"blip4" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 461, 318 ],
			"mouseTransparent" : true
		},

		"blip5" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 468, 318 ],
			"mouseTransparent" : true
		},

		"blip6" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 475, 318 ],
			"mouseTransparent" : true
		},

		"blip7" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 482, 318 ],
			"mouseTransparent" : true
		},

		"blip8" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/blip.png?multiply=2a2a2aff",
			"position" : [ 489, 318 ],
			"mouseTransparent" : true
		},

		//  DISCARD THE CHARGE.
		//
		//  Sits past the last blip rather than beside the slot, so it reads as
		//  belonging to the bar it empties instead of to the item slot above it.
		//
		//  DESTRUCTIVE WITH NO CONFIRM, which is a deliberate call and not an
		//  oversight. The worst case is eight treats coming out unflavored --
		//  recoverable by putting another reagent in, and cheap next to the
		//  alternative of a confirm step on a button most players will use once.
		//  The tooltip says what it does before they press it.
		"btnClearCharge" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"pressedOffset" : [ 0, 0 ],
			"position" : [ 499, 317 ],
			"callback" : "clearChargeClicked"
		},

		"reagentSlotLabel" : {
			"type" : "label",
			"position" : [ 440, 290 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "n/a",
			"mouseTransparent" : true
		},

		//  PROGRESS TOWARD THE NEXT PET TREAT.
		//
		//  A sheet of 21 frames swapped by widget.setImage, not a `progress`
		//  widget type. See progressbar.frames: an unknown widget type fails at
		//  construction and takes the pane -- or the client -- with it, which this
		//  pane has now done three times for three different reasons. A bad image
		//  path renders a red placeholder and says so in the log, which is a
		//  failure that can be read and corrected.
		//
		//  Sits under the in/out pair it describes, and clear of the reagent slot.
		"progressBar" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/progressbar.png:p0",
			"position" : [ 202, 266 ]
		},

		"progressLabel" : {
			"type" : "label",
			"position" : [ 202, 256 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- the rule editor ----------------------------------------------
		//
		//  A SAMPLE SLOT, NOT AN INPUT. The player puts an item on the cursor
		//  and clicks; the pane reads the NAME and hands the item straight back.
		//  Nothing is ever consumed, and the slot is always empty.
		//
		//  That is the whole reason rules are per-name: naming an item by
		//  SHOWING it needs no typing, no autocomplete and no vocabulary, and it
		//  works for modded items the manifest has never heard of. Copied from
		//  restockconfig, which does the same thing for the same reason.
		//
		//  ONE FIELD, NOT TWO. A restock request has a min and a max because it
		//  is a range to maintain. An upcycler rule is one number: keep this
		//  many, convert the rest. Zero is meaningful and is the "I never want
		//  any of these" case.

		"editorLabel" : {
			"type" : "label",
			"position" : [ 10, 156 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Add a rule",
			"mouseTransparent" : true
		},

		//  AN ITEMSLOT DRAWS NO EMPTY FRAME OF ITS OWN, so without this the slot
		//  is an invisible hit area. Same backing the restock pane uses; it
		//  should move to shared/ when something else wants it.
		"slotBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/slot_backing.png",
			"position" : [ 10, 128 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		"itemSlot_sample" : {
			"type" : "itemslot",
			"zlevel" : 2,
			"position" : [ 10, 128 ],
			"callback" : "sampleSlotClicked",
			"rightClickCallback" : "sampleSlotCleared"
		},

		"sampleHint" : {
			"type" : "label",
			"position" : [ 34, 144 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Click holding an item",
			"mouseTransparent" : true
		},

		"thresholdLabel" : {
			"type" : "label",
			"position" : [ 10, 108 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Keep at most",
			"mouseTransparent" : true
		},

		"thresholdBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 114, 104 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		//  REGEX-CONSTRAINED TO DIGITS, so the field cannot hold something
		//  tonumber would reject. Seven of them, because a network can plausibly
		//  hold a million blocks and a ceiling that silently truncates would be
		//  worse than one nobody reaches.
		"tbThreshold" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 116, 108 ],
			"textAlign" : "center",
			"maxWidth" : 38,
			"regex" : "\\d{0,7}",
			"hint" : "",
			"callback" : "thresholdChanged"
		},

		//  ---- the warning ---------------------------------------------------
		//
		//  A GLYPH, NOT A SENTENCE. Refusals used to be prose in lblStatus,
		//  which reads as status rather than as something being wrong. The
		//  triangle is the one symbol every player already knows, and it sits
		//  next to the slots it is complaining about.
		//
		//  BOTH WIDGETS ARE HIDDEN UNLESS THERE IS SOMETHING TO SAY. A warning
		//  area that is always present but usually blank trains people to stop
		//  looking at it.
		//
		//  Provisional placement. The mockup puts this between the input slot
		//  and the progress bar, which the current two-grid layout has no room
		//  for -- that arrives with the itemslot proxies, when the slots stop
		//  being locked to a 19px pitch.
		"warnIcon" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/upcyclerconfig/warning.png",
			"position" : [ 10, 46 ],
			"visible" : false,
			"mouseTransparent" : true
		},

		"warnText" : {
			"type" : "label",
			"position" : [ 32, 58 ],
			"fontSize" : 7,
			"color" : [ 240, 200, 40 ],
			"wrapWidth" : 135,
			"value" : "",
			"visible" : false,
			"mouseTransparent" : true
		},

		//  Live readout, re-derived every tick by refreshStatus. Reports the
		//  refusal case in words, because "nothing is happening" and "nothing is
		//  happening because you have not said I may" are the same picture from
		//  outside the machine.
		//
		//  POSITIONED LOW BECAUSE A WRAPPED LABEL GROWS UPWARD. Its overflow
		//  lines render ABOVE the anchor -- the same behaviour that made rule
		//  rows bleed into the row above them -- so an anchor near the slots
		//  would put four lines of refusal text through them.
		"lblStatus" : {
			"type" : "label",
			"position" : [ 10, 84 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"wrapWidth" : 155,
			"value" : "",
			"mouseTransparent" : true
		}
	},

	//  HOVER TEXT FOR THE REAGENT CELLS.
	//
	//  createTooltip reads this with config.getParameter and fills in the two
	//  labels. Without it that function returns nil and the cells are silently
	//  mute -- no error, no log line, just no tooltip.
	//
	//  BORROWED FROM THE BEACON PANE, art included, because the two are the same
	//  size and the same job. It should move to shared/ when a third pane wants
	//  it; that is a file move, not a rewrite.
	//
	//  124x30, sized to a name over one line of state. wrapWidth sits just
	//  inside the frame so a long item name clips rather than escaping it.
	"tooltipLayout" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "",
			"fileBody" : "/interface/lofty_petports/beaconconfig/tooltip_body.png",
			"fileFooter" : ""
		},
		"title" : {
			"type" : "label",
			"position" : [ 6, 20 ],
			"hAnchor" : "left",
			"wrapWidth" : 112
		},
		"description" : {
			"type" : "label",
			"position" : [ 6, 8 ],
			"hAnchor" : "left",
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"wrapWidth" : 112
		}
	},

	"scripts" : [ "/interface/lofty_petports/upcyclerconfig/upcyclerconfig.lua" ],
	"scriptDelta" : 5,

	//  PANE-LEVEL WIDGETS ONLY. Row callbacks are registered at runtime and must
	//  not appear here -- see the header.
	//
	//  NO GRID CALLBACKS HERE ANY MORE. `itemGrid` is one of the two names
	//  ContainerPane registers itself, along with `itemGrid.right`, so it needs
	//  nothing from the script. A grid the script has to supply callbacks for
	//  needs BOTH a callback and a rightClickCallback named explicitly -- the
	//  latter defaults to "<callback>.right", and a dotted name is unreachable
	//  as a Lua global. Moot now, and recorded so it is not rediscovered.
	"scriptWidgetCallbacks" : [
		"tabInstructionsClicked", "tabFlavorsClicked", "clearChargeClicked",
		"enabledToggled",
		"ruleSelected",
		"sampleSlotClicked",
		"sampleSlotCleared",
		"thresholdChanged"
	]
}
