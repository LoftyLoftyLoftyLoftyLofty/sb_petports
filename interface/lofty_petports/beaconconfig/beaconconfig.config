//  PETPORTS -- BEACON CONFIGURATION PANE
//
//  Opened by petports_beacon.lua via activeItem.interact("ScriptPane", <this>).
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT, and pane size comes from the
//  background images -- the chest frame is roughly 160 wide by 265 tall, so
//  everything below is laid out within that. A widget positioned outside it
//  does not error, it simply is not drawn.
//
//  ASSET PATHS ARE VERIFIED AGAINST THE LOG, NOT REMEMBERED. An earlier pass
//  guessed five wrong. A missing pane image does NOT stop the pane building --
//  it renders a red placeholder and writes "Could not load image asset" -- so a
//  pane that looks broken and a pane that failed to open are different symptoms
//  with different causes. Check for AssetException before touching structure.
//
//  NO INTERACTIVE WIDGETS INSIDE LIST ROWS.
//
//  Whether a button in a listTemplate fires its callback is undocumented, and
//  the vanilla crafting list sets "callback" : "null" on its slot rather than
//  relying on it. So a row is inert: the player SELECTS a row, and buttons
//  outside the list act on the selection. Only documented behaviour.
//
//  NO REORDER BUTTONS IN V1.
//
//  Rules append to the bottom and can be removed; reordering is delete and
//  re-add. Order still decides everything -- last match wins -- and add/remove
//  can build any list. Two fewer buttons needing art that does not exist yet.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/chests/chestheader.png",
			"fileBody" : "/interface/chests/chestbody.png",
			"fileFooter" : "/interface/chests/chestfooter.png"
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"position" : [ 152, 89 ],
			"zlevel" : 1
		},

		"title" : {
			"type" : "title",
			"title" : "Beacon",
			"subtitle" : "Deposit filter",
			"position" : [ -3, 80 ]
		},

		//  ---- beacon on/off -------------------------------------------------

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 222 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 224 ],
			"value" : "Beacon active",
			"mouseTransparent" : true
		},

		//  ---- base verdict --------------------------------------------------
		//
		//  Rule zero, with a fixed position. Checked means the filter starts by
		//  accepting everything and the rules below carve exceptions out of it;
		//  unchecked starts from nothing and the rules let things in.

		"baseCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 204 ],
			"callback" : "baseToggled"
		},

		"baseLabel" : {
			"type" : "label",
			"position" : [ 26, 206 ],
			"value" : "Accept everything",
			"mouseTransparent" : true
		},

		//  ---- the rule list -------------------------------------------------
		//
		//  Evaluated TOP TO BOTTOM, last match wins, so the bottom entry is the
		//  most specific thing the player said. The header says so out loud
		//  because this is the opposite of the firewall convention and someone
		//  who assumes first-match will write their exceptions in the wrong
		//  place and see nothing happen.

		"rulesLabel" : {
			"type" : "label",
			"position" : [ 10, 190 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Rules - lower entries win",
			"mouseTransparent" : true
		},

		"rulesScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 120, 152, 188 ],
			"children" : {
				"rulesList" : {
					"type" : "list",
					"callback" : "ruleSelected",
					"schema" : {
						"selectedBG" : "/interface/crafting/craftableselected2.png",
						"unselectedBG" : "/interface/crafting/craftablebackground.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 136, 16 ],
						"listTemplate" : {
							"ruleText" : {
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"wrapWidth" : 128,
								"value" : ""
							}
						}
					}
				}
			}
		},

		//  ---- acting on the selected rule -----------------------------------

		"actionCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 10, 102 ],
			"callback" : "actionToggled"
		},

		"actionLabel" : {
			"type" : "label",
			"position" : [ 26, 104 ],
			"value" : "Accept",
			"mouseTransparent" : true
		},

		"removeButton" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"position" : [ 138, 101 ],
			"callback" : "removeRule"
		},

		//  ---- the group picker ----------------------------------------------
		//
		//  Clicking a group APPENDS a rule for it. Appending rather than
		//  inserting keeps the list honest: the newest thing a player asked for
		//  is the most specific, which is exactly what last-match-wins means.

		"groupsLabel" : {
			"type" : "label",
			"position" : [ 10, 88 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Add a rule",
			"mouseTransparent" : true
		},

		"groupsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 18, 152, 86 ],
			"children" : {
				"groupsList" : {
					"type" : "list",
					"callback" : "groupPicked",
					"schema" : {
						"selectedBG" : "/interface/crafting/craftableselected2.png",
						"unselectedBG" : "/interface/crafting/craftablebackground.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 136, 16 ],
						"listTemplate" : {
							"groupText" : {
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"wrapWidth" : 128,
								"value" : ""
							}
						}
					}
				}
			}
		}
	},

	"scripts" : [ "/interface/lofty_petports/beaconconfig/beaconconfig.lua" ],
	"scriptDelta" : 1,

	//  Every callback named above must appear here or the widget silently does
	//  nothing when clicked.
	"scriptWidgetCallbacks" : [
		"enabledToggled",
		"baseToggled",
		"actionToggled",
		"removeRule",
		"ruleSelected",
		"groupPicked"
	]
}
