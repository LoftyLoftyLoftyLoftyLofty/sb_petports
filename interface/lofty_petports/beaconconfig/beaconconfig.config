//  PETPORTS -- BEACON CONFIGURATION PANE
//
//  Opened by petports_beacon.lua via activeItem.interact("ScriptPane", <this>).
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT, and pane size comes from the
//  background images. A widget positioned outside them does not error, it
//  simply is not drawn.
//
//  THE FRAME IS A WIDENED CHEST, GENERATED NOT DRAWN. Vanilla chestheader,
//  chestbody and chestfooter are 166 wide, which gave about 160 of usable
//  width -- enough for one column of widgets and nothing else, which is why
//  the picker and the subgroup grid used to take turns in one rect.
//
//  panewide_* are 337 wide, built by splicing the vanilla art rather than
//  stretching it. Header and footer are uniform across columns 20..139, so
//  they take repeats of a single column. The BODY repeats every 19px from
//  x=21, so it takes nine whole extra periods and the joins land exactly on
//  the pattern. Verified seamless: all 15 periods in the output are
//  byte-identical to the source period. The right edge slice carries the
//  drop shadow and is pasted last so it stays on the outside.
//
//  Usable width is now about 331. Redo the splice, do not scale, if this
//  ever needs to change again -- and grow it in whole 19px periods, or the
//  body pattern will not line up.
//
//  ASSET PATHS ARE VERIFIED AGAINST THE LOG, NOT REMEMBERED. An earlier pass
//  guessed five wrong. A missing pane image does NOT stop the pane building --
//  it renders a red placeholder and writes "Could not load image asset" -- so a
//  pane that looks broken and a pane that failed to open are different symptoms
//  with different causes. Check for AssetException before touching structure.
//
//  INTERACTIVE WIDGETS INSIDE LIST ROWS -- VIA registerMemberCallback ONLY.
//
//  A row button naming a callback from scriptWidgetCallbacks CANNOT be built.
//  Tested, and the engine throws at CONSTRUCTION, not at click:
//
//    ListWidget::addItem -> ListWidget::constructWidget
//      -> WidgetParser::constructImpl -> WidgetParser::buttonHandler
//      -> WidgetParserException: Failed to find callback named: ruleRowAction
//
//  scriptWidgetCallbacks are registered on the parser that builds the PANE.
//  ListWidget constructs its rows with a different parser that has never heard
//  of them, so addListItem throws and takes down whatever called it.
//
//  THE ROW CALLBACKS ARE REGISTERED AT RUNTIME INSTEAD:
//
//    widget.registerMemberCallback(listName, callbackName, function)
//
//  documented as "registers a member callback for a ListWidget's list items to
//  use", added in 1.3. It takes a Lua function directly rather than a name from
//  this file, so the names below appear HERE and in the registerMemberCallback
//  calls in beaconconfig.lua -- and deliberately NOT in scriptWidgetCallbacks,
//  which is for pane-level widgets and would be a second, wrong home for them.
//
//  ORDER MATTERS: registration must happen before the first addListItem, or
//  the parser hits the same missing-name path. init() registers before it
//  calls refreshRules for exactly this reason.
//
//  This is also how vanilla's crafting list puts a "NEW" badge and a count
//  inside one row, and why the collections list -- which wants no row
//  interaction at all -- writes "callback" : "null" instead.
//
//  THE CALLBACK IS HANDED (memberLeafName, widgetData). Measured:
//
//    ruleRowRemove fired with [1] string = rowRemove, [2] number = 1
//
//  So arg 1 is the LEAF name only -- "rowRemove", identical for every row --
//  and arg 2 is whatever widget.setData put on that member. Only arg 2 can
//  identify a row, which is why every row widget gets setData in
//  refreshRules and refreshSubgroups.
//
//  NO REORDER BUTTONS IN V1.
//
//  Rules append to the bottom and can be removed; reordering is delete and
//  re-add. Order still decides everything -- last match wins -- and add/remove
//  can build any list. Two fewer buttons needing art that does not exist yet.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/beaconconfig/panewide_header.png",
			"fileBody" : "/interface/lofty_petports/beaconconfig/panewide_body.png",
			"fileFooter" : "/interface/lofty_petports/beaconconfig/panewide_footer.png"
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			//  TOP RIGHT, in the title bar, the way every other pane does it.
		//  Inherited as [152, 89] from the chest config this started as, which
		//  put it halfway down the right edge underneath a scroll area -- there
		//  has never been a visible dismiss button on this pane.
		//
		//  THE Y WAS CALIBRATED AGAINST A SCREENSHOT, not guessed twice.
		//  enabledCheckbox at [10, 222] is locatable in a rendered pane, which
		//  fixes the art-to-screen mapping at about 1.95x; that confirmed 248
		//  was placing the button exactly where asked and the number itself was
		//  wrong. Measured against a vanilla container pane, it sat about 9
		//  art pixels low.
		//
		//  "title" cannot be used for this -- it positions by its own rules and
		//  its [-3, 80] does not live in the same space as everything else.
			"position" : [ 315, 255 ],
			"zlevel" : 1
		},

		"title" : {
			"type" : "title",
			//  TWO LEADING SPACES ON BOTH, MATCHING THE PETPORT. The gap between
			//  the header icon and the title text is set by PADDING IN THE STRING
			//  and by nothing else -- the title widget's own `position` moves the
			//  icon and the text together, so it cannot change the space between
			//  them, and every pane's icon already sits at x -4.
			//
			//  THE PETPORT IS THE REFERENCE because it is the one checked against
			//  a vanilla crafting station and found correct. Two spaces, not three
			//  and not none, in all four panes.
			"title" : "  Beacon",
			"subtitle" : "  Deposit filter",
			"position" : [ -3, 80 ],

			//  BESPOKE HEADER ICON, SWAPPED AT RUNTIME.
			//
			//  `file` here is the ON variant and is the PRE-SCRIPT DEFAULT
			//  ONLY -- init overwrites it from the beacon's real state before
			//  the player sees it, the same arrangement as enabledCheckbox
			//  below. It is on rather than off so that a pane whose script
			//  failed to seed shows the same thing the checkbox does.
			//
			//  THIS IS A SCRIPTPANE, so `hasWindowIcon` does not apply -- that
			//  is a ContainerPane behaviour and belongs to the petport and the
			//  upcycler. Nothing else draws a header icon here, so this block
			//  is the only source and there is no second icon to disagree with.
			//
			//  POSITION COPIED FROM THE PETPORT, NOT MEASURED. That pane had no
			//  position either and took [ -4, -4 ] to re-centre 24x24 art in a
			//  slot placed for 16x16. Same art size, same reasoning, same
			//  arithmetic -- and the same caveat: EXPECT TO NUDGE IT. The
			//  upcycler needed [ -4, -24 ] because its title sits elsewhere.
			"icon" : {
				"type" : "image",
				"file" : "/interface/lofty_petports/beaconconfig/paneicon_deposit_on.png",
				"position" : [ -4, -4 ],
				"zlevel" : -1
			}
		},

		//  ---- beacon on/off -------------------------------------------------

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 236 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 238 ],
			"petportsString" : "common.beaconactive",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- base verdict --------------------------------------------------
		//
		//  Rule zero, with a fixed position. Checked means the filter starts by
		//  accepting everything and the rules below carve exceptions out of it;
		//  unchecked starts from nothing and the rules let things in.

		"baseCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 220 ],
			"callback" : "baseToggled"
		},

		"baseLabel" : {
			"type" : "label",
			"position" : [ 26, 222 ],
			"petportsString" : "beacon.base",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- the rule list -------------------------------------------------
		//
		//  Evaluated TOP TO BOTTOM, last match wins, so the bottom entry is the
		//  most specific thing the player said. The header says so out loud
		//  because this is the opposite of the firewall convention and someone
		//  who assumes first-match will write their exceptions in the wrong
		//  place and see nothing happen.

		//  NO STANDALONE BUTTONS BESIDE THESE LISTS.
		//
		//  There were two: a remove X acting on the selected rule, and a back X
		//  that cleared the selection so the picker made sense again. Both were
		//  scaffolding from when the picker and the grid shared one rect.
		//
		//  Every rule row now carries its own X, so the first was a duplicate that
		//  acted on something the player had to remember selecting. And with both
		//  panels visible at once there is nothing to go back FROM -- the picker
		//  never stopped being usable.
//  ---- pet feeder --------------------------------------------------------
		//
		//  THE THIRD ROW, AND NOTHING BELOW IT MOVED. The two existing boxes went
		//  from an 18px pitch to 16 and shifted up 14, which buys one row above
		//  rulesLabel -- so the rules list keeps every pixel of its height. The
		//  stack now reads 236 / 220 / 204 against a label still at 190.
		//
		//  DEFAULTS ON, absent-means-on like the port's own switches. A crate a
		//  player has told the network about is one they expect the network to
		//  use; making them tick a third box on every beacon to get behaviour
		//  they already asked for is a support question, not a safeguard.
		//
		//  INERT UNTIL THE FUEL SYSTEM EXISTS. Treats accumulate and nothing eats
		//  one yet, so this stores a preference and nothing reads it -- the same
		//  state the crosshair toggle was in until this session.
		"feederCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 204 ],
			"caption" : "",
			"callback" : "feederToggled"
		},
		"feederLabel" : {
			"type" : "label",
			"position" : [ 26, 206 ],
			"petportsString" : "common.petfeeder",
			"value" : "--",
			"mouseTransparent" : true
		},

				"rulesLabel" : {
			"type" : "label",
			"position" : [ 10, 190 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"petportsString" : "beacon.rules",
			"value" : "--",
			"mouseTransparent" : true
		},

		"rulesScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 36, 160, 188 ],
			"children" : {
				"rulesList" : {
					"type" : "list",
					"callback" : "ruleSelected",
					"schema" : {
						//  ROW ART IS OURS AND IS SIZED TO memberSize.
						//
						//  These pointed at vanilla's crafting backgrounds --
						//  craftableselected2 and craftablebackground -- which
						//  are cut for crafting rows, not for a 16px one, and
						//  were being asked to serve three DIFFERENT widths
						//  across this mod's lists. However the engine resolves
						//  that, stretch or native, it cannot be right at all
						//  three, and the result was a selection you had to look
						//  for.
						//
						//  One pair per memberSize, generated to match exactly.
						//  Unselected is a barely-there fill that only marks
						//  where a row ends; selected is a raised bar with a
						//  lit top edge and a shadowed base.
						//
						//  THE SCHEMA HAS NO PER-ROW BACKGROUND, so alternating
						//  colours are not expressible here -- both keys apply
						//  to every row. Striping would need an image widget
						//  inside listTemplate set by index parity, which is a
						//  separate question: an unknown widget type in a row
						//  fails at CONSTRUCTION and takes the pane with it.
						"selectedBG" : "/interface/lofty_petports/shared/row_144_selected.png",
						"unselectedBG" : "/interface/lofty_petports/shared/row_144.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 144, 16 ],
						"listTemplate" : {
							//  A VERB, NOT A CHECKBOX.
							//
							//  This was a tick box and it read as "rule enabled / rule disabled
							//  but still present", which is not a state that exists. A rule is
							//  either an allow or a deny; there is no off.
							//
							//  The two states are different SHAPES, not one shape in two colours:
							//  a filled green disc against a red disc with a bar through it. A
							//  ticked/unticked pair of the same glyph is what caused the
							//  misreading, and colour alone would repeat it for anyone who does
							//  not separate red from green.
							//
							//  Still a checkable button underneath, so checked == accept.
							//  A BACKGROUND IMAGE INSIDE THE ROW, WHICH IS HOW VANILLA DOES IT.
							//
							//  The schema's selectedBG and unselectedBG never drew anything
							//  here. crafting.config and vendingmachine.config both carry a
							//  `background` image at zlevel -1 in their listTemplate and
							//  address it from script, alongside those same schema keys -- so
							//  the row art is drawn by a widget, not by the schema. Per row
							//  rather than per list is also what makes an alternating shade
							//  possible at all.
							//
							//  SELECTION IS THE BAR AND ONLY THE BAR on this list. Rule text is
							//  already coloured by MEANING -- green for accept, red for deny,
							//  set by setFontColor in refreshRules -- so the yellow tint the
							//  restock pane uses to mark a selected row would collide with it.
							//
							//  zlevel -2, below the row's own action button at -1.
							"rowBG" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_144.png",
								"position" : [ 0, 0 ],
								"zlevel" : -2
							},
							//  HOVER, LAYERED OVER THE ROW ART RATHER THAN REPLACING IT.
							//
							//  A list schema has no hover state, so hover needs a BUTTON -- but a button
							//  carries one base image and cannot alternate or show a selection. So it does
							//  neither: its base is fully transparent, the rowBG image beneath keeps
							//  carrying alternating and selected state, and the hover art is TRANSLUCENT so
							//  it lifts whatever is under it. Hovering a selected row brightens the bar
							//  instead of hiding it.
							//
							//  IT DOES NOT STEAL THE SELECTION. Measured on the group picker: a full-width
							//  row button and the list's own callback BOTH fire on one click. So the list
							//  still selects normally and this button's callback does nothing -- it exists
							//  only to own a hover state.
							//
							//  A CALLBACK IS STILL MANDATORY. A row widget naming one that does not resolve
							//  throws inside addListItem and takes the pane with it.
							//
							//  SIZED EXPLICITLY to memberSize, as vanilla's bookmark row button is. A button
							//  otherwise takes its hit area from the base image -- and this base is
							//  transparent.
							"rowHover" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/shared/row_144_clear.png",
								"hover" : "/interface/lofty_petports/shared/row_144_hover.png",
								"pressed" : "/interface/lofty_petports/shared/row_144_clear.png",
								"pressedOffset" : [ 0, 0 ],
								"size" : [ 144, 16 ],
								"position" : [ 0, 0 ],
								"zlevel" : -1,
								"callback" : "rowHovered"
							},
							"rowAction" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/beaconconfig/verb_deny.png",
								"hover" : "/interface/lofty_petports/beaconconfig/verb_denyhover.png",
								"baseImageChecked" : "/interface/lofty_petports/beaconconfig/verb_accept.png",
								"hoverImageChecked" : "/interface/lofty_petports/beaconconfig/verb_accepthover.png",
								"checkable" : true,
								"checked" : false,
								"position" : [ 2, 2 ],
								"callback" : "ruleRowAction"
							},
							//  NO wrapWidth, DELIBERATELY.
							//
							//  It was 108, and a rule label is routinely wider than that -- "Accept
							//  Location Themed (23 of 25)" is nearly double. A wrapped label in a
							//  16px row renders its overflow line ABOVE the anchor, which read as
							//  stray pixels bleeding into the row above.
							//
							//  Wrapping is the wrong fix anyway: a two-line row would cut how many
							//  rules fit on screen from five to three. The label is shortened at
							//  the source instead -- see ruleLabel, which drops the verb (the row
							//  checkbox already carries it), abbreviates the count, and truncates.
							"ruleText" : {
								"mouseTransparent" : true,
								"type" : "label",
								"position" : [ 16, 4 ],
								"hAnchor" : "left",
								"value" : ""
							},
							"rowRemove" : {
								"type" : "button",
								"base" : "/interface/x.png",
								"hover" : "/interface/xhover.png",
								"pressed" : "/interface/xpress.png",
								"position" : [ 131, 3 ],
								"callback" : "ruleRowRemove"
							}
						}
					}
				}
			}
		},

		//  ---- acting on the selected rule -----------------------------------

		//  The accept/deny control that used to sit here is gone. Every rule row
		//  carries its own verb icon, so a second one acting on "the selected
		//  rule" was a duplicate that looked like a THIRD state -- and the
		//  beacon cannot be inside a crate while this pane is open, so nothing
		//  else needed it. Removing a rule keeps a button here because deleting
		//  by accident is worse than deleting by two clicks.
			"groupsLabel" : {
			"type" : "label",
			"position" : [ 172, 238 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"petportsString" : "beacon.groups",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- the subgroup grid ---------------------------------------------
		//
		//  THE RIGHT COLUMN RUNS THE FULL HEIGHT OF THE BAND.
		//
		//  It used to start at y=188, leaving about 50px of frame empty above the
		//  picker and squeezing 19 groups into a four-row window. Scrolling a
		//  list that short lands the offset mid-row and the text sits wrong.
		//  Seven rows now, and the dead space is gone.
		//
		//  NOTHING MAY CROSS y=25. The frame is header 25 + body 224 + footer 25,
		//  and widget coordinates run from the bottom of the FOOTER -- so the
		//  usable band is y 25..249. This rect had its bottom at 20, five pixels
		//  inside the footer, which is why the bottom row of tiles and the
		//  scrollbar were drawn over the frame.
		//
		//  BESIDE THE PICKER, NOT INSTEAD OF IT. These shared one rect and took
		//  turns while the pane was 160 wide. At 318 both fit down the right
		//  side -- picker above, subgroups below -- so adding a rule and
		//  narrowing one are no longer modes you switch between.
		//
		//  With no rule selected the grid is simply empty and the label says
		//  what to do about it.
		//
		//  EACH TILE IS THE CHECKBOX. Ticked means the subgroup is INCLUDED in
		//  the rule. The stored value is the opposite -- rule.except lists what
		//  is switched OFF -- so that a subgroup added later by another mod is
		//  inside every existing rule by default. The pane inverts on read and
		//  on write; nothing downstream sees an inclusion list.
		//
		//  ART IS PLACEHOLDER. A hollow diamond with a corner indicator, so a
		//  tile with no real icon yet is obviously unfinished rather than
		//  looking like a deliberate blank. 26x26 at 5 columns fits the 144px
		//  of usable width with 2px gaps.
		"subgroupsLabel" : {
			"type" : "label",
			"position" : [ 172, 108 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"petportsString" : "beacon.subgroups",
			"value" : "--",
			"mouseTransparent" : true
		},

		"subgroupsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 170, 30, 329, 106 ],
			"children" : {
				"subgroupsList" : {
					"type" : "list",
					"callback" : "null",
					//  FIVE, NOT SIX. Six 24px tiles plus gaps need 154 of the 159px rect and
					//  leave 5 for the scrollbar, which is how the tiles ended up drawn under
					//  it last time. Five need 128 and leave 31.
					"columns" : 5,
					"fillDown" : true,
					"schema" : {
						"selectedBG" : "",
						"unselectedBG" : "",
						"spacing" : [ 2, 2 ],
						"memberSize" : [ 24, 24 ],
						"listTemplate" : {
							"tile" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/beaconconfig/subgroup_off.png",
								"hover" : "/interface/lofty_petports/beaconconfig/subgroup_offhover.png",
								"baseImageChecked" : "/interface/lofty_petports/beaconconfig/subgroup_on.png",
								"hoverImageChecked" : "/interface/lofty_petports/beaconconfig/subgroup_onhover.png",
								"checkable" : true,
								"checked" : true,
								"position" : [ 0, 0 ],
								"callback" : "subgroupToggled"
							}
						}
					}
				}
			}
		},

		//  Returns to the picker by dropping the rule selection. Without it a
		//  player who selected a rule could not get back to adding one.
			"groupsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 170, 118, 329, 236 ],
			"children" : {
				"groupsList" : {
					"type" : "list",

					//  NULL, AS VANILLA'S BOOKMARK LIST DOES, AND FOR THE MEASURED
					//  REASON RATHER THAN THE ASSUMED ONE.
					//
					//  The guess was that a full-width row button consumes the
					//  click. It does not -- both fired, in the same click:
					//
					//    groupPicked fired (list callback) for tagged_electronic
					//    addGroupRule(tagged_electronic) via row button
					//
					//  So a list callback left wired beside a row button is a
					//  DOUBLE handler, and had groupPicked still been acting that
					//  would have added every rule twice. That is why cockpit.config
					//  nulls this on its bookmark list.
					"callback" : "null",
					"schema" : {
						"selectedBG" : "/interface/lofty_petports/shared/row_155_selected.png",
						"unselectedBG" : "/interface/lofty_petports/shared/row_155.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 155, 16 ],
						"listTemplate" : {
							//  NO wrapWidth, for the same reason the rule rows have none.
							//
							//  It was 128 in a 136-wide row, and "Furniture - Tagged: peacekeeper"
							//  is 31 characters. It wrapped, and a wrapped label in a 16px row puts
							//  its first line ABOVE the row -- so the entry read as just
							//  "peacekeeper" with the rest drawn over whatever sat above it.
							//
							//  The pane is 19px wider now and the row is 155, which fits the longest
							//  label the manifest can currently produce. Removing the wrap is the
							//  belt to that braces: a longer one from a mod overflows into the row
							//  margin, which looks untidy, rather than silently losing its front.
							//  ALTERNATING SHADE ONLY, NEVER A SELECTED ONE.
							//
							//  This list is a MENU OF ACTIONS, not a selection: clicking a group
							//  adds a rule, and the row is not "current" afterwards. Leaving one
							//  lit would read as "this is chosen", which suggests the same group
							//  cannot be added twice -- and it can.
							//
							//  So paintGroupRows never sets a selected art here, and addGroupRule
							//  rebuilds the list afterwards, which drops any selection as a
							//  side effect.
							//  THE SHADE, UNDERNEATH THE BUTTON.
							//
							//  A button carries ONE base image, so the alternating row shade
							//  cannot live on it -- that is why the stripes vanished when these
							//  rows became buttons. An image below it can still alternate,
							//  painted per row by paintGroupRows, with the button's faint base
							//  sitting over the top and its hover painting over both.
							"rowBGShade" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_155.png",
								"position" : [ 0, 0 ],
								"zlevel" : -3,
								"mouseTransparent" : true
							},

							//  A BUTTON, NOT AN IMAGE, AND THAT IS THE ONLY WAY TO GET HOVER.
							//
							//  Nothing in a list schema carries a hover state -- vanilla's
							//  crafting and vending lists have none, and selectedBG /
							//  unselectedBG do not draw here at all. Hover belongs to buttons,
							//  and a button inside a listTemplate is proven: rowAction,
							//  rowRemove and the subgroup tile are all buttons.
							//
							//  NO ALTERNATING SHADE ON THIS LIST. A button has one base image,
							//  so per-row art would need the base swapped at runtime -- and
							//  whether that is even possible is another unverified thing. Hover
							//  is what was asked for here; stripes are not worth a second
							//  unknown.
							//
							//  THE ROW BUTTON IS THE ONLY HANDLER. Measured: a row button does
							//  NOT swallow the click -- the list callback fired too, on the same
							//  click -- so the list's own callback is nulled above rather than
							//  left to double up.
							"rowBG" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/shared/row_155.png",
								"hover" : "/interface/lofty_petports/shared/row_155_hover.png",
								"pressed" : "/interface/lofty_petports/shared/row_155.png",
								"pressedOffset" : [ 0, 0 ],
							
								//  SIZED EXPLICITLY TO memberSize, as vanilla's bookmark list does
								//  with its own row button. Without it a button takes its size
								//  from the base image, which happens to be right here and would
								//  silently stop being right the moment the art or the row size
								//  changed -- and a hit area that no longer covers the row is a
								//  dead strip the player cannot click.
								"size" : [ 155, 16 ],
								"position" : [ 0, 0 ],
								"zlevel" : -2,
								"callback" : "groupRowPicked"
							},
							"groupText" : {
								"mouseTransparent" : true,
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"value" : ""
							}
						}
					}
				}
			}
		}
	},

	//  Hover text for the subgroup tiles. The tiles carry placeholder art
	//  and no label, so this is the only thing naming them -- same pattern as
	//  the collections pane, read by createTooltip in the script.
	//  A TOOLTIP IS SIZED BY ITS BACKGROUND IMAGE, so this carries its own.
	//  racebody.png is a full race-description panel and produced a tooltip
	//  taking up something like half the screen for two short lines. Rather
	//  than guess at a smaller vanilla asset -- a wrong path renders a red
	//  placeholder and logs "Could not load image asset" -- tooltip_body.png
	//  is ours, 124x30, sized to a subgroup name over one line of state.
	//
	//  wrapWidth is set just inside the frame so a long subgroup label clips
	//  rather than spilling outside the box.
	"tooltipLayout" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "",
			"fileBody" : "/interface/lofty_petports/beaconconfig/tooltip_body.png",
			"fileFooter" : ""
		},
		"title" : {
			"type" : "label",
			"position" : [ 6, 20 ],
			"hAnchor" : "left",
			"wrapWidth" : 112
		},
		"description" : {
			"type" : "label",
			"position" : [ 6, 8 ],
			"hAnchor" : "left",
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"wrapWidth" : 112
		}
	},

	"scripts" : [ "/interface/lofty_petports/beaconconfig/beaconconfig.lua" ],
	"scriptDelta" : 1,

	//  Every callback named above must appear here or the widget silently does
	//  nothing when clicked.
	"scriptWidgetCallbacks" : [
		"enabledToggled",
		"baseToggled",
		"ruleSelected",
		"feederToggled"
	]
}
