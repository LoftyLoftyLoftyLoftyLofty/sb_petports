//  PETPORTS -- BEACON CONFIGURATION PANE
//
//  Opened by petports_beacon.lua via activeItem.interact("ScriptPane", <this>).
//
//  BORROWED CHROME, DELIBERATELY. The background and close button come from
//  /interface/chests/, the same place the petport's placeholder interface came
//  from. Players already read that frame as "this is a thing you configure",
//  and bespoke pane art is a polish-phase problem, not a v1 one.
//
//  ASSET PATHS ARE VERIFIED AGAINST THE LOG, NOT REMEMBERED. An earlier pass
//  guessed five of them wrong. A missing pane image does NOT stop the pane
//  building -- it renders a red placeholder glyph and writes
//  "Could not load image asset" to the log, so a pane that looks broken and a
//  pane that failed to open are different symptoms with different causes.
//  Check the log for AssetException before touching anything structural.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/chests/chestheader.png",
			"fileBody" : "/interface/chests/chestbody.png",
			"fileFooter" : "/interface/chests/chestfooter.png"
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"position" : [ 152, 89 ],
			"zlevel" : 1
		},

		"title" : {
			"type" : "title",
			"title" : "Beacon",
			"subtitle" : "Configure this beacon",
			"position" : [ -3, 80 ]
		},

		//  A checkable button IS the vanilla checkbox -- there is no separate
		//  widget type. baseImageChecked is what makes it one.
		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 12, 55 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 28, 57 ],
			"value" : "Active"
		},

		//  Says what OFF means, because "off" on an item that works by sitting
		//  in a chest is not self-explanatory.
		"enabledHint" : {
			"type" : "label",
			"position" : [ 12, 14 ],
			"wrapWidth" : 145,
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "An inactive beacon is ignored by ports. Switch a beacon off before storing spares in a container."
		}
	},

	"scripts" : [ "/interface/lofty_petports/beaconconfig/beaconconfig.lua" ],
	"scriptDelta" : 1,
	"scriptWidgetCallbacks" : [ "enabledToggled" ]
}
