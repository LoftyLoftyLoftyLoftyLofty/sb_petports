//  PETPORTS -- PETPORT PANE
//
//  A CONTAINER PANE WITH A SCRIPT, the same third thing the upcycler is. See
//  upcyclerconfig.config's header for the reasoning; it applies here unchanged.
//  Container slots AND arbitrary widgets in one window, addressing an entity id
//  so no token system is needed.
//
//  337 x 335 -- header 25 + body 285 + footer 25, so the usable band is
//  y 25..310. Grew by 30 on 2026-08-28: the diagnostics row and its label
//  had been placed at y 12 and y 2, which is INSIDE THE FOOTER -- drawn
//  over the frame and off the bottom of the pane. Height is the free axis
//  here, so the fix was to buy space rather than to squeeze the portrait.
//
//  WIDTH IS THE CONSTRAINT, HEIGHT IS FREE. Force-centering happens when a pane
//  is too wide to sit beside the player's inventory, and the threshold moves
//  with the client window, so it cannot be probed to a number. 337 is the
//  beacon pane's width and is known good in play; 527 is the upcycler's and is
//  known bad. So the mockup's proportions were NOT kept: width came out, height
//  went back in, and the layout is taller relative to its width than the mockup
//  drew it.
//
//  THERE IS NO 19px CONSTRAINT AND THERE NEVER WAS. The beacon body's lower
//  rows carry chest slot shadowing on a 19px repeat, which is what made pane
//  art look like it tiled on a grid. It is art for rows of item slots. This
//  pane has one 1x1 grid, so panetall_body.png is one uniform row tiled to
//  height with no shadow band at all, and it can be any height we like.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT of the footer. Footer 0..25, body
//  25..280, header 280..305. A widget outside that band is not an error -- it
//  is drawn over the frame, or not drawn.
//
//  TITLE AND SUBTITLE BOTH RENDER, AND THAT IS NOT LUCK. ContainerPane
//  overwrites both from the object's `shortdescription` and `category`, unless
//  the object declares NO category -- which the petport already does, on
//  purpose, with a comment in the .object saying so. Putting a category back on
//  the object silently reverts the subtitle to a category label and neither
//  file can express that on its own.
//
//  THE HEADER ICON IS OURS ONLY BECAUSE THE OBJECT SAYS SO. ContainerPane draws
//  its own icon from the object's `inventoryIcon` unless the object sets
//  `hasWindowIcon : false`. The object now does, so the `icon` child below is
//  what renders. Both pointed at the same file on the upcycler, which is why
//  this looked like a partial success there for a while.
//
//  NO WRAPPED LABELS IN THE LEFT COLUMN, DELIBERATELY.
//
//  A wrapped label's position is the BOTTOM of the text block and adding a line
//  pushes the TOP up, so a block that fits today collides the moment the copy
//  grows. The diagnostics readout is therefore a FIXED ROW OF ICONS plus one
//  single-line label: the region's height stops depending on string length, and
//  what bounds it is the number of distinct diagnostic TYPES, which is a small
//  set we control. It also means the layout does not move when the strings are
//  translated.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/petportconfig/panetall_header.png",
			"fileBody" : "/interface/lofty_petports/petportconfig/panetall_body.png",
			"fileFooter" : "/interface/lofty_petports/petportconfig/panetall_footer.png"
		},

		//  FOUND BY TYPE, NOT BY NAME. Renaming this widget does not stop
		//  ContainerPane finding it -- measured on the upcycler.
		"windowtitle" : {
			"type" : "title",
			"title" : " Petport",
			"subtitle" : " ^#b9b5b2;Configure and deploy pets",
			"icon" : {
				"type" : "image",
				"file" : "/objects/lofty_petports/petport/petports_petporticon.png",
				"zlevel" : -1
			}
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"pressedOffset" : [ 0, 0 ],
			"position" : [ 315, 316 ],
			"zlevel" : 1
		},

		//  ---- the pet socket ----------------------------------------------------
		//
		//  SLOT 0, AND THE ONLY CONTAINER SLOT THIS OBJECT HAS.
		//
		//  It sits in the PORT band rather than in the pet column on purpose: the
		//  socket has to stay reachable when nothing is home, and everything in
		//  the pet column below is meaningless without a unit. That is also what
		//  lets the empty-port overlay cover the lower pane and leave this alone.
		//
		//  NO CALLBACKS. `itemGrid` is a name ContainerPane registers itself,
		//  along with `itemGrid.right`, so the script supplies nothing. A grid the
		//  script DOES drive needs both names given explicitly -- the right-click
		//  one defaults to "<callback>.right", and a dotted name is unreachable as
		//  a Lua global.
		"itemGrid" : {
			"type" : "itemgrid",
			"position" : [ 16, 270 ],
			"slotOffset" : 0,
			"dimensions" : [ 1, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		"socketLabel" : {
			"type" : "label",
			"position" : [ 10, 258 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "unit",
			"mouseTransparent" : true
		},

		//  ---- the port band -----------------------------------------------------
		//
		//  PORT STATE, NOT PET STATE, and the divider under it is the whole point:
		//  a network id belongs to the port whether or not anything is socketed.
		//
		//  PLACEHOLDER. Network id, participation and the enabled checkbox all
		//  live here and none of them are built -- see "Network control" in the
		//  handoff, which is the largest gap between what the design says and what
		//  is reachable in game.
		//
		//  PARTICIPATION IS BY GROUP, NOT BY TASK. Nine checkboxes do not fit this
		//  band and a player thinks in loops rather than in dispatch branches.
		"portHeading" : {
			"type" : "label",
			"position" : [ 54, 296 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"value" : "Network",
			"mouseTransparent" : true
		},

		"portNetworkLabel" : {
			"type" : "label",
			"position" : [ 54, 282 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "id: --",
			"mouseTransparent" : true
		},

		"portEnabled" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 54, 262 ],
			"caption" : "",
			"callback" : "portEnabledToggled"
		},

		"portEnabledLabel" : {
			"type" : "label",
			"position" : [ 70, 266 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Port enabled",
			"mouseTransparent" : true
		},

		"portTasksLabel" : {
			"type" : "label",
			"position" : [ 178, 296 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"value" : "Participates in",
			"mouseTransparent" : true
		},

		"groupSorting" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 178, 280 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupSortingLabel" : {
			"type" : "label",
			"position" : [ 194, 284 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Sorting",
			"mouseTransparent" : true
		},

		"groupFarming" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 178, 264 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupFarmingLabel" : {
			"type" : "label",
			"position" : [ 194, 268 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Farming",
			"mouseTransparent" : true
		},

		"groupMachines" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 258, 280 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupMachinesLabel" : {
			"type" : "label",
			"position" : [ 274, 284 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Machines",
			"mouseTransparent" : true
		},

		"groupHauling" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 258, 264 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupHaulingLabel" : {
			"type" : "label",
			"position" : [ 274, 268 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Hauling",
			"mouseTransparent" : true
		},

		//  ---- the pet column ----------------------------------------------------
		//
		//  ALWAYS VISIBLE, NEVER IN A TAB. Name, fuel, cargo and current task are
		//  what a player opens this pane to see, so none of them are ever a click
		//  away.

		"petName" : {
			"type" : "label",
			"position" : [ 8, 226 ],
			"fontSize" : 10,
			"color" : [ 255, 255, 255 ],
			"value" : "No unit",
			"mouseTransparent" : true
		},

		//  THE SPECIES, SHOWN ONLY WHEN THE NAME IS NOT THE DEFAULT. Which means
		//  the default has to be knowable -- see petportconfig.lua, where it comes
		//  from the monstertype rather than from a stored copy, so a renamed unit
		//  cannot drift from what its species is actually called.
		"petSpecies" : {
			"type" : "label",
			"position" : [ 8, 216 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  THE PORTRAIT IS A CANVAS, NOT AN ICON, which is the mech assembly
		//  station's pattern: bindCanvas, then drawImage with the part's own
		//  directives applied. That means the portrait shows the ACTUAL unit --
		//  its chassis colour strip now, its monsterpart variant when several
		//  exist -- rather than four hand-drawn icons that go stale at the art
		//  pass.
		//
		//  REDRAWN ON CHANGE, NEVER PER TICK. mechassemblygui's update(dt) is
		//  empty and updatePreview is called from init and from the two change
		//  handlers. Gating a canvas REDRAW is safe; gating a widget's VISIBILITY
		//  is what latched the upcycler's blips invisible forever.
		"petPreview" : {
			"type" : "canvas",
			"rect" : [ 8, 134, 114, 210 ],
			"zlevel" : 1,
			"captureMouseEvents" : false,
			"captureKeyboardEvents" : false
		},

		//  ---- fuel ---------------------------------------------------------------
		//
		//  EIGHT BLIPS, RECOLOURED, NEVER HIDDEN. Same sprite and same count as
		//  the upcycler's reagent charge, so one convention serves both panes.
		//
		//  RECOLOUR RATHER THAN SHOW/HIDE IS ALSO THE SAFE CHOICE: the upcycler's
		//  blips were latched invisible by a change gate that outlived the
		//  widget's visibility. A setImage cannot be stranded that way.
		//
		//  THE DECLARED FILE MUST STAY BARE. Directives COMPOUND -- a "?multiply="
		//  written here is not replaced by the one the script supplies, it
		//  multiplies with it.
		"fuelBlip1" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 8, 120 ], "mouseTransparent" : true },
		"fuelBlip2" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 13, 120 ], "mouseTransparent" : true },
		"fuelBlip3" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 18, 120 ], "mouseTransparent" : true },
		"fuelBlip4" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 23, 120 ], "mouseTransparent" : true },
		"fuelBlip5" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 28, 120 ], "mouseTransparent" : true },
		"fuelBlip6" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 33, 120 ], "mouseTransparent" : true },
		"fuelBlip7" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 38, 120 ], "mouseTransparent" : true },
		"fuelBlip8" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 43, 120 ], "mouseTransparent" : true },
		"fuelBlip9" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 48, 120 ], "mouseTransparent" : true },
		"fuelBlip10" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 53, 120 ], "mouseTransparent" : true },
		"fuelBlip11" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 58, 120 ], "mouseTransparent" : true },
		"fuelBlip12" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 63, 120 ], "mouseTransparent" : true },
		"fuelBlip13" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 68, 120 ], "mouseTransparent" : true },
		"fuelBlip14" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 73, 120 ], "mouseTransparent" : true },
		"fuelBlip15" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 78, 120 ], "mouseTransparent" : true },
		"fuelBlip16" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 83, 120 ], "mouseTransparent" : true },
		"fuelBlip17" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 88, 120 ], "mouseTransparent" : true },
		"fuelBlip18" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 93, 120 ], "mouseTransparent" : true },
		"fuelBlip19" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 98, 120 ], "mouseTransparent" : true },
		"fuelBlip20" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 103, 120 ], "mouseTransparent" : true },

		"fuelLabel" : {
			"type" : "label",
			"position" : [ 8, 108 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Fuel",
			"mouseTransparent" : true
		},

		//  ---- cargo --------------------------------------------------------------
		//
		//  A DISPLAY SLOT WITH A FREE TOOLTIP, AND THE TAKE BUTTON DOES THE WORK.
		//
		//  An itemslot has NO native inventory behaviour -- mechassemblygui's
		//  swapItem does every part of the move in script: read the cursor, write
		//  the cursor, set the display, update the model. So `callback : "null"`
		//  is a pure display widget that still shows a stack count and still gets
		//  the automatic item tooltip.
		//
		//  THE TRAP NOTE ABOUT ITEMSLOTS DOES NOT APPLY HERE, and it reads as
		//  though it does. "An itemslot is not a button" was measured on a slot
		//  sitting ON TOP OF A ROW BUTTON that needed the click; there,
		//  `callback : "null"` failed because the row went dead. Cargo needs no
		//  click, so the option that failed there is the right one here. Reaching
		//  for image stamping instead costs the tooltip for nothing.
		//
		//  `"null"` IS SPECIAL-CASED and never looks for `null.right`, which is
		//  why no rightClickCallback is named.
		//
		//  A BUTTON RATHER THAN A REAL GRID IS ALSO THE ONE-AUTHORITY CHOICE.
		//  Cargo lives on petData, which is what makes it survive unsocket and
		//  reload. A bound grid would be a second authority, and the two diverge
		//  exactly when a unit is out in the field.
		"cargoLabel" : {
			"type" : "label",
			"position" : [ 8, 94 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "Cargo",
			"mouseTransparent" : true
		},

		//  AN ITEMSLOT DOES DRAW ITS STACK COUNT. A comment here previously said
		//  it does not, on the strength of a single-item cargo showing no
		//  number -- the widget HIDES a count of one, the same way inventory
		//  slots do, so one item and no count look identical to a broken
		//  readout. The x## label that was added beside it is gone again.
		"cargoSlot" : {
			"type" : "itemslot",
			"position" : [ 92, 74 ],
			"zlevel" : 2,
			"callback" : "null"
		},


		"cargoTake" : {
			"type" : "button",
			"base" : "/interface/lofty_petports/petportconfig/tab_base.png",
			"hover" : "/interface/lofty_petports/petportconfig/tab_hover.png",
			"position" : [ 8, 74 ],
			"caption" : "Take",
			"callback" : "cargoTakeClicked"
		},

		//  ---- task and diagnostics -----------------------------------------------
		//
		//  "Why is that one just standing there" is the question this pane exists
		//  to answer, and the current task is the cheapest possible answer to it.
		//
		//  THE DIAGNOSTIC ICONS ARE A FIXED ROW. Four is the ceiling and the row
		//  never changes height. See the header for why this is not a label.
		"taskLabel" : {
			"type" : "label",
			"position" : [ 8, 62 ],
			"fontSize" : 7,
			"color" : [ 220, 224, 230 ],
			"value" : "",
			"mouseTransparent" : true
		},

		"diag1" : { "type" : "image", "file" : "/interface/lofty_petports/upcyclerconfig/warning.png", "position" : [ 8, 42 ], "visible" : false, "zlevel" : 2 },
		"diag2" : { "type" : "image", "file" : "/interface/lofty_petports/upcyclerconfig/warning.png", "position" : [ 26, 42 ], "visible" : false, "zlevel" : 2 },
		"diag3" : { "type" : "image", "file" : "/interface/lofty_petports/upcyclerconfig/warning.png", "position" : [ 44, 42 ], "visible" : false, "zlevel" : 2 },
		"diag4" : { "type" : "image", "file" : "/interface/lofty_petports/upcyclerconfig/warning.png", "position" : [ 62, 42 ], "visible" : false, "zlevel" : 2 },

		//  ONE LINE, AND IT IS THE FALLBACK RATHER THAN THE READOUT. Whether
		//  createTooltip works on an image widget is UNVERIFIED, so the skeleton
		//  does not stake the whole diagnostic readout on it: the newest message's
		//  short form always renders here, at fixed height, tooltips or not.
		"diagLabel" : {
			"type" : "label",
			"position" : [ 8, 32 ],
			"fontSize" : 7,
			"color" : [ 226, 138, 138 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- tabs ---------------------------------------------------------------
		//
		//  CHECKABLE BUTTONS, NOT A radioGroup, AND THE BLOCKER IS NOW GONE. The
		//  upcycler uses captioned buttons because a radioGroup button takes an
		//  IMAGE and no tab art existed. Tab art exists now, so the swap is
		//  available -- showTab() is the single entry point either way. Kept as
		//  buttons for this build so the pane has one fewer unknown in it.
		"tabDetails" : {
			"type" : "button",
			"base" : "/interface/lofty_petports/petportconfig/tab_base.png",
			"hover" : "/interface/lofty_petports/petportconfig/tab_hover.png",
			"baseImageChecked" : "/interface/lofty_petports/petportconfig/tab_checked.png",
			"hoverImageChecked" : "/interface/lofty_petports/petportconfig/tab_checkedhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 124, 224 ],
			"caption" : "Details",
			"callback" : "tabDetailsClicked"
		},
		"tabSettings" : {
			"type" : "button",
			"base" : "/interface/lofty_petports/petportconfig/tab_base.png",
			"hover" : "/interface/lofty_petports/petportconfig/tab_hover.png",
			"baseImageChecked" : "/interface/lofty_petports/petportconfig/tab_checked.png",
			"hoverImageChecked" : "/interface/lofty_petports/petportconfig/tab_checkedhover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 194, 224 ],
			"caption" : "Settings",
			"callback" : "tabSettingsClicked"
		},
		"tabStats" : {
			"type" : "button",
			"base" : "/interface/lofty_petports/petportconfig/tab_base.png",
			"hover" : "/interface/lofty_petports/petportconfig/tab_hover.png",
			"baseImageChecked" : "/interface/lofty_petports/petportconfig/tab_checked.png",
			"hoverImageChecked" : "/interface/lofty_petports/petportconfig/tab_checkedhover.png",
			"checkable" : true,
			"checked" : false,
			"position" : [ 264, 224 ],
			"caption" : "Stats",
			"callback" : "tabStatsClicked"
		},

		//  ---- DETAILS tab --------------------------------------------------------
		//
		//  MODULES, PREFERRED FLAVOR AND RENAME. Modules are itemslots and that is
		//  the ONE place the widget is the right tool rather than a workaround:
		//  vanilla's only real-inventory use of it is the mech assembly station,
		//  where every part is NON-STACKABLE, and a module is the same shape.
		//
		//  WHICH MAKES `maxStack : 1` A REQUIREMENT ON THE MODULE ITEMS, not a
		//  check in this pane. player.swapSlotItem() returns the WHOLE cursor
		//  stack and nothing in mechassemblygui clamps it -- vanilla never had to,
		//  because mech parts cannot stack.
		//
		//  MODULES LIVE ON petData, NEVER IN THE CONTAINER. A module belongs to
		//  the pet: unsocket a kitted unit, carry it to another port, and the
		//  modules travel with it. Container slots on the PORT would strand them.
		//  So these slots are display fed by setItemSlotItem, and the descriptor
		//  lives on the item -- which is also why this needs no extra grid.
		//
		//  SLOT COUNT IS AUTHORED ON THE ITEM, NOT DERIVED FROM RARITY. Rarity is
		//  the convention (Common 0, Uncommon 1, Rare 2, Legendary 3) and not the
		//  rule: the first modded pet to bracket into the normally-unobtainable
		//  Essential tier would break a derivation.
