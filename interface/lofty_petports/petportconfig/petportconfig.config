		//  ---- DETAILS tab --------------------------------------------------------
		//
		//  MODULES, PREFERRED FLAVOR AND RENAME. Modules are itemslots and that is
		//  the ONE place the widget is the right tool rather than a workaround:
		//  vanilla's only real-inventory use of it is the mech assembly station,
		//  where every part is NON-STACKABLE, and a module is the same shape.
		//
		//  WHICH MAKES `maxStack : 1` A REQUIREMENT ON THE MODULE ITEMS, not a
		//  check in this pane. player.swapSlotItem() returns the WHOLE cursor
		//  stack and nothing in mechassemblygui clamps it -- vanilla never had to,
		//  because mech parts cannot stack.
		//
		//  MODULES LIVE ON petData, NEVER IN THE CONTAINER. A module belongs to
		//  the pet: unsocket a kitted unit, carry it to another port, and the
		//  modules travel with it. Container slots on the PORT would strand them.
		//  So these slots are display fed by setItemSlotItem, and the descriptor
		//  lives on the item -- which is also why this needs no extra grid.
		//
		//  SLOT COUNT IS AUTHORED ON THE ITEM, NOT DERIVED FROM RARITY. Rarity is
		//  the convention (Common 0, Uncommon 1, Rare 2, Legendary 3) and not the
		//  rule: the first modded pet to bracket into the normally-unobtainable
		//  Essential tier would break a derivation.
		"detailsModulesLabel" : {
			"type" : "label",
			"position" : [ 126, 206 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"petportsString" : "petport.details.modules",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  FIVE DECLARED, AND FIVE IS A DESIGN CEILING RATHER THAN A ROUND
		//  NUMBER. The investment path tops out at slot 5 -- the four upgrades
		//  ride the EPP ladder, Living Root through Cryonic Extract -- and the
		//  rarity table in petports_petport.lua puts Essential, the tier a
		//  modder brackets a special pet into, at the same five.
		//
		//  DECLARED RATHER THAN BUILT AT RUNTIME. widget.addChild would let the
		//  row size itself, and is unverified in this codebase; a count whose
		//  ceiling is already known by design does not need it. The script hides
		//  the ones a unit has not earned.
		//
		//  22px PITCH, WHICH IS 18px OF SLOT AND 4px OF AIR. The row runs
		//  126..232 and clears feedSlot at x 240.
		//
		//  BOTH CALLBACKS NAMED. rightClickCallback defaults to
		//  "<callback>.right" on an itemslot, and a dotted name is unreachable
		//  as a Lua global -- so leaving it off throws at CONSTRUCTION and the
		//  pane does not open at all. "null" is special-cased and never looks
		//  for null.right.
		"moduleSlot1" : { "type" : "itemslot", "position" : [ 126, 184 ], "zlevel" : 2, "callback" : "moduleSlotClicked", "rightClickCallback" : "null" },
		"moduleSlot2" : { "type" : "itemslot", "position" : [ 148, 184 ], "zlevel" : 2, "callback" : "moduleSlotClicked", "rightClickCallback" : "null" },
		"moduleSlot3" : { "type" : "itemslot", "position" : [ 170, 184 ], "zlevel" : 2, "callback" : "moduleSlotClicked", "rightClickCallback" : "null" },
		"moduleSlot4" : { "type" : "itemslot", "position" : [ 192, 184 ], "zlevel" : 2, "callback" : "moduleSlotClicked", "rightClickCallback" : "null" },
		"moduleSlot5" : { "type" : "itemslot", "position" : [ 214, 184 ], "zlevel" : 2, "callback" : "moduleSlotClicked", "rightClickCallback" : "null" },

		//  IDIOT INSTRUCTIONS FOR THE MODULE ROW, and the row needs them: five
		//  empty slots with a heading over them say nothing about what goes in.
		//
		//  MEASURED: A WRAPPED LABEL GROWS DOWNWARD FROM ITS POSITION, and
		//  vAnchor "bottom" does not change that. It was declared here on the
		//  assumption that it would -- the canvas renderer does grow a
		//  bottom-anchored block upward -- and the second line landed on top of
		//  "Prefers" one build later. The declaration is gone rather than left in
		//  looking deliberate. A label's y is the TOP of its block.
		//
		//  SO EVERYTHING BELOW IT MOVED DOWN, and by enough for THREE lines
		//  rather than the two English needs. This string is the longest in the
		//  pane and a translation that runs a third of a line longer would
		//  otherwise reproduce exactly the overlap this is fixing.
		"detailsModulesHint" : {
			"type" : "label",
			"petportsString" : "petport.details.moduleshint",
			"position" : [ 126, 164 ],
			"fontSize" : 7,
			"wrapWidth" : 200,
			"color" : [ 120, 126, 134 ],
			"value" : "--",
			"mouseTransparent" : true
		},

		"detailsFlavorLabel" : {
			"type" : "label",
			"position" : [ 126, 128 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"petportsString" : "petport.details.prefers",
			"value" : "--",
			"mouseTransparent" : true
		},
		"detailsFlavorValue" : {
			"type" : "label",
			"position" : [ 126, 116 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "--",
			"mouseTransparent" : true
		},

		//  MANUAL FEEDING IS A DROP ZONE, NOT STORAGE. An itemslot takes one item
		//  at a time, which is exactly right here: the treat is consumed on drop
		//  if the unit has room for it, so the slot never holds anything and
		//  never needs serialising.
		"feedSlot" : {
			"type" : "itemslot",
			"position" : [ 240, 116 ],
			"zlevel" : 2,
			"callback" : "feedSlotClicked",
			"rightClickCallback" : "null"
		},
		"feedHint" : {
			"type" : "label",
			"position" : [ 126, 96 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.cargo.feedhint",
			"value" : "--",
			"mouseTransparent" : true
		},

		"detailsSerial" : {
			"type" : "label",
			"position" : [ 126, 74 ],
			"fontSize" : 7,
			"color" : [ 120, 126, 134 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- SETTINGS tab -------------------------------------------------------
		//
		//  PER-UNIT DISPLAY TOGGLES, DEFAULTED OFF. A base running a dozen units
		//  with permanent bubbles overhead is the exact vanilla ship-pet clutter
		//  this mod exists to avoid, so a player turns them on for the unit they
		//  are currently wondering about.
		"setCarried" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : false,
			"visible" : false,
			"position" : [ 126, 202 ],
			"caption" : "",
			"callback" : "settingToggled"
		},
		//  RENAME MOVED HERE FROM DETAILS, and kept at the same x so the button
		//  lines up with the toggles above it. Details is a readout -- serial,
		//  flavor, modules; renaming CHANGES the unit, which is what this tab is
		//  for.
		//
		//  BELOW THE TOGGLES rather than above them, because it is the only
		//  control here that opens something rather than flipping in place.
		"renameButton" : {
			"type" : "button",
			"base" : "/interface/lofty_petports/petportconfig/tab_base.png",
			"hover" : "/interface/lofty_petports/petportconfig/tab_hover.png",
			"position" : [ 126, 178 ],
			"petportsString" : "petport.details.rename",
			"caption" : "--",
			"callback" : "renameClicked"
		},

		"setCarriedLabel" : {
			"type" : "label",
			"position" : [ 142, 206 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.settings.displaycargo",
			"value" : "--",
			"visible" : false,
			"mouseTransparent" : true
		},

//  CLAIM CROSSHAIRS MOVED TO THE PORT BAND, above the divider, one row
		//  beneath the enabled switch.
		//
		//  They are spawned by the PORT: crosshairRefresh runs off the drops
		//  this port has an opinion about and does not care whether anything is
		//  socketed. A checkbox on the pet tab therefore left an EMPTY port's
		//  markers unswitchable, and tied a port-wide display choice to
		//  whichever unit happened to be plugged in at the time.

				//  TWO TOGGLES REMOVED HERE, AND NEITHER IS COMING BACK.
		//
		//  "Complain when blocked" was unspecified -- it is in no design note,
		//  nothing ever read it, and it existed only in this file.
		//
		//  "May sleep when idle" is real but belongs to the CHASSIS.
		//  petports_allowSleep is a monstertype parameter sitting beside the
		//  collisionPoly and the search costs; a checkbox over the top of it
		//  would be a second authority the monstertype cannot see, and a unit
		//  not built to sleep would be offering an option that does nothing.
		//
		//  What remains is display-only, which is what this tab is for.

		//  ---- STATS tab ----------------------------------------------------------
		//
		//  RATES ARE WHAT IS SHOWN, TOTALS ARE WHAT IS STORED. "4,120 items" is
		//  not a fleet decision; "4,120 items over 3.2 hours active" is. Active
		//  time is the honest denominator because a unit only exists while a
		//  player is in the sector -- the eight hours spent on another planet are
		//  excluded by construction rather than by a rule.
		//
		//  TIDY SCORE COUNTS TYPE-ELIMINATIONS, not entropy in nats. Removing the
		//  last stack of a type from a container is +1. That keeps the one thing
		//  ln(k!) actually bought -- pricing the odd item out of a mixed crate
		//  above five hundred dirt -- and drops the log, the unit nobody can
		//  explain and the question of what 100% would be. Total items moved
		//  already carries volume, so this metric earns its place only by being
		//  the other axis.
		"statsLine1" : { "type" : "label", "position" : [ 126, 206 ], "fontSize" : 7, "color" : [ 190, 196, 204 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine2" : { "type" : "label", "position" : [ 126, 194 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine3" : { "type" : "label", "position" : [ 126, 182 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine4" : { "type" : "label", "position" : [ 126, 170 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine5" : { "type" : "label", "position" : [ 126, 158 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine6" : { "type" : "label", "position" : [ 126, 146 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine7" : { "type" : "label", "position" : [ 126, 134 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },
		"statsLine8" : { "type" : "label", "position" : [ 126, 122 ], "fontSize" : 7, "color" : [ 150, 156, 164 ], "value" : "", "visible" : false, "mouseTransparent" : true },

		//  ---- empty port ---------------------------------------------------------
		//
		//  A PARTIAL OVERLAY, WHICH IS mechassemblygui's PATTERN -- its
		//  imgDisabledOverlay sits at [0, 41] rather than covering the pane, so
		//  the header stays live underneath it.
		//
		//  Here it covers everything BELOW the port band: with nothing socketed,
		//  the pet column and all three tabs have nothing to say, while the
		//  network controls remain meaningful. One image and one flag, rather
		//  than hiding thirty widgets individually and getting one wrong.
		//
		//  NOT BUILT -- the art does not exist yet, so the script hides the pet
		//  column instead and this is the shape it should take.

		"buildStamp" : {
			"type" : "label",
			"position" : [ 122, 34 ],
			"fontSize" : 6,
			"color" : [ 90, 94, 100 ],
			"value" : "",
			"mouseTransparent" : true
		}
	},

	"scripts" : [ "/interface/lofty_petports/petportconfig/petportconfig.lua" ],
	"scriptDelta" : 5,

	//  PANE-LEVEL WIDGETS ONLY. `itemGrid` is absent on purpose -- ContainerPane
	//  registers that name and its `.right` itself.
	//  TOOLTIPS DO NOT WORK WITHOUT THIS, AND THAT IS THE WHOLE OF THE BUG THEY
	//  WERE MISSING FOR.
	//
	//  createTooltip must hand back a WIDGET LAYOUT -- a table the engine builds
	//  a tooltip pane from -- not a string. This pane returned bare strings and
	//  declared no layout, so nothing it hovered ever produced a tooltip: not the
	//  participation boxes, not the diagnostic icons either.
	//
	//  LIFTED VERBATIM FROM THE UPCYCLER, which works, and which in turn took it
	//  from the beacon pane. The art is shared rather than copied -- one
	//  tooltip_body.png for all three panes, so they cannot drift apart visually.
	"tooltipLayout" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "",
			"fileBody" : "/interface/lofty_petports/beaconconfig/tooltip_body.png",
			"fileFooter" : ""
		},
		"title" : {
			"type" : "label",
			"position" : [ 6, 20 ],
			"hAnchor" : "left",
			"wrapWidth" : 112
		},
		"description" : {
			"type" : "label",
			"position" : [ 6, 8 ],
			"hAnchor" : "left",
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"wrapWidth" : 112
		}
	},

	"scriptWidgetCallbacks" : [
		"tabDetailsClicked", "tabSettingsClicked", "tabStatsClicked",
		"cargoTakeClicked",
		"moduleSlotClicked",
		"feedSlotClicked",
		"renameClicked",
		"settingToggled",
		"portEnabledToggled",
		"portCrosshairsToggled",
		"groupToggled"
	]
}
