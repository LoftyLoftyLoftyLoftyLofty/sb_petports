//  PETPORTS -- PETPORT PANE
//
//  A CONTAINER PANE WITH A SCRIPT, the same third thing the upcycler is. See
//  upcyclerconfig.config's header for the reasoning; it applies here unchanged.
//  Container slots AND arbitrary widgets in one window, addressing an entity id
//  so no token system is needed.
//
//  337 x 335 -- header 25 + body 285 + footer 25, so the usable band is
//  y 25..310. Grew by 30 on 2026-08-28: the diagnostics row and its label
//  had been placed at y 12 and y 2, which is INSIDE THE FOOTER -- drawn
//  over the frame and off the bottom of the pane. Height is the free axis
//  here, so the fix was to buy space rather than to squeeze the portrait.
//
//  WIDTH IS THE CONSTRAINT, HEIGHT IS FREE. Force-centering happens when a pane
//  is too wide to sit beside the player's inventory, and the threshold moves
//  with the client window, so it cannot be probed to a number. 337 is the
//  beacon pane's width and is known good in play; 527 is the upcycler's and is
//  known bad. So the mockup's proportions were NOT kept: width came out, height
//  went back in, and the layout is taller relative to its width than the mockup
//  drew it.
//
//  THERE IS NO 19px CONSTRAINT AND THERE NEVER WAS. The beacon body's lower
//  rows carry chest slot shadowing on a 19px repeat, which is what made pane
//  art look like it tiled on a grid. It is art for rows of item slots. This
//  pane has one 1x1 grid, so panetall_body.png is one uniform row tiled to
//  height with no shadow band at all, and it can be any height we like.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT of the footer. Footer 0..25, body
//  25..280, header 280..305. A widget outside that band is not an error -- it
//  is drawn over the frame, or not drawn.
//
//  TITLE AND SUBTITLE BOTH RENDER, AND THAT IS NOT LUCK. ContainerPane
//  overwrites both from the object's `shortdescription` and `category`, unless
//  the object declares NO category -- which the petport already does, on
//  purpose, with a comment in the .object saying so. Putting a category back on
//  the object silently reverts the subtitle to a category label and neither
//  file can express that on its own.
//
//  THE HEADER ICON IS OURS ONLY BECAUSE THE OBJECT SAYS SO. ContainerPane draws
//  its own icon from the object's `inventoryIcon` unless the object sets
//  `hasWindowIcon : false`. The object now does, so the `icon` child below is
//  what renders. Both pointed at the same file on the upcycler, which is why
//  this looked like a partial success there for a while.
//
//  NO WRAPPED LABELS IN THE LEFT COLUMN, DELIBERATELY.
//
//  A wrapped label's position is the BOTTOM of the text block and adding a line
//  pushes the TOP up, so a block that fits today collides the moment the copy
//  grows. The diagnostics readout is therefore a FIXED ROW OF ICONS plus one
//  single-line label: the region's height stops depending on string length, and
//  what bounds it is the number of distinct diagnostic TYPES, which is a small
//  set we control. It also means the layout does not move when the strings are
//  translated.

{
	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/petportconfig/panetall_header.png",
			"fileBody" : "/interface/lofty_petports/petportconfig/panetall_body.png",
			"fileFooter" : "/interface/lofty_petports/petportconfig/panetall_footer.png"
		},

		//  FOUND BY TYPE, NOT BY NAME. Renaming this widget does not stop
		//  ContainerPane finding it -- measured on the upcycler.
		"windowtitle" : {
			"type" : "title",
			"title" : " Petport",
			"subtitle" : " ^#b9b5b2;Configure and deploy pets",
			"icon" : {
				"type" : "image",
				"file" : "/objects/lofty_petports/petport/petports_petporticon.png",
				"zlevel" : -1
			}
		},

		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"pressedOffset" : [ 0, 0 ],
			"position" : [ 315, 316 ],
			"zlevel" : 1
		},

		//  ---- the pet socket ----------------------------------------------------
		//
		//  SLOT 0, AND THE ONLY CONTAINER SLOT THIS OBJECT HAS.
		//
		//  It sits in the PORT band rather than in the pet column on purpose: the
		//  socket has to stay reachable when nothing is home, and everything in
		//  the pet column below is meaningless without a unit. That is also what
		//  lets the empty-port overlay cover the lower pane and leave this alone.
		//
		//  NO CALLBACKS. `itemGrid` is a name ContainerPane registers itself,
		//  along with `itemGrid.right`, so the script supplies nothing. A grid the
		//  script DOES drive needs both names given explicitly -- the right-click
		//  one defaults to "<callback>.right", and a dotted name is unreachable as
		//  a Lua global.
		"itemGrid" : {
			"type" : "itemgrid",
			"position" : [ 16, 270 ],
			"slotOffset" : 0,
			"dimensions" : [ 1, 1 ],
			"spacing" : [ 19, 19 ],
			"backingImage" : "/interface/inventory/empty.png"
		},

		"socketLabel" : {
			"type" : "label",
			"position" : [ 10, 258 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.socket.label",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- the port band -----------------------------------------------------
		//
		//  PORT STATE, NOT PET STATE, and the divider under it is the whole point:
		//  a network id belongs to the port whether or not anything is socketed.
		//
		//  PLACEHOLDER. Network id, participation and the enabled checkbox all
		//  live here and none of them are built -- see "Network control" in the
		//  handoff, which is the largest gap between what the design says and what
		//  is reachable in game.
		//
		//  PARTICIPATION IS BY GROUP, NOT BY TASK. Nine checkboxes do not fit this
		//  band and a player thinks in loops rather than in dispatch branches.
		"portHeading" : {
			"type" : "label",
			"position" : [ 54, 284 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"petportsString" : "petport.port.heading",
			"value" : "--",
			"mouseTransparent" : true
		},

		"portNetworkLabel" : {
			"type" : "label",
			"position" : [ 54, 268 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "id: --",
			"mouseTransparent" : true
		},

		"portEnabled" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 54, 292 ],
			"caption" : "",
			"callback" : "portEnabledToggled"
		},

		//  ---- claim crosshairs ------------------------------------------------
		//
		//  ONE ROW BELOW portEnabled, same 54/70 column, same 16px row pitch the
		//  participation grid uses. The 9px box spans 246..255 -- clear of
		//  socketLabel at [10,258], which is a different column, and clear of
		//  the tab row at y 224.
		//
		//  A PORT SETTING, NOT A PET ONE. See CROSSHAIRS_KEY in
		//  petports_petport.lua.
		"portCrosshairs" : {
			"type" : "button",
			"petportsTip" : "petport.tip.crosshairs",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 178, 248 ],
			"caption" : "",
			"callback" : "portCrosshairsToggled"
		},
		"portCrosshairsLabel" : {
			"type" : "label",
			"position" : [ 194, 252 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.port.crosshairs",
			"value" : "--",
			"mouseTransparent" : true
		},

		"portEnabledLabel" : {
			"type" : "label",
			"position" : [ 70, 296 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.port.enabled",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- participation ------------------------------------------------
		//
		//  FOUR BOXES IN READING ORDER: item pickup, sorting / farming,
		//  machines.
		//
		//  THE FIRST BOX'S WIDGET IS groupHauling AND ITS LABEL IS "Item
		//  Pickup". The key is frozen because a stored setting names it; the
		//  label is free because nothing persists it -- the same split the
		//  filter manifest uses, where a subgroup with id "unit" reads "Pets".
		//
		//  THE SPLIT BETWEEN THE FIRST TWO IS INGRESS: pickup is how something
		//  ENTERS the network, sorting is everything done to what is already
		//  inside it.
		//  The checkbox art is 9px and the label sits 16px right of it, so the
		//  column pitch is 80 and the row pitch is 16.
		//
		//  BY GROUP, NOT BY TASK. Fourteen work generators feed these four
		//  boxes -- see petportParticipates in petports_petport.lua for the
		//  mapping. Nine or fourteen checkboxes do not fit this band and nobody
		//  thinks in dispatch branches.
		//
		//  TWO GENERATORS ARE IN NO GROUP. The leash is always available, and so
		//  is deposit: gating the unload path deadlocks a unit that is holding
		//  cargo, because findWork returns outright in that state.
		//
		//  TOOLTIP TEXT IS NOT HERE AND NEITHER IS THE WIDGET IT SITS ON. Each
		//  checkbox names a KEY as `petportsTip` and the words live in
		//  petports_strings.config; a ContainerPane never calls createTooltip, so
		//  the hover layer further down this file draws them by hand.
		//
		//  HOSTED ON THE CHECKBOX. The labels stay mouseTransparent, so hovering
		//  the word does nothing. Dropping that flag on these four would make the
		//  label hoverable too, and is the change to make if the 9px box proves a
		//  fiddly target.
		//
		//  ---- THE TWO COLUMNS SHARE THEIR BASELINES ----
		//
		//  Heading row 296, then rows at 284, 268 and 252. A checkbox sits 4px
		//  under its own label, so a box on row N is at N - 4.
		//
		//  THE LEFT COLUMN IS THE PORT'S IDENTITY -- its own switch, then what it
		//  is: Port enabled, Network, id. It stops at row 268.
		//
		//  THE TWO COLUMNS ARE SPLIT BY WHAT THE PLAYER SEES, NOT BY WHAT THE
		//  CODE OWNS, and that is why Claim Markers is on the right.
		//
		//  Left is invisible functionality: whether the port runs at all, and
		//  which network it belongs to. Nothing there produces anything you can
		//  point at in the world. Right is the opposite -- tick a box, watch
		//  something start happening on screen.
		//
		//  TECHNICALLY Claim Markers belongs on the left. It is a PORT setting,
		//  stored beside enabled and participation, and it gates no work. But it
		//  is the most immediately visible switch in the pane, so it sits with the
		//  task toggles at x 178, one row clear of them at 252. Anyone tidying
		//  this band by ownership will move it and make the pane worse.
		"portTasksLabel" : {
			"type" : "label",
			"position" : [ 178, 296 ],
			"fontSize" : 7,
			"color" : [ 190, 196, 204 ],
			"petportsString" : "petport.port.tasks",
			"value" : "--",
			"mouseTransparent" : true
		},

		"groupHauling" : {
			"type" : "button",
			"petportsTip" : "petport.tip.hauling",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 178, 280 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupHaulingLabel" : {
			"type" : "label",
			"position" : [ 194, 284 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.group.hauling",
			"value" : "--",
			"mouseTransparent" : true
		},

		"groupSorting" : {
			"type" : "button",
			"petportsTip" : "petport.tip.sorting",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 258, 280 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupSortingLabel" : {
			"type" : "label",
			"position" : [ 274, 284 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.group.sorting",
			"value" : "--",
			"mouseTransparent" : true
		},

		"groupFarming" : {
			"type" : "button",
			"petportsTip" : "petport.tip.farming",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 178, 264 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupFarmingLabel" : {
			"type" : "label",
			"position" : [ 194, 268 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.group.farming",
			"value" : "--",
			"mouseTransparent" : true
		},

		"groupMachines" : {
			"type" : "button",
			"petportsTip" : "petport.tip.machines",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 258, 264 ],
			"caption" : "",
			"callback" : "groupToggled"
		},
		"groupMachinesLabel" : {
			"type" : "label",
			"position" : [ 274, 268 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"petportsString" : "petport.group.machines",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- the pet column ----------------------------------------------------
		//
		//  ALWAYS VISIBLE, NEVER IN A TAB. Name, fuel, cargo and current task are
		//  what a player opens this pane to see, so none of them are ever a click
		//  away.

		"petName" : {
			"type" : "label",
			"position" : [ 8, 226 ],
			"fontSize" : 10,
			"color" : [ 255, 255, 255 ],
			"value" : "No unit",
			"mouseTransparent" : true
		},

		//  THE SPECIES, SHOWN ONLY WHEN THE NAME IS NOT THE DEFAULT. Which means
		//  the default has to be knowable -- see petportconfig.lua, where it comes
		//  from the monstertype rather than from a stored copy, so a renamed unit
		//  cannot drift from what its species is actually called.
		"petSpecies" : {
			"type" : "label",
			"position" : [ 8, 216 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  THE PORTRAIT IS A CANVAS, NOT AN ICON, which is the mech assembly
		//  station's pattern: bindCanvas, then drawImage with the part's own
		//  directives applied. That means the portrait shows the ACTUAL unit --
		//  its chassis colour strip now, its monsterpart variant when several
		//  exist -- rather than four hand-drawn icons that go stale at the art
		//  pass.
		//
		//  REDRAWN ON CHANGE, NEVER PER TICK. mechassemblygui's update(dt) is
		//  empty and updatePreview is called from init and from the two change
		//  handlers. Gating a canvas REDRAW is safe; gating a widget's VISIBILITY
		//  is what latched the upcycler's blips invisible forever.
//  ---- the hover layer ---------------------------------------------------
		//
		//  THIS PANE CANNOT HAVE ENGINE TOOLTIPS, SO IT DRAWS ITS OWN.
		//
		//  createTooltip is the only script route the engine offers -- a grep of
		//  the whole asset tree turns up no widget-level tooltip field -- and a
		//  ContainerPane does not forward it to the script. MEASURED: the beacon
		//  panes (interactAction "ScriptPane") show script tooltips; this pane
		//  and the upcycler (uiConfig, so ContainerPane) show none at all. The
		//  only tooltips either ContainerPane produces are the item ones that
		//  ItemSlotWidget draws for itself.
		//
		//  So the cursor is tracked on a canvas and the tooltip is drawn by
		//  hand, which is what /interface/easel/signstoregui.lua does for its
		//  entire UI.
		//
		//  captureMouseEvents IS FALSE AND MUST STAY FALSE. The easel sets it
		//  true because it wants the clicks and draws its own buttons; this layer
		//  sits OVER real widgets and must not eat theirs. MEASURED: mousePosition
		//  reports on a non-capturing canvas -- that probe is the only reason
		//  this approach is here rather than abandoned.
		//
		//  FULL-PANE AND TOPMOST. Canvas coordinates are canvas-local, so an
		//  origin at [0,0] makes them identical to widget positions and the hit
		//  rects can be read straight off the widgets with getPosition/getSize
		//  rather than transcribed.
		//  TWO CANVASES, AND THE SPLIT IS THE WHOLE POINT.
		//
		//  MEASURED: a full-pane canvas at zlevel 30 gave us hover tooltips and
		//  took away every ITEM tooltip in the pane -- the socket and the module
		//  slots went dead. captureMouseEvents was already false, so capture is
		//  not what does it; being ON TOP is. The sign store works around this by
		//  putting its dispenser in a separate container with a separate UI,
		//  which now reads less like a design choice and more like a surrender.
		//
		//  SO: ONE CANVAS TRACKS AND ONE DRAWS.
		//
		//  hoverCanvas sits UNDER everything, including the background, and is
		//  never drawn on. It exists only to answer "where is the cursor".
		//  Whether a buried canvas still reports is the open question this build
		//  is measuring; if it does, nothing it covers can be occluded, because
		//  it is beneath the art.
		//
		//  tipCanvas is small, topmost, and HIDDEN until there is something to
		//  say -- then it is moved to the cursor. It can only occlude the patch
		//  it currently occupies, and it only occupies anything while a tooltip
		//  is already up.
		"hoverCanvas" : {
			"type" : "canvas",
			"rect" : [ 0, 0, 337, 320 ],
			"zlevel" : -5,
			"captureMouseEvents" : false,
			"captureKeyboardEvents" : false
		},
		"tipCanvas" : {
			"type" : "canvas",
			"rect" : [ 0, 0, 150, 80 ],
			"zlevel" : 30,
			"visible" : false,
			"captureMouseEvents" : false,
			"captureKeyboardEvents" : false
		},

		//  ---- the text measurement labels ----------------------------------
		//
		//  NEITHER IS EVER DRAWN. They exist because a canvas cannot measure
		//  text and a LABEL can: setText, then getSize, reports the bounds of
		//  the text it just laid out, which is what sizes the tooltip box.
		//
		//  MEASURED, in the probe build: four bodies at a 140px wrap returned
		//  133x25, 137x16, 127x25 and 139x25 -- widths that track the string,
		//  heights that fit 7 + (n - 1) * 9. A hidden label lays out (the
		//  visible alpha-zero twin this replaced agreed on all four), and there
		//  is no frame lag.
		//
		//  WHY THIS AND NOT A CHARACTER COUNT: the estimate it replaced was
		//  4.3px per character, and the four bodies above imply 3.89, 4.44,
		//  5.53 and 5.53 -- because WRAPPING BREAKS ON WORD BOUNDARIES. It was
		//  unfixable in English before ever reaching a translator.
		//
		//  TWO OF THEM, ONE PER FONT SIZE. The body wraps at 7 and the title is
		//  one unwrapped line at 8. Measuring only the body would leave the
		//  title height an authored English constant.
		//
		//  wrapWidth MATCHES TIP_WRAP, 150 - 5 * 2. If the two ever disagree the
		//  measurement describes a box that is not the one being drawn.
		"tipMeasure" : {
			"type" : "label",
			"position" : [ 8, 120 ],
			"fontSize" : 7,
			"wrapWidth" : 140,
			"value" : "",
			"visible" : false,
			"mouseTransparent" : true
		},
		"tipMeasureTitle" : {
			"type" : "label",
			"position" : [ 8, 120 ],
			"fontSize" : 8,
			"value" : "",
			"visible" : false,
			"mouseTransparent" : true
		},

		"petPreview" : {
			"type" : "canvas",
			"rect" : [ 8, 134, 114, 210 ],
			"zlevel" : 1,
			"captureMouseEvents" : false,
			"captureKeyboardEvents" : false
		},

		//  ---- fuel ---------------------------------------------------------------
		//
		//  EIGHT BLIPS, RECOLOURED, NEVER HIDDEN. Same sprite and same count as
		//  the upcycler's reagent charge, so one convention serves both panes.
		//
		//  RECOLOUR RATHER THAN SHOW/HIDE IS ALSO THE SAFE CHOICE: the upcycler's
		//  blips were latched invisible by a change gate that outlived the
		//  widget's visibility. A setImage cannot be stranded that way.
		//
		//  THE DECLARED FILE MUST STAY BARE. Directives COMPOUND -- a "?multiply="
		//  written here is not replaced by the one the script supplies, it
		//  multiplies with it.
		"fuelBlip1" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 8, 120 ], "mouseTransparent" : true },
		"fuelBlip2" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 13, 120 ], "mouseTransparent" : true },
		"fuelBlip3" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 18, 120 ], "mouseTransparent" : true },
		"fuelBlip4" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 23, 120 ], "mouseTransparent" : true },
		"fuelBlip5" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 28, 120 ], "mouseTransparent" : true },
		"fuelBlip6" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 33, 120 ], "mouseTransparent" : true },
		"fuelBlip7" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 38, 120 ], "mouseTransparent" : true },
		"fuelBlip8" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 43, 120 ], "mouseTransparent" : true },
		"fuelBlip9" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 48, 120 ], "mouseTransparent" : true },
		"fuelBlip10" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 53, 120 ], "mouseTransparent" : true },
		"fuelBlip11" : { "type" : "image", "file" : "/interface/lofty_petports/petportconfig/fuelblip.png", "position" : [ 58, 120 ], "mouseTransparent" : true },
