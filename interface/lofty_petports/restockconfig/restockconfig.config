//  PETPORTS -- RESTOCK BEACON CONFIGURATION PANE
//
//  Opened by petports_beacon.lua via activeItem.interact("ScriptPane", <this>).
//  The item-side protocol -- token, read, write, heartbeat -- is identical to
//  the deposit beacon's and documented in petports_beacon.lua. Only the widgets
//  and the fields differ.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT, and pane size comes from the
//  background images. A widget positioned outside them does not error, it
//  simply is not drawn.
//
//  THE FRAME IS THE WIDE PANE, SLICED DOWN. panewide_* is 337x274 and this
//  pane holds one itemslot and three number rows, which would leave most of it
//  empty. panesmall_* is 204x190, cut from the same art rather than drawn or
//  scaled:
//
//    Header and footer are uniform across a long column run, so 133 identical
//    columns come straight out of the middle.
//
//    The BODY repeats every 19px from x=21, so it loses SEVEN WHOLE PERIODS --
//    133 again -- and the joins land exactly on the pattern. Verified: every
//    remaining period is byte-identical to the source period.
//
//    Vertically the body's top 145 rows are all identical, so 84 come out of
//    that block and the patterned lower band is untouched.
//
//  Usable width is about 198; the band is y 25..165 with the header above it.
//  Redo the slice, do not scale, and move in whole 19px periods horizontally.
//
//  OPEN WITH THE INVENTORY, AND THIS IS LOAD-BEARING RATHER THAN A COURTESY.
//
//  The itemslot is configured by putting an item on the CURSOR and clicking it,
//  and there is no way to get an item onto the cursor without the inventory
//  open. Copied from vanilla's mechassemblygui.config, which has an itemslot
//  for the same reason.
//
//  UNVERIFIED: that key is honoured on a pane opened by activeItem.interact
//  rather than by an object interaction. If it is not, the pane still works --
//  the player opens their inventory themselves -- so this degrades to an
//  annoyance rather than a broken feature. Confirm it on first run.
//
//  THE SLOT SAMPLES, IT DOES NOT TAKE. See restockconfig.lua: the beacon needs
//  a NAME, not an item, so the player's sample stays on their cursor. That is
//  the one place this pane deliberately diverges from mechassemblygui.lua,
//  which genuinely stores the mech part it is handed.

{
	"openWithInventory" : true,

	//  WHICH ITEM THIS PANE BELONGS TO.
	//
	//  Read by init() to work out whether the beacon was used from the SWAP
	//  SLOT rather than the hotbar, which is a configuration this pane cannot
	//  support -- see hotbarOnlyMessage.
	//
	//  A config field rather than a constant in the Lua because the pane script
	//  is otherwise free of any knowledge of which .activeitem opened it, and
	//  keeping it that way means a second restock-shaped beacon needs no fork.
	"beaconItemName" : "petports_beacon_restock",

	//  SHOWN WHEN THE BEACON IS USED FROM THE SWAP SLOT.
	//
	//  Starbound locks the inventory's category tabs while an item is on the
	//  cursor -- that is what stops a player parking a rifle in a food slot,
	//  and it is not something a mod should be trying to defeat. The side
	//  effect is that a beacon held on the cursor can only ever see items in
	//  its OWN category, which is most of the game's items ruled out.
	//
	//  So the pane refuses, and says why. Keyed by species so that a species
	//  mod can patch in a line in its own voice; "default" is what everyone
	//  else gets.
	//
	//  AN ARRAY OF LINES, NOT ONE STRING. The first attempt was a single
	//  sentence written into the summary label, and it ran off the side of the
	//  pane: nothing here has a wrapWidth, deliberately -- see the summary
	//  widget for why a wrapped label grows UPWARDS into whatever sits above
	//  it. Splitting the message is the author's job because only the author
	//  knows where it reads well. A plain string still works and renders on one
	//  line.
	//
	//  NO SPECIES ENTRIES SHIPPED HERE. This mod is standalone and Nicemice
	//  flavour text living in it is exactly the decoupling debt the handoff
	//  already tracks. A mod adds one with
	//  /hotbarOnlyMessage/<species> and nothing here changes.
	"hotbarOnlyMessage" : {
		"default" : [
			"Use this from your hotbar.",
			"Held on the cursor, it cannot see every item."
		]
	},

	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/restockconfig/panesmall_header.png",
			"fileBody" : "/interface/lofty_petports/restockconfig/panesmall_body.png",
			"fileFooter" : "/interface/lofty_petports/restockconfig/panesmall_footer.png"
		},

		//  TOP RIGHT, in the title bar. Derived from the deposit pane's
		//  calibrated position rather than guessed again: there the body top is
		//  249 and the button sits at y=255, and the right edge is width minus
		//  22. Same two offsets against this frame's 165 and 204.
		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"position" : [ 182, 171 ],
			"zlevel" : 1
		},

		//  NO POSITION, unlike the deposit pane's title.
		//
		//  A "title" positions by its own rules and does not live in the same
		//  space as everything else -- the deposit pane says so. Its [-3, 80]
		//  was tuned against a 274-tall frame and means nothing against a
		//  190-tall one. Vanilla's mechassemblygui omits the field entirely and
		//  renders correctly, so that is what this does.
		"title" : {
			"type" : "title",
			"title" : "Beacon",
			"subtitle" : "Restock request"
		},

		//  ---- beacon on/off -------------------------------------------------
		//
		//  Same parameter, same meaning, same handler as the deposit pane:
		//  beaconBehaviorOf on the port treats an off beacon as NOT A BEACON,
		//  so an off restock beacon is an ordinary item and its crate requests
		//  nothing.

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 144 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 146 ],
			"value" : "Beacon active",
			"mouseTransparent" : true
		},

		//  ---- the requested item --------------------------------------------

		"requestHeading" : {
			"type" : "label",
			"position" : [ 10, 128 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "Requested item",
			"mouseTransparent" : true
		},

		//  BACKING IMAGE AS A SEPARATE WIDGET, not a field on the itemslot.
		//
		//  Whether "itemslot" accepts a backing image of its own is not
		//  something this mod knows, and a wrong key is silently ignored, which
		//  would leave an invisible slot that looks like a layout bug. Vanilla's
		//  mech assembly draws its slot outlines as ordinary art UNDERNEATH the
		//  itemslots -- imgWireframe at zlevel 0, slots at zlevel 2 -- so this
		//  does the same with a widget type that is not in doubt.
		"slotBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/slot_backing.png",
			"position" : [ 10, 100 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		"itemSlot_request" : {
			"type" : "itemslot",
			"zlevel" : 2,
			"position" : [ 10, 100 ],
			"callback" : "requestSlotClicked",
			"rightClickCallback" : "requestSlotCleared"
		},

		"requestName" : {
			"type" : "label",
			"position" : [ 34, 112 ],
			"value" : "",
			"mouseTransparent" : true
		},

		"requestHint" : {
			"type" : "label",
			"position" : [ 34, 102 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- the quota -----------------------------------------------------
		//
		//  MIN AND MAX, NOT ONE NUMBER. A single quota thrashes: fetch one item,
		//  drop below it, fetch another. Min is when to START and max is when to
		//  STOP, and the gap between them is what turns forty one-item trips
		//  into one trip.
		//
		//  TYPED, NOT STEPPED. An earlier build had arrow buttons plus a shared
		//  step row cycling 1 / 10 / 100 / one stack, because whether "textbox"
		//  was constructible in a ScriptPane was not known here and an
		//  unrecognised widget type fails at CONSTRUCTION -- the pane then does
		//  not open at all, which is the worst failure shape available.
		//
		//  Vanilla's pixel printer settles it. It carries both:
		//
		//    "spinCount"   : { "type" : "spinner", "upOffset" : 36 }
		//    "tbSpinCount" : { "type" : "textbox", "textAlign" : "center",
		//                      "maxWidth" : 16, "regex" : "x?\\d{0,4}" }
		//
		//  so `regex` really is an input filter and a textbox really does work
		//  in a pane. Typing 2000 beats twenty clicks, and the arrows and the
		//  whole step row come out.
		//
		//  FOUR DIGITS, WHICH IS WHERE QUOTA_CEILING COMES FROM. The regex is
		//  the pixel printer's minus its leading `x?` -- that character is its
		//  multiplier display, not ours. \d{0,4} caps entry at 9999 at the
		//  KEYSTROKE, so the script never sees a number it has to reject, and
		//  restockconfig.lua's ceiling is set to match rather than to differ.
		//
		//  NO SPINNER, FOR NOW. The pixel printer's config names no callback on
		//  either widget, so how a spinner reports a click -- and whether it
		//  drives the textbox beside it or the script wires the two together --
		//  is not answered by what we can see. The script polls the textbox
		//  instead, which needs no answer to that question. Adding the spinner
		//  later is two widgets and changes nothing below them.
		//
		//  BACKING IMAGES, for the same reason the itemslot has one: an empty
		//  textbox with no frame is invisible, and a player cannot click what
		//  they cannot see.

		//  A TEXTBOX CALLBACK IS NOT OPTIONAL, AND OMITTING IT IS A CRASH.
		//
		//  Measured, from the first launch of this pane:
		//
		//    (WidgetParserException) Failed to find textbox callback named:
		//    'tbMin'
		//
		//  Note the NAME. Nothing had asked for a callback called tbMin -- that
		//  is the WIDGET's name. So the parser defaults a textbox's callback
		//  name to the widget's own name and then requires it to resolve, which
		//  makes "no callback field" mean "a callback named after me" rather
		//  than "no callback". The pixel printer's textbox declares none, so its
		//  pane must be listing tbSpinCount in scriptWidgetCallbacks.
		//
		//  Declared explicitly here instead. Both spellings work; a name that
		//  says what it does beats one that happens to match a widget id, and
		//  it keeps this pane consistent with every other widget in the mod.
		//
		//  THIS IS A CONSTRUCTION-TIME FAILURE, WHICH IS THE BAD KIND. The pane
		//  does not open at all and the client throws in its main loop -- the
		//  same shape as the row-callback problem the deposit pane's header
		//  records, and the reason that header argues against unverified widget
		//  types.

		"minLabel" : {
			"type" : "label",
			"position" : [ 10, 78 ],
			"value" : "Fetch below",
			"mouseTransparent" : true
		},
		"minFieldBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 108, 74 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},
		"tbMin" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 110, 78 ],
			"textAlign" : "center",
			"maxWidth" : 30,
			"regex" : "\\d{0,4}",
			"hint" : "",
			"callback" : "minChanged"
		},

		"maxLabel" : {
			"type" : "label",
			"position" : [ 10, 58 ],
			"value" : "Fill up to",
			"mouseTransparent" : true
		},
		"maxFieldBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 108, 54 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},
		"tbMax" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 110, 58 ],
			"textAlign" : "center",
			"maxWidth" : 30,
			"regex" : "\\d{0,4}",
			"hint" : "",
			"callback" : "maxChanged"
		},

		//  ---- the refusal notice ---------------------------------------------
		//
		//  Hidden in normal use, and the only thing visible when the pane was
		//  opened from the cursor. See lockWithNotice.
		//
		//  AT x=10 RATHER THAN REUSING requestName AND requestHint. Those two
		//  are indented to clear the itemslot, and with the slot hidden they
		//  read as text floating in from nowhere. These get the full width,
		//  which is also what stops the message running off the frame.
		//
		//  NO wrapWidth, like everything else on this pane. The author splits
		//  the message into lines; see hotbarOnlyMessage above.

		"noticeTitle" : {
			"type" : "label",
			"position" : [ 10, 112 ],
			"value" : "",
			"mouseTransparent" : true
		},
		"noticeLineOne" : {
			"type" : "label",
			"position" : [ 10, 96 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		},
		"noticeLineTwo" : {
			"type" : "label",
			"position" : [ 10, 86 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ONE LINE, TRUNCATED IN LUA RATHER THAN WRAPPED.
		//
		//  The deposit pane learned that a wrapped label draws its first line
		//  ABOVE its position, which inside a 16px row put text over whatever
		//  sat above it. Nothing here is in a row, but the same upward growth
		//  would run this summary into the step arrows. So: no wrapWidth, and
		//  the script clips the string instead.
		"summary" : {
			"type" : "label",
			"position" : [ 10, 36 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		}
	},

	"scripts" : [ "/interface/lofty_petports/restockconfig/restockconfig.lua" ],
	"scriptDelta" : 1,

	//  Every callback named above must appear here or the widget silently does
	//  nothing when clicked -- except a textbox, which does not fail silently
	//  at all. See tbMin: an unresolvable textbox callback throws in the client
	//  main loop and the pane never opens.
	//
	//  THESE ARE NOT REGISTERED IN init(). widget.registerMemberCallback is for
	//  widgets inside a ListWidget's rows, which are built by a different
	//  parser -- see the deposit pane's header. Pane-level widgets like these
	//  register here and only here.
	"scriptWidgetCallbacks" : [
		"enabledToggled",
		"requestSlotClicked",
		"requestSlotCleared",
		"minChanged",
		"maxChanged"
	]
}
