//  PETPORTS -- RESTOCK BEACON CONFIGURATION PANE
//
//  Opened by petports_beacon.lua via activeItem.interact("ScriptPane", <this>).
//  The item-side protocol -- token, read, write, heartbeat -- is identical to
//  the deposit beacon's and documented in petports_beacon.lua. Only the widgets
//  and the fields differ.
//
//  COORDINATES RUN FROM THE BOTTOM-LEFT, and pane size comes from the
//  background images. A widget positioned outside them does not error, it
//  simply is not drawn.
//
//  THE FRAME IS THE WIDE PANE, SLICED DOWN. panewide_* is 337x274 and this
//  pane holds one itemslot and three number rows, which would leave most of it
//  empty. panesmall_* is 204x190, cut from the same art rather than drawn or
//  scaled:
//
//    Header and footer are uniform across a long column run, so 133 identical
//    columns come straight out of the middle.
//
//    The BODY repeats every 19px from x=21, so it loses SEVEN WHOLE PERIODS --
//    133 again -- and the joins land exactly on the pattern. Verified: every
//    remaining period is byte-identical to the source period.
//
//    Vertically the body's top 145 rows are all identical, so 84 come out of
//    that block and the patterned lower band is untouched.
//
//  Usable width is about 198; the band is y 25..165 with the header above it.
//  Redo the slice, do not scale, and move in whole 19px periods horizontally.
//
//  OPEN WITH THE INVENTORY, AND THIS IS LOAD-BEARING RATHER THAN A COURTESY.
//
//  The itemslot is configured by putting an item on the CURSOR and clicking it,
//  and there is no way to get an item onto the cursor without the inventory
//  open. Copied from vanilla's mechassemblygui.config, which has an itemslot
//  for the same reason.
//
//  UNVERIFIED: that key is honoured on a pane opened by activeItem.interact
//  rather than by an object interaction. If it is not, the pane still works --
//  the player opens their inventory themselves -- so this degrades to an
//  annoyance rather than a broken feature. Confirm it on first run.
//
//  THE SLOT SAMPLES, IT DOES NOT TAKE. See restockconfig.lua: the beacon needs
//  a NAME, not an item, so the player's sample stays on their cursor. That is
//  the one place this pane deliberately diverges from mechassemblygui.lua,
//  which genuinely stores the mech part it is handed.

{
	"openWithInventory" : true,

	//  WHICH ITEM THIS PANE BELONGS TO.
	//
	//  Read by init() to work out whether the beacon was used from the SWAP
	//  SLOT rather than the hotbar, which is a configuration this pane cannot
	//  support -- see hotbarOnlyMessage.
	//
	//  A config field rather than a constant in the Lua because the pane script
	//  is otherwise free of any knowledge of which .activeitem opened it, and
	//  keeping it that way means a second restock-shaped beacon needs no fork.
	"beaconItemName" : "petports_beacon_restock",

	//  SHOWN WHEN THE BEACON IS USED FROM THE SWAP SLOT.
	//
	//  Starbound locks the inventory's category tabs while an item is on the
	//  cursor -- that is what stops a player parking a rifle in a food slot,
	//  and it is not something a mod should be trying to defeat. The side
	//  effect is that a beacon held on the cursor can only ever see items in
	//  its OWN category, which is most of the game's items ruled out.
	//
	//  So the pane refuses, and says why. Keyed by species so that a species
	//  mod can patch in a line in its own voice; "default" is what everyone
	//  else gets.
	//
	//  AN ARRAY OF LINES, NOT ONE STRING. The first attempt was a single
	//  sentence written into the summary label, and it ran off the side of the
	//  pane: nothing here has a wrapWidth, deliberately -- see the summary
	//  widget for why a wrapped label grows UPWARDS into whatever sits above
	//  it. Splitting the message is the author's job because only the author
	//  knows where it reads well. A plain string still works and renders on one
	//  line.
	//
	//  NO SPECIES ENTRIES SHIPPED HERE. This mod is standalone and Nicemice
	//  flavour text living in it is exactly the decoupling debt the handoff
	//  already tracks. A mod adds one with
	//  /hotbarOnlyMessage/<species> and nothing here changes.
	"hotbarOnlyMessage" : {
		"default" : [
			"Use this from your hotbar.",
			"Held on the cursor, it cannot see every item."
		]
	},

	"gui" : {
		"background" : {
			"type" : "background",
			"fileHeader" : "/interface/lofty_petports/restockconfig/panesmall_header.png",
			"fileBody" : "/interface/lofty_petports/restockconfig/panesmall_body.png",
			"fileFooter" : "/interface/lofty_petports/restockconfig/panesmall_footer.png"
		},

		//  TOP RIGHT, in the title bar. Derived from the deposit pane's
		//  calibrated position rather than guessed again: there the body top is
		//  249 and the button sits at y=255, and the right edge is width minus
		//  22. Same two offsets against this frame's 165 and 204.
		"close" : {
			"type" : "button",
			"base" : "/interface/x.png",
			"hover" : "/interface/xhover.png",
			"pressed" : "/interface/xpress.png",
			"position" : [ 182, 255 ],
			"zlevel" : 1
		},

		//  NO POSITION, unlike the deposit pane's title.
		//
		//  A "title" positions by its own rules and does not live in the same
		//  space as everything else -- the deposit pane says so. Its [-3, 80]
		//  was tuned against a 274-tall frame and means nothing against a
		//  190-tall one. Vanilla's mechassemblygui omits the field entirely and
		//  renders correctly, so that is what this does.
		"title" : {
			"type" : "title",
			"title" : "Beacon",
			"subtitle" : "Restock request"
		},

		//  ---- beacon on/off -------------------------------------------------
		//
		//  Same parameter, same meaning, same handler as the deposit pane:
		//  beaconBehaviorOf on the port treats an off beacon as NOT A BEACON,
		//  so an off restock beacon is an ordinary item and its crate requests
		//  nothing.

		"enabledCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 10, 228 ],
			"callback" : "enabledToggled"
		},

		"enabledLabel" : {
			"type" : "label",
			"position" : [ 26, 230 ],
			"petportsString" : "common.beaconactive",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ---- the request list ------------------------------------------------
		//
		//  ONE BEACON, MANY REQUESTS. It was one item per beacon first, and the
		//  obvious workaround -- several beacons in one crate -- fails on the case
		//  that prompted it: twenty building materials would mean twenty beacons
		//  AND twenty stacks competing for the same slots in one chest.
		//
		//  THE PANE IS FULL HEIGHT AGAIN. panesmall_body was trimmed to 140 rows
		//  when this held a single request; the list needs the room back, so it is
		//  re-cut from panewide_body at the full 224 with the same seven-period
		//  horizontal slice. Band is y 25..249, as on the deposit pane.
		//
		//  THE ITEMSLOT IS AN ADD BUTTON. Clicking it with an item on the cursor
		//  appends a request; the item is sampled, never taken. Naming an item
		//  already in the list selects that row instead of duplicating it.
		//
		//  NO ICON IN THE ROW, FOR NOW. Whether an "itemslot" can be built inside
		//  a listTemplate is unverified, and an unknown widget in a row fails at
		//  CONSTRUCTION -- addListItem throws and takes the pane with it, which
		//  would block testing the whole feature rather than just the icon. The
		//  row label carries the item's shortdescription instead.

//  ---- pet feeder --------------------------------------------------------
		//
		//  BESIDE "Beacon active" RATHER THAN BELOW IT, which is what keeps this
		//  pane's layout untouched. "Beacon active" ends near x 81 and the request
		//  list runs to x 196, so a second box at 110 with its label reaching
		//  roughly 170 fits the row with room to spare. No vertical space is
		//  spent: requestHeading, the list, the slot and both fields stay put.
		//
		//  DEFAULTS ON, matching the deposit beacon and the port switches.
		//  Absent means on.
		//
		//  INERT UNTIL THE FUEL SYSTEM EXISTS -- treats accumulate and nothing
		//  eats one yet.
		"feederCheckbox" : {
			"type" : "button",
			"base" : "/interface/optionsmenu/checkboxnocheck.png",
			"hover" : "/interface/optionsmenu/checkboxnocheckhover.png",
			"baseImageChecked" : "/interface/optionsmenu/checkboxcheck.png",
			"hoverImageChecked" : "/interface/optionsmenu/checkboxcheckhover.png",
			"checkable" : true,
			"checked" : true,
			"position" : [ 110, 228 ],
			"caption" : "",
			"callback" : "feederToggled"
		},
		"feederLabel" : {
			"type" : "label",
			"position" : [ 126, 230 ],
			"petportsString" : "common.petfeeder",
			"value" : "--",
			"mouseTransparent" : true
		},

				"requestHeading" : {
			"type" : "label",
			"position" : [ 10, 214 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"petportsString" : "restock.heading",
			"value" : "--",
			"mouseTransparent" : true
		},

		//  ROW CALLBACKS ARE REGISTERED AT RUNTIME, never from
		//  scriptWidgetCallbacks. A row widget naming a pane callback cannot be
		//  BUILT -- WidgetParser throws at construction, because ListWidget uses a
		//  different parser that has never heard of those names. See the deposit
		//  pane's header, and registerRowCallbacks in the script.
		"requestsScroll" : {
			"type" : "scrollArea",
			"rect" : [ 8, 120, 196, 212 ],
			"children" : {
				"requestsList" : {
					"type" : "list",
					"callback" : "requestSelected",
					"schema" : {
						//  ROW ART IS OURS AND IS SIZED TO memberSize.
						//
						//  These pointed at vanilla's crafting backgrounds --
						//  craftableselected2 and craftablebackground -- which
						//  are cut for crafting rows, not for a 16px one, and
						//  were being asked to serve three DIFFERENT widths
						//  across this mod's lists. However the engine resolves
						//  that, stretch or native, it cannot be right at all
						//  three, and the result was a selection you had to look
						//  for.
						//
						//  One pair per memberSize, generated to match exactly.
						//  Unselected is a barely-there fill that only marks
						//  where a row ends; selected is a raised bar with a
						//  lit top edge and a shadowed base.
						//
						//  THE SCHEMA HAS NO PER-ROW BACKGROUND, so alternating
						//  colours are not expressible here -- both keys apply
						//  to every row. Striping would need an image widget
						//  inside listTemplate set by index parity, which is a
						//  separate question: an unknown widget type in a row
						//  fails at CONSTRUCTION and takes the pane with it.
						"selectedBG" : "/interface/lofty_petports/shared/row_180_selected.png",
						"unselectedBG" : "/interface/lofty_petports/shared/row_180.png",
						"spacing" : [ 0, 1 ],
						"memberSize" : [ 180, 16 ],
						"listTemplate" : {
							//  A BACKGROUND IMAGE INSIDE THE ROW, WHICH IS HOW
							//  VANILLA DOES IT.
							//
							//  The schema's selectedBG and unselectedBG were set
							//  on every list in this mod -- first at vanilla's
							//  crafting art, then at art generated to each
							//  list's exact memberSize -- and neither produced
							//  anything on screen. No asset error, no parse
							//  error, both panes built.
							//
							//  crafting.config and vendingmachine.config both
							//  carry a `background` image at zlevel -1 in their
							//  listTemplate alongside those same schema keys. So
							//  the row art is drawn by a widget the script can
							//  address, not by the schema -- which also means
							//  ALTERNATING rows are expressible, since the file
							//  is set per row rather than per list.
							//
							//  The schema keys stay, pointed at the same art,
							//  because vanilla keeps both and removing them
							//  would be a second change on top of an untested
							//  one.
							"rowBG" : {
								"type" : "image",
								"file" : "/interface/lofty_petports/shared/row_180.png",
								"position" : [ 0, 0 ],
							
								//  BELOW rowHover, which is at -1. Both were -1 and the draw order
								//  between them was then whatever the parser happened to produce --
								//  and the hover has to land ON TOP to lift what is underneath.
								"zlevel" : -2,
								"mouseTransparent" : true
							},
							//  HOVER, LAYERED OVER THE ROW ART RATHER THAN REPLACING IT.
							//
							//  A list schema has no hover state, so hover needs a BUTTON -- but a button
							//  carries one base image and cannot alternate or show a selection. So it does
							//  neither: its base is fully transparent, the rowBG image beneath keeps
							//  carrying alternating and selected state, and the hover art is TRANSLUCENT so
							//  it lifts whatever is under it. Hovering a selected row brightens the bar
							//  instead of hiding it.
							//
							//  IT DOES NOT STEAL THE SELECTION. Measured on the group picker: a full-width
							//  row button and the list's own callback BOTH fire on one click. So the list
							//  still selects normally and this button's callback does nothing -- it exists
							//  only to own a hover state.
							//
							//  A CALLBACK IS STILL MANDATORY. A row widget naming one that does not resolve
							//  throws inside addListItem and takes the pane with it.
							//
							//  SIZED EXPLICITLY to memberSize, as vanilla's bookmark row button is. A button
							//  otherwise takes its hit area from the base image -- and this base is
							//  transparent.
							"rowHover" : {
								"type" : "button",
								"base" : "/interface/lofty_petports/shared/row_180_clear.png",
								"hover" : "/interface/lofty_petports/shared/row_180_hover.png",
								"pressed" : "/interface/lofty_petports/shared/row_180_clear.png",
								"pressedOffset" : [ 0, 0 ],
								"size" : [ 180, 16 ],
								"position" : [ 0, 0 ],
								"zlevel" : -1,
								"callback" : "rowHovered"
							},
							"rowText" : {
								"mouseTransparent" : true,
								"type" : "label",
								"position" : [ 4, 4 ],
								"hAnchor" : "left",
								"value" : ""
							},
							"rowRemove" : {
								"type" : "button",
								"base" : "/interface/x.png",
								"hover" : "/interface/xhover.png",
								"pressed" : "/interface/xpress.png",
								"position" : [ 166, 3 ],
								"callback" : "requestRowRemove"
							}
						}
					}
				}
			}
		},

		//  ---- adding one -------------------------------------------------------

		//  BACKING IMAGE AS A SEPARATE WIDGET, not a field on the itemslot.
		//  Whether "itemslot" accepts a backing image of its own is not something
		//  this mod knows, and a wrong key is silently ignored -- which would
		//  leave an invisible slot that looks like a layout bug. Vanilla's mech
		//  assembly draws its slot outlines as ordinary art UNDERNEATH the
		//  itemslots, so this does the same with a widget type that is not in
		//  doubt.
		"slotBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/slot_backing.png",
			"position" : [ 10, 96 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},

		"itemSlot_request" : {
			"type" : "itemslot",
			"zlevel" : 2,
			"position" : [ 10, 96 ],
			"callback" : "requestSlotClicked",
			"rightClickCallback" : "requestSlotCleared"
		},

		"requestName" : {
			"type" : "label",
			"position" : [ 34, 108 ],
			"value" : "",
			"mouseTransparent" : true
		},

		"requestHint" : {
			"type" : "label",
			"position" : [ 34, 98 ],
			"fontSize" : 7,
			"color" : [ 150, 156, 164 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ---- the selected request's quota -------------------------------------
		//
		//  MIN AND MAX, NOT ONE NUMBER. A single quota thrashes: fetch one item,
		//  drop below it, fetch another. Min is when to START and max is when to
		//  STOP, and the gap between them is what turns forty one-item trips into
		//  one trip.
		//
		//  THESE EDIT WHICHEVER ROW IS SELECTED, and are blank with no selection.
		//  One pair of fields rather than a pair per row: rows are 16px and would
		//  not hold them, and the deposit pane already establishes "select a thing,
		//  then narrow it" as this mod's shape for exactly this.
		//
		//  A TEXTBOX CALLBACK IS NOT OPTIONAL, AND OMITTING IT IS A CRASH.
		//  Measured:
		//
		//    (WidgetParserException) Failed to find textbox callback named: 'tbMin'
		//
		//  Note the NAME -- nothing had asked for a callback called tbMin, that is
		//  the WIDGET's name. So the parser defaults a textbox's callback to the
		//  widget's own name and then requires it to resolve. Declared explicitly
		//  here instead.
		//
		//  FIVE DIGITS, WHICH IS WHERE QUOTA_CEILING COMES FROM. The regex is
		//  vanilla's pixel printer's minus its leading `x?` -- that character is
		//  its multiplier display, not ours -- and widened by one place.
		//
		//  IT WAS FOUR, WHICH CAPPED A REQUEST AT ONE STACK OF DIRT. Asking for
		//  two stacks meant adding the same item twice, which is silly for the
		//  most ordinary thing a player could want.
		//
		//  99999 rather than a round 100000, and the digit count is the reason.
		//  The regex and the ceiling are kept EQUAL so that everything typeable
		//  is valid -- no entry is silently rejected after the fact. Six digits
		//  would also make 999999 typeable, which the script would then have to
		//  refuse. 99999 is 99.999 slots of dirt against a 64-slot vanilla
		//  container, so the cap is already well past anything vanilla storage
		//  can hold and comfortably into modded territory. Beyond it, use a
		//  second crate.

		"minLabel" : {
			"type" : "label",
			"position" : [ 10, 76 ],
			"petportsString" : "restock.min",
			"value" : "--",
			"mouseTransparent" : true
		},
		"minFieldBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 108, 72 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},
		"tbMin" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 110, 76 ],
			"textAlign" : "center",
			"maxWidth" : 38,
			"regex" : "\\d{0,5}",
			"hint" : "",
			"callback" : "minChanged"
		},

		"maxLabel" : {
			"type" : "label",
			"position" : [ 10, 58 ],
			"petportsString" : "restock.max",
			"value" : "--",
			"mouseTransparent" : true
		},
		"maxFieldBacking" : {
			"type" : "image",
			"file" : "/interface/lofty_petports/restockconfig/field_backing.png",
			"position" : [ 108, 54 ],
			"zlevel" : 1,
			"mouseTransparent" : true
		},
		"tbMax" : {
			"type" : "textbox",
			"zlevel" : 2,
			"position" : [ 110, 58 ],
			"textAlign" : "center",
			"maxWidth" : 38,
			"regex" : "\\d{0,5}",
			"hint" : "",
			"callback" : "maxChanged"
		},

		//  ---- the refusal notice ---------------------------------------------
		//
		//  Hidden in normal use, and the only thing visible when the pane was
		//  opened from the cursor. See lockWithNotice.
		//
		//  AT x=10 RATHER THAN REUSING requestName AND requestHint. Those two
		//  are indented to clear the itemslot, and with the slot hidden they
		//  read as text floating in from nowhere. These get the full width,
		//  which is also what stops the message running off the frame.
		//
		//  NO wrapWidth, like everything else on this pane. The author splits
		//  the message into lines; see hotbarOnlyMessage above.

		"noticeTitle" : {
			"type" : "label",
			"position" : [ 10, 190 ],
			"value" : "",
			"mouseTransparent" : true
		},
		"noticeLineOne" : {
			"type" : "label",
			"position" : [ 10, 174 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		},
		"noticeLineTwo" : {
			"type" : "label",
			"position" : [ 10, 164 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		},

		//  ONE LINE, TRUNCATED IN LUA RATHER THAN WRAPPED.
		//
		//  The deposit pane learned that a wrapped label draws its first line
		//  ABOVE its position, which inside a 16px row put text over whatever
		//  sat above it. Nothing here is in a row, but the same upward growth
		//  would run this summary into the step arrows. So: no wrapWidth, and
		//  the script clips the string instead.
		"summary" : {
			"type" : "label",
			"position" : [ 10, 36 ],
			"fontSize" : 7,
			"color" : [ 160, 160, 160 ],
			"value" : "",
			"mouseTransparent" : true
		}
	},

	"scripts" : [ "/interface/lofty_petports/restockconfig/restockconfig.lua" ],
	"scriptDelta" : 1,

	//  Every callback named above must appear here or the widget silently does
	//  nothing when clicked -- except a textbox, which does not fail silently
	//  at all. See tbMin: an unresolvable textbox callback throws in the client
	//  main loop and the pane never opens.
	//
	//  THESE ARE NOT REGISTERED IN init(). widget.registerMemberCallback is for
	//  widgets inside a ListWidget's rows, which are built by a different
	//  parser -- see the deposit pane's header. Pane-level widgets like these
	//  register here and only here.
	//
	//  requestRowRemove IS ABSENT ON PURPOSE. It lives inside the list's
	//  listTemplate, so it must be registered at runtime instead; naming it
	//  here would put it in the wrong parser and change nothing.
	"scriptWidgetCallbacks" : [
		"enabledToggled",
		"requestSlotClicked",
		"requestSlotCleared",
		"requestSelected",
		"minChanged",
		"maxChanged",
		"feederToggled"
	]
}
