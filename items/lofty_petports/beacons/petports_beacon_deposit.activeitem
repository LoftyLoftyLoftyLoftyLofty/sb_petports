{
  "itemName" : "petports_beacon_deposit",
  "price" : 0,
  "rarity" : "Common",
  "category" : "petports_beacon",
  //  Frame-qualified, because this png is now a two-frame sheet -- "on" and
  //  "off". This field is the fallback the inventory uses before the animation
  //  is live; the animation is what actually drives the icon. See
  //  petports_beacon.animation.
  "inventoryIcon" : "petports_beacon_deposit.png:on",
  "description" : "Drop this in a container and units will deposit what they collect there.",
  "shortdescription" : "Deposit Beacon",
  "itemTags" : [ "petports", "petports_beacon" ],

  //  BEACONS ARE READ WHERE THEY SIT.
  //
  //  A beacon is not placed and it is not activated to take effect. It is an
  //  ITEM SITTING IN A CONTAINER, and the port reads container contents to
  //  decide what that container is for. So a player retasks a chest by dropping
  //  one in, and untasks it by taking it out. No config UI to find, no separate
  //  registry of designated containers to keep in sync with the world, and
  //  nothing to leak when a chest is mined.
  //
  //  The behaviour tag lives HERE, in the item's config, rather than in
  //  instance parameters -- so every copy of the item works, including one
  //  crafted, spawned, or pulled off a corpse. Read it with
  //  root.itemConfig(descriptor).config.petports_sortingBeaconBehavior;
  //  parameters are merged over the top the same way petData is, which leaves
  //  room for per-instance configuration later without changing how it is found.
  "petports_sortingBeaconBehavior" : "deposit",

  //  Stackable, deliberately. One beacon per container is what matters, and a
  //  player with twelve deposit chests should carry one stack, not twelve
  //  slots. Nothing per-instance is stored yet; when the config UI lands, a
  //  CONFIGURED beacon will need maxStack 1 while a blank one stays stackable.
  "maxStack" : 1000,

  //  ACTIVE ITEM, THOUGH IT DOES NOTHING WHEN USED YET.
  //
  //  It is an .activeitem rather than a plain .item purely so that "use it to
  //  configure it" has somewhere to live later -- filters, priorities, request
  //  amounts. An activeitem with no script errors on activation, so the stub
  //  below exists to make using one a no-op instead of a log full of nil
  //  indexes.
  "scripts" : [ "/items/lofty_petports/beacons/petports_beacon.lua" ],
  "animation" : "/items/lofty_petports/beacons/petports_beacon.animation",

  //  Resolves <partImage> in the animation. Without this the part has no image
  //  and the icon renders nothing at all.
  "animationParts" : {
    "beacon" : "petports_beacon_deposit.png"
  },
  "inspectionKind" : "",

  //  THE PANE PATH LIVES HERE, NOT IN THE SCRIPT.
  //
  //  Copied wholesale from vanilla's stationtransponder, which is the only
  //  retail example of a held item opening a GUI:
  //
  //      activeItem.interact(config.getParameter("interactAction"),
  //                          config.getParameter("interactData"))
  //
  //  Keeping both as config fields means every beacon TYPE shares one script
  //  and points at whatever pane it needs. A disperse beacon has nothing to
  //  filter, so it will eventually want a smaller pane than this one, and that
  //  is a one-line difference in its .activeitem rather than a branch in Lua.
  "interactAction" : "ScriptPane",
  "interactData" : "/interface/lofty_petports/beaconconfig/beaconconfig.config",

  //  NO BUILDER, AND THIS IS A TESTED CONCLUSION RATHER THAN AN OMISSION.
  //
  //  Two build scripts were written for this item and both were deleted. The
  //  first tried to swap config.inventoryIcon; the icon is set at runtime by
  //  activeItem.setInventoryIcon and nothing reads that field. The second tried
  //  to stamp a default parameter so pristine and configured beacons would
  //  stack. It ran -- confirmed by log, on spawn, on pickup, on every
  //  reconstruction -- and changed nothing, because a build script produces
  //  config and parameters TRANSIENTLY per construction and does not write back
  //  to the stored descriptor. Stacking compares the descriptor.
  //
  //  Normalisation therefore has to happen in the item script, which only runs
  //  while the item is HELD. See petports_beacon.lua init().

  "twoHanded" : true,
  "handPosition" : [-4, -2]
}
