//  SINKER TEST UNIT ITEM -- NOT A SHIPPING ITEM
//
//  A COPY of petports_unit_amphibious.item. Read that one for the crosshair
//  colour block and how petData merges.
//
//  THIS EXISTS BECAUSE /spawnmonster IS NOT A USABLE TEST HERE.
//
//  Two reasons, and the second is the one that matters:
//
//    1. anchorName is "petports_petport" and groundPet.lua is documented as
//       killing a unit outright when it cannot find its anchor. A free-spawned
//       unit may simply die.
//
//    2. EVEN IF IT LIVES, IT WOULD NOT ANSWER THE QUESTION. A loose pet idles
//       and wanders, and wanderState drives movement through
//       /scripts/groundMovement.lua -- which contains no pathfinder at all,
//       only rectCollision lookaheads and controlMove. NOTHING IN THAT PATH
//       TOUCHES A*. Watching a free-spawned unit paddle about would say
//       nothing whatsoever about whether Walk edges were planned.
//
//  So: spawn this ITEM, socket it into a petport, and give it dispatched work
//  with water between the port and the target. The task machinery is what
//  builds a PathMover and runs a real search.
//
//  ICON IS THE AMPHIBIOUS ONE, deliberately. inventoryIcon resolves relative to
//  this file's directory and the png sits beside it. A test variant does not
//  earn its own art, and looking identical to the axolotter in the inventory is
//  a feature -- it makes leaving one in a save obvious rather than plausible.
//
//  DELETE ALONGSIDE petports_sinkertest.monstertype.

{
  "itemName" : "petports_unit_sinkertest",
  "price" : 0,
  "rarity" : "Rare",
  "category" : "petports_pet",
  "inventoryIcon" : "petports_unit_amphibious.png",
  "description" : "A TEST BUILD. Its movement parameters tell it that water does not exist. It will attempt to walk along the bottom of anything it falls into. Not for release.",
  "shortdescription" : "Utility Unit (Sinker Test)",
  "itemTags" : [ "petports", "petports_unit", "petports_no_upcycling" ],

  //  Unchanged from the amphibious item. Kept rather than trimmed because the
  //  port reads these off petData.crosshairColors and falls back to its own
  //  defaults when absent -- and a test unit whose crosshairs render in
  //  DIFFERENT colours than the fleet is a test unit whose log is harder to
  //  read beside a normal one.
  "crosshairColors" : {
    "routing" : "ffff20ff",
    "enroute" : "20ff20ff",
    "unroutable" : "ff2020ff",
    "blocked" : "ff8020ff",
    "unclaimed" : "606060ff"
  },

  //  MATCHES THE AMPHIBIOUS UNIT so a module loadout can be moved between the
  //  two without a slot count changing underneath the comparison. The point of
  //  this variant is to be the axolotter in every respect except the two
  //  movement parameters.
  "petports_moduleSlots" : 3,

  "maxStack" : 1,

  "petData" : {
    //  MUST match the monstertype's "type" exactly. A mismatch makes spawnPet
    //  return nil and the petport looks fine while doing nothing -- which on a
    //  test build reads identically to "the experiment failed".
    "monsterType" : "petports_sinkertest",

    "petName" : "Sinker",

    "status" : {},
    "storage" : {}
  }
}
