		//  EVERYTHING THE MANIFEST CANNOT DESCRIBE.
		//  
		//  Matches an item that hits no subgroup of any other group. Not the
		//  leftovers of a particular crate's rules -- the question is asked of
		//  the MANIFEST, so what lands here is the same no matter how anyone has
		//  configured anything.
		//  
		//  This is the safety net for mods. An item with a category nothing
		//  claims does not go to the wrong crate, it goes to NO crate, and until
		//  now nothing said so. Point a rule at this and the strays have a home.
		//  
		//  IT DELIBERATELY DOES NOT GUESS. An unrecognised category is not turned
		//  into a group of its own: subgroups are stored as EXCLUSIONS, so an
		//  invented group would arrive switched ON in every rule a player already
		//  had, silently changing what their crates accept.
		//  
		//  NO SUBGROUPS, ON PURPOSE. There is nothing to narrow -- an item either
		//  has a home elsewhere or it does not. The tile grid is empty for this
		//  group and that is the correct amount of choice to offer.
		//  
		//  LAST BUT ONE, ahead of only Petports, which is where a fallback
		//  belongs: a player scrolling the picker should meet the real categories
		//  first. Its order is auto-assigned rather than written down -- it was a
		//  literal 290 and the forty Furniture Tagged groups grew straight into
		//  it. A number that encodes "after everything else" has to be computed,
		//  the same lesson as Filled Capture Pods sitting below Pets.
		"unsorted" : {
			"label" : "Unsorted",
			"order" : 3300,
			"unclassified" : true,
			"subgroups" : {

			}
		},

		"petports" : {
			"label" : "Petports",
			"order" : 1200,
			"subgroups" : {
				"beacon" : { "label" : "Beacons", "order" : 10, "tags" : [ "petports_beacon" ] },
				"unit" : { "label" : "Units", "order" : 20, "tags" : [ "petports_unit" ] },

				//  WHAT THE UPCYCLER MAKES. Needed for the machine to run at all
				//  rather than as a convenience: fuelWork only sends a unit to empty
				//  an output slot when some deposit beacon's filter ACCEPTS
				//  petports_petfuel, so without a way to tick this box the machine
				//  fills its output and stops.
				//
				//  TAGGED, NOT NAMED. petports_fuel is the tag every fuel item will
				//  carry, so the flavoured variants the reagent slot is reserved for
				//  -- spicy, sweet, whatever they end up being -- fall inside this
				//  subgroup the moment they exist. A named enumeration would need
				//  editing for each one, and would silently miss any added by another
				//  mod.
				"fuel" : { "label" : "Pet Treats", "order" : 30, "tags" : [ "petports_fuel" ] }
			}
		}
	}
}
