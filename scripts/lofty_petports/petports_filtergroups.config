//  PETPORTS -- FILTER GROUP MANIFEST
//
//  The vocabulary a deposit beacon filters with. Owned by this mod and meant to
//  be PATCHED by others: a mod that adds items adds its own groups here, and
//  its items become sortable everywhere without this mod knowing they exist.
//  Responsibility for a mod's items sorting correctly sits with that mod rather
//  than becoming a compatibility matrix here.
//
//  TWO LEVELS, AND EXACTLY TWO.
//
//      group        what a player picks in the pane        "Weapons"
//        subgroup   what they tick inside it               "Ranged", "Melee"
//          leaf     the predicate that matches items       tags/categories/items
//
//  No deeper nesting. Arbitrary depth buys expressiveness nobody asked for and
//  costs a recursive resolver plus a tree widget.
//
//  A LEAF MATCHES IF ANY OF ITS THREE FIELDS MATCH -- plain OR, no exceptions:
//
//      tags        item has ANY of these itemTags
//      categories  item's category is ANY of these
//      items       item's name is ANY of these
//
//  Uniform OR is possible because narrowing is expressed by AUTHORING A
//  SUBGROUP rather than by a field that behaves differently from its
//  neighbours. "Ores that are also blocks" is a subgroup, not a special case.
//
//  SUBGROUPS ARE EXCLUDED, NEVER INCLUDED.
//
//  A rule on a beacon stores which subgroups are switched OFF. A subgroup added
//  later -- by an update, by another mod -- is therefore INSIDE every existing
//  rule by default. Storing inclusions instead would mean each new subgroup was
//  silently absent from every beacon already placed in the world, and a player
//  who said "weapons" would find one kind of weapon quietly not sorting. That
//  is precisely the compatibility mess this manifest exists to prevent.
//
//  ORDER IS DISPLAY ORDER. Evaluation never depends on the order of anything in
//  this file; a beacon's own rule list decides that.

//  ---------------------------------------------------------------------------
//  CATEGORY NAMES ARE VERIFIED. TAG NAMES ARE NOT.
//  ---------------------------------------------------------------------------
//
//  Every string in a "categories" field below appears in vanilla's
//  /items/categories.config. They were audited against it and four were wrong:
//  "cookingingredient" and "petcollar" were mis-cased, and "augment" and
//  "reagent" are not categories at all. subgroupMatches compares with ==, so a
//  wrong name is a SILENT no-match -- nothing sorts by it and nothing says so.
//  Re-run that audit after any edit here.
//
//  THE TWO VOCABULARIES USE DIFFERENT CASING, AND THAT IS NOT A TYPO.
//  Measured on commonassaultrifle.activeitem:
//
//      "category"  : "assaultRifle"        camelCase
//      "itemTags"  : ["weapon","ranged","assaultrifle"]   all lowercase
//
//  So the same weapon type is spelled two ways depending on which field is
//  asked. Neither list below is a copy of the other.
//
//  CATEGORY SURVIVES THE BUILD SCRIPT, which is why weapons moved onto it.
//  Checked on a generated weapon, a unique weapon and a generated gun:
//
//      rarestaff           buildweapon.lua        category "staff"
//      teslastaff          buildunrandweapon.lua  category "staff"
//      commonassaultrifle  buildweapon.lua        category "assaultRifle"
//
//  Category is authored per file and comes through intact. This matters
//  because petports_itemFacts reads the BASE config -- the same reason
//  root.itemHasTag is a static lookup -- so anything the builder invents at
//  runtime would be invisible here. Category is not invented at runtime.
//
//  BOTH FIELDS ARE USED ON WEAPONS DELIBERATELY. Categories are exhaustive,
//  one per item, and match the labels the player already sees in their
//  inventory. Tags are the net for a modded weapon that sets itemTags but
//  picks a nonstandard category. The OR means neither has to be complete.
//
//  Tags marked UNVERIFIED below are inherited guesses. They cost nothing when
//  wrong -- a tag nothing carries simply never matches -- but they are not
//  evidence that a group works. Verify one item per subgroup in game before
//  trusting a bucket.

//  ---------------------------------------------------------------------------
//  OBJECT TAGS -- PRELIMINARY, AND EVERY TAG BELOW IS UNVERIFIED.
//  ---------------------------------------------------------------------------
//
//  Transcribed from https://starbounder.org/Tag, which documents the tags used
//  to decide which tenant a Colony Deed spawns. That list is small and already
//  written down, which is why it is the first pass at objects -- auditing every
//  object in the game is the eventual job, and there are thousands.
//
//  THEY LIVE IN colonyTags, NOT itemTags. This is the field petports_filters
//  reads them from, and reading only itemTags is why every one of these matched
//  nothing on the first pass.
//
//  RECONCILED AGAINST ALL 2879 VANILLA OBJECTS. Not transcription any more.
//
//  125 of the 133 tags taken from the wiki are carried by at least one vanilla
//  object. The 8 that are not were removed: "alpaca", "heck", and tier5 through
//  tier10 -- the wiki documents ten crafting tiers and vanilla ships four.
//  A mod that adds any of them can patch its own subgroup back in.
//
//  12 tags the wiki page does not list were found and added. Two CATEGORIES
//  were found that are not in /items/categories.config either: "playerstation"
//  (23 objects) and "genboss" (4). categories.config is a LABEL table, not the
//  set of legal categories, so an object can use a category with no label and
//  it will still sort.
//
//  One vanilla object, bosstentacle, carries an EMPTY STRING as a colonyTag.
//  Harmless here -- no subgroup is named "" so nothing matches it -- but worth
//  knowing before someone treats a blank tag as impossible.
//
//  CASING WAS CHECKED AND IS LOWERCASE. The wiki capitalises for display --
//  "Apex", "Tier1", "Retroscifi" -- but the files do not. Confirmed on four
//  objects:
//
//    floranchair     colonyTags ["floran","floranvillage"]
//    tier1switch     colonyTags ["wired","tier1"]
//    frogfurnishing  colonyTags ["outpost","commerce"]
//    retroscifibed   colonyTags ["retroscifi"]
//
//  A wrong id fails silently and completely, exactly as "cookingingredient"
//  did. The tool that produced the reconciliation lives in workbench and can be
//  re-run against any asset tree, including a full mod load -- the difference
//  between its output and this file is the list of tags nothing here knows
//  about yet.
//
//  THESE OVERLAP THE CATEGORY GROUPS ON PURPOSE. A Floran chair is category
//  "furniture" AND tagged "floran", so it matches both Objects and Species. That
//  is not a conflict -- rules are ordered and last-match-wins, so "all objects
//  here, except Floran ones" is two rules and works out of the box.
//
//  MODDED SPECIES ADD THEMSELVES. A race mod patches its tag into the species
//  group's subgroups array and its furniture sorts everywhere immediately. That
//  is the whole reason subgroups are stored as EXCLUSIONS: a beacon already set
//  to "Species Themed" picks up the new one without being touched.
{
	"groups" : {
		//  THE TAGS THIS USED TO USE DO NOT EXIST. "ore", "ingot" and "bar" were
		//  inherited guesses and an item scan found none of them on anything.
		//  Every ore and bar is craftingMaterial tagged "reagent", which is far too
		//  broad -- it also covers wood, sap and 100-odd other inputs.
		//  
		//  BOTH ARE LISTED BY NAME, and an "ore" suffix was tried and withdrawn.
		//  Twenty-six vanilla names end in ore and six of them are not ore:
		//  signstore and neonstore are shop signs, stationbackgroundcore is station
		//  scenery, and moltencore, scorchedcore and teleportercore are materials.
		//  Filing shop signs into an ore crate is worse than a mod having to patch
		//  in its own alloy. "bar" is the same story -- saloonbar is furniture.
		//  
		//  A mod adding ores patches its names in here. That is the trade, and it
		//  is the right way round: a missing entry sorts nothing, a bad suffix
		//  sorts the wrong thing and the player has to work out why.
		"ores" : {
			"label" : "Ores and Bars",
			"order" : 200,
			"subgroups" : {
				"ore" : { "label" : "Raw Ore", "order" : 10, "items" : [ "aegisaltore", "coalore", "copperore", "corefragmentore", "durasteelore", "feroziumore", "fossilore", "goldore", "ironore", "moonstoneore", "platinumore", "plutoniumore", "prisiliteore", "silverore", "solariumore", "titaniumore", "triangliumore", "tungstenore", "uraniumore", "violiumore" ] },
				"ingot" : { "label" : "Bars", "order" : 20, "items" : [ "copperbar", "durasteelbar", "goldbar", "ironbar", "platinumbar", "silverbar", "titaniumbar", "tungstenbar" ] }
			}
		},

		"weapons" : {
			"label" : "Weapons",
			"order" : 400,
			"subgroups" : {
				"melee" : { "label" : "Melee", "order" : 10, "categories" : [ "broadsword", "shortsword", "axe", "hammer", "spear", "dagger", "fistWeapon" ], "tags" : [ "melee", "broadsword", "shortsword", "axe", "hammer", "spear", "dagger" ] },
				"ranged" : { "label" : "Ranged", "order" : 20, "categories" : [ "assaultRifle", "pistol", "machinePistol", "shotgun", "sniperRifle", "rocketLauncher", "grenadeLauncher", "bow", "crossbow", "boomerang", "chakram" ], "tags" : [ "ranged", "pistol", "assaultrifle", "machinepistol", "shotgun", "sniperrifle", "rocketlauncher", "grenadelauncher", "bow", "rifle" ] },
				"magic" : { "label" : "Magic", "order" : 30, "categories" : [ "staff", "wand" ], "tags" : [ "staff", "wand" ] },
				"whip" : { "label" : "Whips", "order" : 40, "categories" : [ "whip" ] },
				"shield" : { "label" : "Shields", "order" : 50, "categories" : [ "shield" ], "tags" : [ "shield" ] },
				//  The tags "throwableitem" and "thrownitem" were guesses; neither
				//  exists. The category does, on 48 items.
				"throwable" : { "label" : "Throwable", "order" : 60, "categories" : [ "throwableItem" ] },
				"unique" : { "label" : "Unique and Novelty", "order" : 70, "categories" : [ "uniqueWeapon", "toy" ], "tags" : [ "toy", "livingweapon" ] },
				//  The anvil-upgradeable weapons, 36 of them. Note the CAMEL CASE: item
				//  tags are lowercase almost without exception and this one is not, so
				//  do not "correct" it.
				"upgradeable" : { "label" : "Upgradeable", "order" : 80, "tags" : [ "upgradeableWeapon" ] }
			}
		},

		"armour" : {
			"label" : "Armor and Clothes",
			"order" : 500,
			"subgroups" : {
				"head" : { "label" : "Head", "order" : 10, "categories" : [ "headarmour", "headwear" ] },
				"chest" : { "label" : "Chest", "order" : 20, "categories" : [ "chestarmour", "chestwear" ] },
				"legs" : { "label" : "Legs", "order" : 30, "categories" : [ "legarmour", "legwear" ] },
				"back" : { "label" : "Back", "order" : 40, "categories" : [ "backwear", "enviroProtectionPack" ] },
				//  Dyes go through the augment system but are cosmetic consumables,
				//  not equipment, so they sit with the clothing rather than with EPP
				//  augments.
				"dye" : { "label" : "Dyes", "order" : 50, "categories" : [ "clothingDye" ] }
			}
		},

		//  WHAT YOU BUILD WITH, not what you put in the room afterwards.
		//  
		//  This used to carry an "Objects" subgroup holding nineteen categories --
		//  every chair, lamp, door and chest in the game as one tile. That was
		//  backwards: the manifest gave a whole top-level group to what an object
		//  LOOKS LIKE (Biome Themed, Decor Themes, Species Themed) and buried what
		//  an object IS inside the blocks. Furniture is its own group now.
		"building" : {
			"label" : "Building Materials",
			"order" : 100,
			"subgroups" : {
				"block" : { "label" : "Blocks", "order" : 10, "categories" : [ "block" ] },
				//  The "rails" colonyTag lives HERE, not under object themes. Rail
				//  bumpers and tram stops are track, and a player laying rail wants
				//  them with the platforms rather than in a generic object pile.
				"platform" : { "label" : "Platforms and Rails", "order" : 20, "categories" : [ "platform", "rail", "railPlatform", "railPoint" ], "tags" : [ "rails" ] },
				"liquid" : { "label" : "Liquids", "order" : 30, "categories" : [ "liquid" ] }
			}
		},

		//  SPLIT BY WHAT THE OBJECT IS. What it looks like is a separate axis and
		//  has its own groups -- Biome Themed, Decor Themes, Species Themed,
		//  Location Themed, Object Themes, Crafting Tier, Holiday Themed. An
		//  object hits both, which is the point: "all the lamps" and "everything
		//  Floran" are different questions and a player may want either.
		//  
		//  Those theme groups stay SIBLINGS rather than becoming subgroups here.
		//  There are over a hundred theme tags between them; folding them in would
		//  make one group of 130-odd tiles and bury the thirteen above.
		"furniture" : {
			"label" : "Furniture - General",
			"order" : 1700,
			"subgroups" : {
				"furniture" : { "label" : "Furniture", "order" : 10, "categories" : [ "furniture" ] },
				"decorative" : { "label" : "Decorative", "order" : 20, "categories" : [ "decorative" ] },
				"light" : { "label" : "Lighting", "order" : 30, "categories" : [ "light" ] },
				"storage" : { "label" : "Storage", "order" : 40, "categories" : [ "storage", "fridgeStorage", "shippingContainer" ] },
				"door" : { "label" : "Doors", "order" : 50, "categories" : [ "door" ] },
				"wire" : { "label" : "Wiring", "order" : 60, "categories" : [ "wire" ] },
				"trap" : { "label" : "Traps", "order" : 70, "categories" : [ "trap" ] },
				"teleport" : { "label" : "Teleporters", "order" : 80, "categories" : [ "teleporter", "teleportMarker" ] },
				"terraformer" : { "label" : "Terraformers", "order" : 90, "categories" : [ "terraformer" ] },
				"spawner" : { "label" : "Deeds and Spawners", "order" : 100, "categories" : [ "spawner" ] },
				"breakable" : { "label" : "Breakables", "order" : 110, "categories" : [ "breakable" ] },
				//  Fuel hatches carry NO category at all, so the tag is the only handle
				//  on them. They also carry a species colonyTag, so they turn up under
				//  Species Themed as well -- which is where someone refitting a ship
				//  would look first.
				"ship" : { "label" : "Ship Fittings", "order" : 120, "tags" : [ "captainschair", "newfuelhatch" ] },
				//  "generic" and "other" are vanilla's own catch-alls, and
				//  "playerstation" and "genboss" are not in categories.config at all --
				//  that file is a LABEL table, not the set of legal categories.
				//  
				//  The listed names are objects with NO category and NO tags. Each is
				//  also claimed by whichever place or biome it belongs to.
				"other" : { "label" : "Uncategorised Objects", "order" : 130, "categories" : [ "generic", "other", "Other", "playerstation", "genboss" ], "items" : [ "protectoratewindbanner", "protectoratewindbanner2", "protectoratewindbanner3", "protectoratehulagirl", "protectoratetentacle", "protectoratetentacle2", "geodebnatural", "geodecnatural", "geodednatural", "geodehighanatural", "geodelowanatural" ] }
			}
		},

		"farming" : {
			"label" : "Farming",
			"order" : 1400,
			"subgroups" : {
				"seed" : { "label" : "Seeds and Saplings", "order" : 10, "categories" : [ "seed", "sapling" ] },
				"livestock" : { "label" : "Livestock", "order" : 20, "categories" : [ "farmBeastEgg", "farmBeastFood", "farmBeastFeed" ] }
			}
		},

		"consumable" : {
			"label" : "Food",
			"order" : 900,
			"subgroups" : {
				//  "produce" AS A TAG DOES NOT EXIST -- but the split does, and it is
				//  the category. Raw crops are "food" (avesmingo, oculemon, potato,
				//  tomato) and anything cooked is "preparedFood" (bakedpotato,
				//  boiledrice).
				//  
				//  Beside Cooked Food rather than under Farming, because the two end up
				//  in the same crate more often than not and a player filling one
				//  should not have to tick two groups to do it. The subgroups are still
				//  separate, so anyone who does want them apart still can.
				"produce" : { "label" : "Produce", "order" : 10, "categories" : [ "food" ] },
				//  Only what has been through a stove. Raw crops are Produce above.
				"food" : { "label" : "Cooked Food", "order" : 20, "categories" : [ "preparedFood" ] },
				"drink" : { "label" : "Drinks", "order" : 30, "categories" : [ "drink" ] },
				"ingredient" : { "label" : "Ingredients", "order" : 40, "categories" : [ "cookingIngredient" ] }
			}
		},

		//  ITS OWN GROUP, and the reason is what a player does with them rather
		//  than how the engine files them.
		//  
		//  Dyes, fishing reels and lures, pet collars and EPP augments all run
		//  through the same augment system, which is why they were bundled. But
		//  they have nothing else in common: dyes are cosmetic, reels are gear,
		//  collars belong to a pet. EPP augments are rare, valuable and worth
		//  protecting, and a crate that holds them should not also fill up with
		//  clothing dye.
		"augment" : {
			"label" : "EPP Augments",
			"order" : 600,
			"subgroups" : {
				"epp" : { "label" : "EPP Augments", "order" : 10, "categories" : [ "eppAugment" ] }
			}
		},

		"pets" : {
			"label" : "Pets",
			"order" : 1100,
			"subgroups" : {
				"collar" : { "label" : "Collars", "order" : 10, "categories" : [ "petCollar" ] },
				//  A held tool rather than a pet, but it exists only to move critters
				//  and it belongs where someone keeps their pet gear.
				"relocator" : { "label" : "Relocators", "order" : 20, "items" : [ "relocator" ] },
				//  BY NAME, not category. Capture pods have not been checked against
				//  an item scan yet, and a literal name always matches exactly one
				//  thing -- so this is right even if the category turns out to be
				//  something unhelpful like "tool".
				"pod" : { "label" : "Empty Capture Pods", "order" : 30, "items" : [ "capturepod" ] }
			}
		},

		//  ONE BELOW PETS, COMPUTED RATHER THAN WRITTEN DOWN.
		//  
		//  This belongs directly under Pets and the numbering is the only thing
		//  that keeps it there. It was a literal 81, chosen when Pets was 80 --
		//  and then a group was inserted earlier in the file, Pets became 90, and
		//  Filled Capture Pods silently moved ABOVE the thing it is supposed to
		//  sit beneath.
		//  
		//  Now it is Pets' order plus one, taken at generation time. A round +10
		//  would leave a ten-wide gap for any mod to slot into; +1 means only an
		//  exact collision can get between them, and a tie breaks on id.
		//  
		//  If something does need to sit between these two, it wants to be a
		//  subgroup of one of them rather than a group of its own.
		//  
		//  SEPARATE FROM PETS, because the contents are alive and a player is
		//  storing creatures, not equipment.
		//  
		//  Sorting these BY SPECIES is the obvious next want and is deliberately
		//  not attempted here -- the species lives in the pod's parameters, not
		//  in its name or category, so petports_itemFacts cannot currently see
		//  it at all.
		"livecargo" : {
			"label" : "Filled Capture Pods",
			"order" : 1101,
			"subgroups" : {
				"filledpod" : { "label" : "Filled Capture Pods", "order" : 10, "items" : [ "filledcapturepod" ] }
			}
		},

		"tools" : {
			"label" : "Tools and Gear",
			"order" : 1300,
			"subgroups" : {
				//  BOTH CASES, AND VANILLA REALLY DOES USE BOTH. "Tool" carries 33
				//  items -- every pickaxe and drill, the matter manipulator, the
				//  flashlight -- and "tool" carries 13 more. Claiming only the
				//  lowercase silently lost the larger half.
				//  
				//  "beamaxeX" is listed by name because its category is the string
				//  "Tool ^green;[R]" -- a colour escape left in the category field of a
				//  dev item. Matching that literally would be absurd; matching the name
				//  costs one entry.
				//  
				//  "stationtransponder" has no category and no tags either, so the name
				//  is the only handle. superfishaxe was here too and moved to Admin,
				//  which now exists.
				"tool" : { "label" : "Tools", "order" : 10, "categories" : [ "Tool", "tool", "Drone" ], "tags" : [ "tool", "fossilbrush", "miningtool", "pickaxe" ], "items" : [ "beamaxeX", "stationtransponder" ] },
				"tech" : { "label" : "Tech", "order" : 20, "categories" : [ "tech", "techManagement" ] }
			}
		},

		"mech" : {
			"label" : "Mechs and Vehicles",
			"order" : 800,
			"subgroups" : {
				//  "Blueprint" with a capital B is a category of exactly four items,
				//  all of them mech blueprints.
				//  
				//  autochip and autodrive are listed BY NAME. Both are categorised
				//  upgradeComponent in vanilla, which is a mislabel -- they craft
				//  vehicle controllers and repair hoverbikes. Upgrades does not claim
				//  that category for exactly this reason, so these land here and only
				//  here. autodrive is deprecated and unobtainable in normal play; it is
				//  listed anyway, since somewhere sensible costs nothing and a stray
				//  item costs a question.
				"part" : { "label" : "Mech Parts", "order" : 10, "categories" : [ "mechPart", "Blueprint" ], "tags" : [ "mech" ], "items" : [ "autochip", "autodrive" ] },
				"vehicle" : { "label" : "Vehicles", "order" : 20, "categories" : [ "vehicleController" ], "tags" : [ "vehiclecontroller" ] },
				//  Salvage lives with mechs rather than with crafting materials: it is
				//  what mech parts are built from and it is found doing mech things.
				"salvage" : { "label" : "Salvage Components", "order" : 30, "categories" : [ "salvageComponent" ], "tags" : [ "salvage" ] }
			}
		},

		//  THINGS A NORMAL PLAYER CANNOT ACCUMULATE.
		//  
		//  Every item here is either consumed the instant it is picked up or is
		//  unobtainable without /admin. None of it should ever be sitting in a
		//  crate, which makes this a useful diagnostic bucket as much as a filter.
		//  
		//  Ship FITTINGS are not here. Captain's chairs, fuel hatches, ship lockers
		//  and tech stations are furniture, they carry their own species colonyTag,
		//  and they sort under Furniture - Species and Furniture - General.
		"admin" : {
			"label" : "Admin",
			"order" : 3100,
			"subgroups" : {
				//  The ten shipLicense items -- license1-5 and fakelicense1-5. These
				//  are the licenses bought from the Penguin Bay merchant, and they
				//  exist in a player's inventory for about one tick before being
				//  consumed into a quest. Quest Items would be defensible; Admin is
				//  the more useful answer, because a stack of them in a crate means
				//  something odd has happened.
				"licence" : { "label" : "Ship Licenses", "order" : 10, "categories" : [ "shipLicense" ] },
				//  "Upgrade Component" WITH A SPACE, which is the DISPLAY LABEL of
				//  upgradeComponent used as a category. Ten items: shipT1 through
				//  shipT8 and both repair kits. Immediate admin-only upgrades, not the
				//  licenses above and not the same thing at all.
				"shipupgrade" : { "label" : "Ship Upgrades", "order" : 20, "categories" : [ "Upgrade Component" ] },
				//  Admin-only and unobtainable normally.
				//  
				//  superfishaxe has no category at all, so its name is the only handle.
				//  fishaxe is category "Tool", so it ALSO matches Tools and Gear and
				//  there is no way to say "except this one" -- the matchers are all
				//  positive. Being in both is the cost, and it is a cheap one for an
				//  item nobody can obtain.
				"tool" : { "label" : "Admin Tools", "order" : 30, "items" : [ "fishaxe", "superfishaxe" ] }
			}
		},

		"upgrades" : {
			"label" : "Upgrades",
			"order" : 700,
			"subgroups" : {
				//  BY NAME, NOT BY CATEGORY, and the category was tried first.
				//  
				//  "upgradeComponent" is five items: these three, plus autochip and
				//  autodrive. Those two are not character upgrades -- they craft vehicle
				//  controllers and repair hoverbikes -- so the category is mislabelled
				//  in vanilla rather than describing a real set. Three names are more
				//  accurate than a category that is 40% wrong.
				//  
				//  A mod adding a genuine upgrade module patches its name in here.
				//  
				//  teleportercore is NOT here despite belonging with these by rarity and
				//  by instinct: it is craftingMaterial tagged reagent, and the more
				//  correct sort wins over keeping the purples together.
				"module" : { "label" : "Upgrade Modules", "order" : 10, "items" : [ "manipulatormodule", "techcard", "upgrademodule" ] }
			}
		},

		"medicine" : {
			"label" : "Healing and Medicine",
			"order" : 1000,
			"subgroups" : {
				"medicine" : { "label" : "Medicine", "order" : 10, "categories" : [ "medicine" ] }
			}
		},

		//  Out of Tools and Gear on its own. Fishing is a whole activity with its
		//  own tackle, and a player who fishes wants a tackle box, not their reels
		//  mixed in with pickaxes.
		"fishing" : {
			"label" : "Fishing",
			"order" : 1500,
			"subgroups" : {
				"gear" : { "label" : "Rods, Reels and Lures", "order" : 10, "categories" : [ "fishingRod", "fishingLure", "fishingReel" ] }
			}
		},

		//  Out of Furniture - General because a workshop is a room a player builds
		//  deliberately. Note this is the crafting CATEGORY; the crafting colonyTag
		//  is its own group in the Furniture - Tagged block, and an object can
		//  carry either.
		"furniturecrafting" : {
			"label" : "Furniture - Crafting Stations",
			"order" : 1600,
			"subgroups" : {
				"station" : { "label" : "Crafting Stations", "order" : 10, "categories" : [ "crafting" ] }
			}
		},

		"crafting" : {
			"label" : "Crafting Materials",
			"order" : 300,
			"subgroups" : {
				"material" : { "label" : "Materials", "order" : 10, "categories" : [ "craftingMaterial" ] },
				//  122 items: ores, bars, wood, sap, and most other raw inputs. Note
				//  this OVERLAPS Materials almost entirely -- nearly everything tagged
				//  reagent is also craftingMaterial -- and overlaps Ores and Bars
				//  completely. It is here because it is the only handle on "raw input"
				//  as a concept, not because it partitions anything.
				"reagent" : { "label" : "Reagents", "order" : 20, "tags" : [ "reagent" ] },
				"fuel" : { "label" : "Fuel", "order" : 30, "categories" : [ "fuel" ] }
			}
		},

		"valuables" : {
			"label" : "Collectibles and Valuables",
			"order" : 2700,
			"subgroups" : {
				//  Pixels and essence carry NO category despite six other items using
				//  "currency" -- so the two things a monster farm actually produces
				//  would not have sorted. Listed by name.
				"currency" : { "label" : "Currency", "order" : 10, "categories" : [ "currency" ], "items" : [ "money", "essence" ] },
				//  "gem" and "crystal" were inherited guesses and the item scan found
				//  neither on anything. Vanilla has essentially ONE gem -- diamond,
				//  filed as craftingMaterial tagged reagent like every other input --
				//  so there is nothing to match on but the name. Mods add more and
				//  patch them in here.
				"gem" : { "label" : "Gems", "order" : 20, "items" : [ "diamond" ] },
				"trophy" : { "label" : "Trophies", "order" : 30, "categories" : [ "trophy", "artifact" ] },
				"collectible" : { "label" : "Collectibles", "order" : 40, "categories" : [ "tradingCard", "actionFigure" ] },
				"trade" : { "label" : "Trade Goods", "order" : 50, "categories" : [ "tradeGoods" ] }
			}
		},

		//  ONE GROUP FOR THE WHOLE HOBBY: what you dig up, what you clean, and what
		//  you stand it on.
		//  
		//  Replaces a "Furniture - Tagged: fossil" group that was catching all 55
		//  pocket specimens along with the three shelves. "fossil" is the one
		//  tenant tag that is also an itemTag, and the matcher does not care which
		//  field a tag came from -- so that group quietly meant two things.
		//  
		//  Fossils also left Collectibles and Valuables, which now covers currency,
		//  gems, trophies, trading cards and trade goods.
		"fossils" : {
			"label" : "Fossils",
			"order" : 2850,
			"subgroups" : {
				//  The three size categories cover EXACTLY the 55 items carrying the
				//  "fossil" itemTag -- checked both directions, no drift. So the
				//  categories are used and the tag is not, which leaves the tag free to
				//  mean what it means on objects.
				"specimen" : { "label" : "Specimens", "order" : 10, "categories" : [ "smallFossil", "mediumFossil", "largeFossil" ] },
				//  The eight breakables dug out of the ground. Also Furniture -
				//  General / breakable, which is right -- they are scenery until hit.
				"uncleaned" : { "label" : "Uncleaned", "order" : 20, "tags" : [ "dirtyfossil" ] },
				//  BY NAME. The only three objects carrying "fossil" as a colonyTag,
				//  and they are decorative/storage/valuable besides -- no category means
				//  "fossil shelf".
				"display" : { "label" : "Displays", "order" : 30, "items" : [ "fossildisplay1", "fossildisplay3", "fossildisplay5" ] }
			}
		},

		//  OUT OF COLLECTIBLES AND INTO ITS OWN GROUP. 42 vanilla objects, and
		//  they are collected deliberately rather than accumulated -- a jar
		//  shelf is a display, not a drawer of odds and ends.
		//  
		//  Both fields because "bug" is one of the six names that is a category
		//  AND a tag; either would work and matching both costs nothing.
		"bugs" : {
			"label" : "Bug Jars",
			"order" : 2800,
			"subgroups" : {
				"bug" : { "label" : "Bugs in Jars", "order" : 10, "categories" : [ "bug" ], "tags" : [ "bug" ] }
			}
		},

		//  Its own group rather than a subgroup of tools. Instruments are
		//  collected and displayed; they are not gear.
		"instruments" : {
			"label" : "Instruments",
			"order" : 2900,
			"subgroups" : {
				"instrument" : { "label" : "Instruments", "order" : 10, "categories" : [ "musicalInstrument" ] }
			}
		},

		//  MATCHED BY NAME SUFFIX, because there is nothing else to match on.
		//  
		//  Every blueprint is GENERATED -- "ironanvil-recipe" and so on -- so no
		//  file exists to scan, no list can be enumerated, and the recipe inside
		//  can be for food, a gun or a helmet. The suffix is the only thing they
		//  all share, which is what "suffixes" in petports_filters exists for.
		//  
		//  CONFIRMED IN GAME. The suffix rule sorts vanilla blueprints correctly;
		//  it was never verifiable from the asset tree, since a generated item has
		//  no file to scan.
		//  
		//  "sb_blueprint" is BetaBound. That mod is prolific and replaces the
		//  -recipe items with an item of its own, so the suffix alone would miss
		//  every blueprint in a load that includes it. Listed by exact name rather
		//  than guessed at with another suffix.
		//  
		//  A mod that does the same thing differently patches its own name in here
		//  -- which is the whole point of this file being patchable.
		"blueprints" : {
			"label" : "Blueprints",
			"order" : 2400,
			"subgroups" : {
				//  The four MECH blueprints are category "Blueprint" and sort under
				//  Mechs and Vehicles instead -- they are mech parts you have not built
				//  yet, and a player collecting mech pieces wants them together.
				"recipe" : { "label" : "Blueprints", "order" : 10, "items" : [ "sb_blueprint" ], "suffixes" : [ "-recipe" ] }
			}
		},

		"quest" : {
			"label" : "Quest Items",
			"order" : 2500,
			"subgroups" : {
				//  shipLicense moved to Admin. Those items are consumed into a quest
				//  about a tick after pickup, so a crate rule for them only matters
				//  when something has gone wrong.
				"quest" : { "label" : "Quest Items", "order" : 10, "categories" : [ "quest", "mysteriousReward" ] }
			}
		},

		//  NOT filed with quest items. They were one group and should never have
		//  been: quest items are things you must not lose, junk is things you are
		//  trying to get rid of.
		"junk" : {
			"label" : "Junk",
			"order" : 3200,
			"subgroups" : {
				"junk" : { "label" : "Junk", "order" : 10, "categories" : [ "Junk", "junk", "foodJunk" ] }
			}
		},

		//  "Codices" is the correct plural and nobody reading a crate label wants
		//  to be quizzed on Latin. The group ID stays "codices" because rules on
		//  existing beacons reference it and renaming would orphan them.
		//  
		//  NO CODEX FILE HAS A CATEGORY. All 123 were scanned and every one came
		//  back with none, so "codex" as a category matched nothing -- it exists in
		//  categories.config as a label and nothing uses it. Kept anyway in case
		//  something does; it costs nothing.
		//  
		//  The file names are ancientalphabet, apexhistory1 and so on, and the
		//  picked-up item is generated from them -- same shape as blueprints, so
		//  the same suffix rule. UNVERIFIED for the same reason blueprints were:
		//  a generated item has no file. Confirm by picking one up with filter
		//  debug on and reading the "facts <name>:" line.
		//  
		//  SORTED BY RACE WITHOUT PATCHING ANYTHING. 89 of the 123 vanilla codex
		//  names are race-prefixed, so a nameParts rule -- starts with "apex" AND
		//  ends with "-codex" -- picks them out exactly. The prefix alone would
		//  be catastrophic: "apex" matches every Apex chair and door in the game.
		//  
		//  This matters because of mods, not vanilla. A mod adding seventy codex
		//  entries would otherwise bury every other species lineup in one crate,
		//  and any mod that names its codexes conventionally is sorted by this
		//  with no cooperation and no .patch files against vanilla assets.
		//  
		//  The 34 vanilla codexes with no race in the name are listed literally,
		//  assigned by SUBJECT: the castle and sewer entries are Glitch, the
		//  yolotli diaries are Hylotl, the tomb is Avian.
		"codices" : {
			"label" : "Codex Entries",
			"order" : 2600,
			"subgroups" : {
				"apex" : { "label" : "Apex", "order" : 10, "nameParts" : [ { "prefix" : "apex", "suffix" : "-codex" } ] },
				"avian" : { "label" : "Avian", "order" : 20, "items" : [ "trappedtomb-codex" ], "nameParts" : [ { "prefix" : "avian", "suffix" : "-codex" } ] },
				"floran" : { "label" : "Floran", "order" : 30, "nameParts" : [ { "prefix" : "floran", "suffix" : "-codex" } ] },
				"glitch" : { "label" : "Glitch", "order" : 40, "items" : [ "castleguest-codex", "castleking01-codex", "castleking02-codex", "castleking03-codex", "castleking04-codex", "castleking05-codex", "castleking06-codex", "castlemisunderstanding-codex", "castleprefix-codex", "florvilarchitect-codex", "sewerdayout-codex" ], "nameParts" : [ { "prefix" : "glitch", "suffix" : "-codex" } ] },
				//  CULTISTS ARE HUMAN. The cult is a human institution and its entries
				//  read as human history, so they fold in here rather than standing
				//  alone as a two-item species. The lunar base is Miniknog-run but the
				//  mission logs are written from the human side, and Esther is human.
				//  
				//  The colony story is classified human in the assets.
				//  
				//  lunarmission and colonystory are PREFIX rules rather than lists of
				//  literal names, so a mod adding a fifth log or a seventh chapter is
				//  picked up without an edit.
				"human" : { "label" : "Human", "order" : 50, "items" : [ "esthersjournal-codex" ], "nameParts" : [ { "prefix" : "human", "suffix" : "-codex" }, { "prefix" : "cultist", "suffix" : "-codex" }, { "prefix" : "lunarmission", "suffix" : "-codex" }, { "prefix" : "colonystory", "suffix" : "-codex" } ] },
				"hylotl" : { "label" : "Hylotl", "order" : 60, "items" : [ "yolotlisdiary1-codex", "yolotlisdiary2-codex", "yolotlisdiary3-codex", "yolotlisdiary4-codex", "shipseasick-codex", "townresistance-codex", "townsilly-codex" ], "nameParts" : [ { "prefix" : "hylotl", "suffix" : "-codex" } ] },
				"ancient" : { "label" : "Ancient", "order" : 70, "nameParts" : [ { "prefix" : "ancient", "suffix" : "-codex" } ] },
				//  Dreadwing and Shockhopper are penguins, and penguins are a race even
				//  if they never got furniture -- there is no "penguin" colonyTag, so
				//  this subgroup has no counterpart under Species Themed.
				//  
				//  The prefix rule is here for mods; the two vanilla entries are named
				//  after the bosses rather than the race and have to be listed.
				"penguin" : { "label" : "Penguin", "order" : 80, "items" : [ "bossdreadwing-codex", "bossshockhopper-codex" ], "nameParts" : [ { "prefix" : "penguin", "suffix" : "-codex" } ] },
				"protectorate" : { "label" : "Protectorate", "order" : 90, "nameParts" : [ { "prefix" : "protectorate", "suffix" : "-codex" } ] },
				//  The postcard the developers give the player for finishing the game.
				//  Not a species artefact and not a colony manual -- it is a thankyou,
				//  and filing it with the tutorial paperwork would be a small insult to
				//  whoever wrote it.
				"special" : { "label" : "Special", "order" : 100, "items" : [ "finalpostcard-codex" ] },
				//  UNCLASSIFIED: a codex that no subgroup above can DESCRIBE.
				//  
				//  Not "whatever is left after ticking". Unticking Glitch removes the
				//  Glitch codexes from the crate; it does not push them in here. The
				//  test is against the manifest, not against the switches, so what
				//  lands here does not change as a player edits a rule.
				//  
				//  There WAS an "Unaffiliated" subgroup beside this one, listing seven
				//  vanilla codexes by hand as belonging to no species. It is gone: two
				//  buckets whose labels both mean "neither of the above" is a puzzle
				//  for whoever reads the tile list, and six of the seven were wrong --
				//  the colony story is classified human in the assets.
				//  
				//  That leaves colonymanual, which has no species and no description,
				//  and it lands here by simply not matching anything -- which is what
				//  this bucket is for. Everything else vanilla ships is placed above.
				//  
				//  So this holds colonymanual plus whatever a mod added without naming
				//  it in a way any race rule recognises. Point it at whatever crate
				//  that deserves.
				//  
				//  It narrows on its own: patch a new race subgroup into this group and
				//  those entries stop being unclassified immediately, with nothing to
				//  recompute.
				"other" : { "label" : "Other Codices", "order" : 110, "categories" : [ "codex" ], "suffixes" : [ "-codex" ], "unclassified" : true }
			}
		},

		//  RACIAL LOCATION SETS LIVE HERE, not under Location Themed.
		//  
		//  Apex Mansion, Hylotl Ocean City, Glitch Castle and the rest are Apex,
		//  Hylotl and Glitch furniture first and dungeon dressing second. A player
		//  sorting by species wants all of it in one crate; splitting it across
		//  two groups meant ticking a race and still missing most of its objects.
		//  
		//  Location Themed keeps only what has no racial owner.
		//  
		//  "alpaca" is kept although no vanilla object carries it. It is a
		//  documented vanilla tag and mods fill it in; supporting it costs
		//  nothing and a tag nothing carries simply never matches.
		//  
		//  A race mod patches one entry into this array and its furniture sorts
		//  everywhere immediately -- the reason subgroups are stored as
		//  EXCLUSIONS rather than inclusions.
		"species" : {
			"label" : "Furniture - Species",
			"order" : 1800,
			"subgroups" : {
				"agaran" : { "label" : "Agaran", "order" : 10, "tags" : [ "agaran" ] },
				"alpaca" : { "label" : "Alpaca", "order" : 20, "tags" : [ "alpaca" ] },
				"ancient" : { "label" : "Ancient", "order" : 30, "tags" : [ "ancient" ] },
				"apex" : { "label" : "Apex", "order" : 40, "tags" : [ "apex", "apexmansion", "apexresearchlab", "apexvillage", "apexmission1", "apexcamp" ] },
				"avian" : { "label" : "Avian", "order" : 50, "tags" : [ "avian", "avianairship", "aviantemple", "aviantomb", "avianvillage" ] },
				"fenerox" : { "label" : "Fenerox", "order" : 60, "tags" : [ "fenerox" ] },
				"floran" : { "label" : "Floran", "order" : 70, "tags" : [ "floran", "floranhuntinggrounds", "floranprison", "floranvillage" ] },
				"glitch" : { "label" : "Glitch", "order" : 80, "tags" : [ "glitch", "glitchcastle", "glitchsewer", "glitchvillage" ] },
				"human" : { "label" : "Human", "order" : 90, "tags" : [ "human", "humanbunker", "humanprison", "humanvillage" ] },
				"hylotl" : { "label" : "Hylotl", "order" : 100, "tags" : [ "hylotl", "hylotloceancity", "hylotlvillage" ] },
				"novakid" : { "label" : "Novakid", "order" : 110, "tags" : [ "novakid", "novakidvillage" ] }
			}
		},

		//  A SEPARATE AXIS FROM Armour and Clothing, which splits by slot. 240
		//  items carry these, six tiers, and a player kitting out for a boss
		//  wants the tier not the slot.
		//  
		//  Six, not ten: tier1armour through tier6armour is what exists.
		"armourtier" : {
			"label" : "Armor Tier",
			"order" : 501,
			"subgroups" : {
				"tier1" : { "label" : "Tier 1", "order" : 10, "tags" : [ "tier1armour" ] },
				"tier2" : { "label" : "Tier 2", "order" : 20, "tags" : [ "tier2armour" ] },
				"tier3" : { "label" : "Tier 3", "order" : 30, "tags" : [ "tier3armour" ] },
				"tier4" : { "label" : "Tier 4", "order" : 40, "tags" : [ "tier4armour" ] },
				"tier5" : { "label" : "Tier 5", "order" : 50, "tags" : [ "tier5armour" ] },
				"tier6" : { "label" : "Tier 6", "order" : 60, "tags" : [ "tier6armour" ] }
			}
		},

		//  THE FRÖGG FURNISHINGS SETS, and only those. Twelve themes a player can
		//  walk up to a shop and buy, which is what makes this a useful crate: it
		//  maps to something they went out and got.
		//  
		//  The other nine decor tags are not sold as sets and live in the
		//  "Furniture Tagged:" block with the object themes.
		"frogg" : {
			"label" : "Furniture - Themed",
			"order" : 2100,
			"subgroups" : {
				"outdoor" : { "label" : "Outdoor", "order" : 10, "tags" : [ "outdoor" ] },
				"astronaut" : { "label" : "Astronaut", "order" : 20, "tags" : [ "astronaut" ] },
				"cabin" : { "label" : "Cabin", "order" : 30, "tags" : [ "cabin" ] },
				"farm" : { "label" : "Farm / Kitchen", "order" : 40, "tags" : [ "farm" ] },
				"gothic" : { "label" : "Gothic", "order" : 50, "tags" : [ "gothic" ] },
				"island" : { "label" : "Island", "order" : 60, "tags" : [ "island" ] },
				"spooky" : { "label" : "Spooky", "order" : 70, "tags" : [ "spooky" ] },
				"retroscifi" : { "label" : "Retro Sci-Fi", "order" : 80, "tags" : [ "retroscifi" ] },
				"pastel" : { "label" : "Pastel", "order" : 90, "tags" : [ "pastel" ] },
				"sea" : { "label" : "Sea", "order" : 100, "tags" : [ "sea" ] },
				"steampunk" : { "label" : "Steampunk", "order" : 110, "tags" : [ "steampunk" ] },
				"egyptian" : { "label" : "Egyptian", "order" : 120, "tags" : [ "egyptian" ] }
			}
		},

		//  NATURAL FORMATIONS DO NOT CARRY THEIR BIOME'S TAG, and that is a gap
		//  wider than the five names listed under geode.
		//  
		//  The crafted geode furniture is tagged "geode"; the smashable rocks that
		//  actually generate in a geode cave are tagged nothing. A player is not
		//  meant to collect them, but they can be, and "everything from geode
		//  caves" should mean everything.
		//  
		//  The same will be true of other biomes. Five names is not a fix for that
		//  -- finding the rest means scanning biome definitions for which objects
		//  they place, which is its own pass.
		"biometheme" : {
			"label" : "Furniture - Biome",
			"order" : 1900,
			"subgroups" : {
				"alien" : { "label" : "Alien", "order" : 10, "tags" : [ "alien" ] },
				"alpine" : { "label" : "Alpine", "order" : 20, "tags" : [ "alpine" ] },
				"bioluminescence" : { "label" : "Bioluminescence", "order" : 30, "tags" : [ "bioluminescence" ] },
				"bone" : { "label" : "Bone", "order" : 40, "tags" : [ "bone" ] },
				"cell" : { "label" : "Cell", "order" : 50, "tags" : [ "cell" ] },
				"colourful" : { "label" : "Colourful", "order" : 60, "tags" : [ "colourful" ] },
				"coral" : { "label" : "Coral", "order" : 70, "tags" : [ "coral" ] },
				"crystalline" : { "label" : "Crystalline", "order" : 80, "tags" : [ "crystalline" ] },
				"dark" : { "label" : "Dark", "order" : 90, "tags" : [ "dark" ] },
				"eyepatch" : { "label" : "Eyepatch", "order" : 100, "tags" : [ "eyepatch" ] },
				"flesh" : { "label" : "Flesh", "order" : 110, "tags" : [ "flesh" ] },
				"foundry" : { "label" : "Foundry", "order" : 120, "tags" : [ "foundry" ] },
				"frozenfire" : { "label" : "Frozenfire", "order" : 130, "tags" : [ "frozenfire" ] },
				"geode" : { "label" : "Geode", "order" : 140, "tags" : [ "geode" ], "items" : [ "geodebnatural", "geodecnatural", "geodednatural", "geodehighanatural", "geodelowanatural" ] },
				"giantflower" : { "label" : "Giant Flower", "order" : 150, "tags" : [ "giantflower" ] },
				"gnome" : { "label" : "Gnome", "order" : 160, "tags" : [ "gnome" ] },
				"heck" : { "label" : "Heck", "order" : 170, "tags" : [ "heck" ] },
				"hive" : { "label" : "Hive", "order" : 180, "tags" : [ "hive" ] },
				"hoard" : { "label" : "Hoard", "order" : 190, "tags" : [ "hoard" ] },
				"ice" : { "label" : "Ice", "order" : 200, "tags" : [ "ice" ] },
				"jungle" : { "label" : "Jungle", "order" : 210, "tags" : [ "jungle" ] },
				"mushroompatch" : { "label" : "Mushroom Patch", "order" : 220, "tags" : [ "mushroompatch" ] },
				"naturalcave" : { "label" : "Natural Cave", "order" : 230, "tags" : [ "naturalcave" ] },
				"oasis" : { "label" : "Oasis", "order" : 240, "tags" : [ "oasis" ] },
				"ocean" : { "label" : "Ocean", "order" : 250, "tags" : [ "ocean" ] },
				"prism" : { "label" : "Prism", "order" : 260, "tags" : [ "prism" ] },
