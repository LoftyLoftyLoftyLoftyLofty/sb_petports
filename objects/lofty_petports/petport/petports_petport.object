      "direction" : "left",
      "flipImages" : true,
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    },
    {
      "imageLayers" : 
	  [
	    //{ "image" : "petport_range_preview.png:<color>", "fullbright" : true, "imagePosition" : [-128, -128] },
		{ "image" : "petports_petport.png:<color>", "fullbright" : true },
		{ "image" : "petports_petportlit.png:<color>" }
	  ],
      "imagePosition" : [-48, -24],
      "direction" : "right",
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    }
  ],

