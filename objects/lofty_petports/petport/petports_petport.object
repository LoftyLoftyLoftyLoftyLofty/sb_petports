//  M.A.U.S. PETPORT
//
//  One-slot container. Socket a petports_ship_pet item to wake the unit inside.
//  See petports_petport.lua.

{
  "objectName" : "petports_petport",
  //  itemTags, NOT colonyTags, FOR SORTING. colonyTags are what a tenant asks
  //  for when it wants furniture in its house; itemTags are what the deposit
  //  filter reads. This object had only the former, so it did not appear in the
  //  Petports group at all -- a crate set to "Petports" collected beacons, pets
  //  and machines and not the ports themselves, which reads as a bug rather than
  //  as a gap.
  //
  //  petports_petport IS THE TAG A RESKINNED PORT NEEDS. A Steampunk or Floran
  //  petport carries it and sorts beside this one with no manifest edit.
  "itemTags" : [ "petports", "petports_petport" ],

  "colonyTags" : ["petports"],
  "rarity" : "Rare",
  "objectType" : "container",
  //  NO `category`, MATCHING THE UPCYCLER. Two separate reasons, both real.
  //
  //  SORTING. "storage" put this in Furniture > Storage alongside every chest
  //  in the game, so it double-sorted: a player filling a crate of storage got
  //  petports, and a player filling a crate of petports got them too. It is a
  //  container, so Storage was not WRONG -- it was just not what anyone wants
  //  in a crate. The petports_petport tag above is what places it now.
  //
  //  THE PANE SUBTITLE. ContainerPane overwrites a pane's title and subtitle
  //  from `shortdescription` and `category`, but ONLY when the object has a
  //  category -- vanilla's FTL fuel hatch declares none and its pane keeps its
  //  own strings. This pane currently read "Storage" underneath the name.
  //
  //  The borrowed pettether.config declares no title widget of its own, so
  //  nothing replaces that yet; the subtitle simply goes away until the
  //  ScriptPane lands. A ScriptPane does not have this problem at all, which is
  //  why this is a tidy-up rather than a fix.
  //
  //  IF A CATEGORY EVER GOES BACK ON, it silently reverts the pane subtitle to
  //  a category label. That coupling is invisible from either file alone.

  "price" : 550,
  "printable" : false,
  "description" : "A Petport for M.A.U.S. utility units. Socket a dormant unit to bring it online.",
  "shortdescription" : "M.A.U.S. Petport",
  "race" : "generic",
  
  "health" : 5,

  //  assistant type here so "hostile" ignores us and the player doesn't view the entity hp bar on mouseover
  "damageTeam" : { "type" : "assistant", "team" : 0 },

  //  One pet, one slot.
  "slotCount" : 1,

  //  THE BESPOKE PANE. Replaced the borrowed /interface/chests/pettether.config
  //  on 2026-08-28. A ContainerPane WITH A SCRIPT, the same third thing the
  //  upcycler is -- real container slots plus arbitrary widgets in one window.
  "uiConfig" : "/interface/lofty_petports/petportconfig/petportconfig.config",

  //  ContainerPane DRAWS ITS OWN HEADER ICON from `inventoryIcon` unless this
  //  is false. With it left unset the pane would show the port's inventory
  //  sprite and the title widget's own `icon` child would be invisible
  //  underneath it -- and since both pointed at the same file on the upcycler,
  //  the two were indistinguishable for a while. The fuel hatch's pattern:
  //  turn ContainerPane's off, supply a different image in the title widget.
  "hasWindowIcon" : false,

  //  Container must not auto-close while the player is fiddling with options.
  "autoCloseCooldown" : 3600,
  "frameCooldown" : 5,

  //  Where the unit wakes up, relative to the station.
  "petSpawnOffset" : [0, 0],

  "inventoryIcon" : "petports_petporticon.png",
  "orientations" : [
    {
      "imageLayers" : 
	  [ 		
		{ "image" : "petport_hull_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_hull_fullbright.png:closed.1", "fullbright" : true },
		{ "image" : "petport_door_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_door_fullbright.png:closed.1", "fullbright" : true },
		{ "image" : "petport_interior_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_interior_fullbright.png:closed.1", "fullbright" : true }
	  ],
      "imagePosition" : [-16, -16],
      "direction" : "left",
      "flipImages" : true,
      "spaceScan" : 0.1,
      "anchors" : [ "background" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    },
    {
      "imageLayers" : 
	  [ 		
		{ "image" : "petport_hull_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_hull_fullbright.png:closed.1", "fullbright" : true },
		{ "image" : "petport_door_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_door_fullbright.png:closed.1", "fullbright" : true },
		{ "image" : "petport_interior_lit.png:closed.1", "fullbright" : false },
		{ "image" : "petport_interior_fullbright.png:closed.1", "fullbright" : true }
	  ],
      "imagePosition" : [-16, -16],
      "direction" : "right",
      "spaceScan" : 0.1,
      "anchors" : [ "background" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    }
  ],

  "scripts" : [ "petports_petport.lua" ],
  "scriptDelta" : 5,

  "animation" : "petports_petport.animation",
  "animationParts" : 
  { 
	"hull_lit" : "petport_hull_lit.png",
	"hull_fullbright" : "petport_hull_fullbright.png",
	"door_lit" : "petport_door_lit.png",
	"door_fullbright" : "petport_door_fullbright.png",
	"interior_lit" : "petport_interior_lit.png",
	"interior_fullbright" : "petport_interior_fullbright.png"
  },
  "animationPosition" : [-16, -16]
}
