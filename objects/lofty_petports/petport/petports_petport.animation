{
	"sounds" : {
		"refuse" : [ "/sfx/interface/clickon_error.ogg" ],
		"swap" : [ "/sfx/interface/inventory_pickup1.ogg" ]
	},

	"animatedParts" : 
	{
		"stateTypes" : 
		{
			"interiorState" : 
			{
				"default" : "closed",
				"states" : 
				{
					"closed" : { "frames" : 1 },
					"opening"  : { "frames" : 10, "mode" : "transition", "transition" : "open" },
					"open" : { "frames" : 1 },
					"closing" : { "frames" : 10, "mode" : "transition", "transition" : "closed" }
				}
			},
			"doorState" : 
			{
				"default" : "closed",
				"states" : 
				{
					"closed" : { "frames" : 1 },
					"opening"  : { "frames" : 10, "mode" : "transition", "transition" : "open" },
					"open" : { "frames" : 1 },
					"closing" : { "frames" : 10, "mode" : "transition", "transition" : "closed" }
				}
			},
			"hullState" : 
			{
				"default" : "closed",
				"states" : 
				{
					"closed" : { "frames" : 1 },
					"opening"  : { "frames" : 10, "mode" : "transition", "transition" : "open" },
					"open" : { "frames" : 1 },
					"closing" : { "frames" : 10, "mode" : "transition", "transition" : "closed" }
				}
			}
		},

		"parts" : 
		{
			"interior_lit" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 1
				},
				"partStates" : 
				{
					"interiorState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			},
			"interior_fullbright" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 0,
					"fullbright" : true
				},
				"partStates" : 
				{
					"interiorState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			},
			"door_lit" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 3
				},
				"partStates" : 
				{
					"doorState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			},
			"door_fullbright" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 2,
					"fullbright" : true
				},
				"partStates" : 
				{
					"doorState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			},
			"hull_lit" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 5
				},
				"partStates" : 
				{
					"hullState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			},
			"hull_fullbright" : 
			{
				"properties" : 
				{
					"centered" : false,
					"zLevel" : 4,
					"fullbright" : true
				},
				"partStates" : 
				{
					"hullState" : 
					{
						"closed" : { "properties" : { "image" : "<partImage>:closed.<frame>" } },
						"opening" : { "properties" : { "image" : "<partImage>:opening.<frame>" } },
						"open" : { "properties" : { "image" : "<partImage>:open.<frame>" } },
						"closing" : { "properties" : { "image" : "<partImage>:closing.<frame>" } }
					}
				}
			}
		}
	}
}
