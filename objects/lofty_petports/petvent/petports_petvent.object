//  M.A.U.S. UTILITY VENT
//
//  Wire two together with the wiring tool to link them. One wire is enough --
//  see petports_petvent.lua for why.

{
  "objectName" : "petports_petvent",
  //  itemTags, NOT colonyTags, FOR SORTING -- this object had only the latter and
  //  so never appeared in the Petports group.
  //
  //  FILED UNDER MACHINES rather than getting a subgroup of its own. A vent is
  //  infrastructure rather than a machine in the strict sense, but it is wired,
  //  placed and wall-mounted like one, and a subgroup holding exactly one object
  //  type is a row in the picker that never earns its place.
  "itemTags" : [ "petports", "petports_machine" ],

  "colonyTags" : ["petports"],
  "rarity" : "Common",
  "category" : "wire",
  "price" : 80,
  "printable" : false,
  "description" : "A crawlway junction sized for utility units. Wire two together and a unit can travel between them.",
  "shortdescription" : "Utility Vent",
  "race" : "generic",

  //  ONE input, ONE output. A single wire from one vent's output to another's
  //  input links the pair in both directions.
  "inputNodes" : [ [-1, 0] ],
  "outputNodes" : [ [0, 1] ],

  //  Where a unit stands to enter, relative to the object.
  "entryOffset" : [0, 1],

  "inventoryIcon" : "petports_petvent_icon.png",
  "orientations" : [
    {
      "image" : "petports_petvent.png:idle.1",
      "imagePosition" : [-8, 0],
      "direction" : "left",
      "flipImages" : true,
      "spaceScan" : 0.1,
      "anchors" : [ "background" ]
    },
    {
      "image" : "petports_petvent.png:idle.1",
      "imagePosition" : [-8, 0],
      "direction" : "right",
      "spaceScan" : 0.1,
      "anchors" : [ "background" ]
    }
  ],

  "scripts" : [ "petports_petvent.lua" ],
  "scriptDelta" : 15,

  "animation" : "petports_petvent.animation",
  "animationParts" : { "vent" : "petports_petvent.png" },
  "animationPosition" : [-8, 0]
}